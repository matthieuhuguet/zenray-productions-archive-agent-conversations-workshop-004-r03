et le pipeline n'est plus\n// réparable (risque R3 de 02-RISQUES). `Math.random()` est donc INTERDIT dans ce dossier :\n// on passe toujours par `rng(seed)` ci-dessous.\n\nexport const REGISTERS = ['presse', 'créateur', 'institutionnel', 'luxe', 'technique', 'divertissement', 'pédagogique', 'promotionnel']\nexport const INTENTS = ['informer', 'convaincre', 'vendre', 'émouvoir', 'enseigner', 'annoncer', 'documenter']\nexport const BEAT_ROLES = ['hook', 'context', 'proof', 'demo', 'turn', 'payoff', 'cta']\nexport const BEAT_TEMPOS = ['still', 'calm', 'drive', 'snap']\n\nexport const ROLE_LABELS = {\n  hook: 'Accroche', context: 'Contexte', proof: 'Preuve', demo: 'Démonstration',\n  turn: 'Bascule', payoff: 'Chute', cta: 'Appel',\n}\n\n// --- Générateur déterministe (L0-10) -------------------------------------------------------\n// mulberry32 : même graine -> même suite, sur toutes les machines. Utilisé pour le grain, les\n// micro-décalages et tout choix \"aléatoire\" d'un thème.\nexport function rng(seed) {\n  let a = (typeof seed === 'number' ? seed : hashString(String(seed ?? 'zenraymedia'))) >>> 0\n  return function next() {\n    a |= 0; a = (a + 0x6D2B79F5) | 0\n    let t = Math.imul(a ^ (a >>> 15), 1 | a)\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296\n  }\n}\n\nexport function hashString(str) {\n  let h = 2166136261 >>> 0\n  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) }\n  return h >>> 0\n}\n\n// Identifiant stable et lisible, dérivé du contenu + d'un compteur fourni par l'appelant.\n// Volontairement SANS Date.now() : un id ne doit pas dépendre de l'heure de fabrication.\nexport function makeId(prefix, seedText, counter = 0) {\n  return `${prefix}-${hashString(`${seedText}#${counter}`).toString(36).padStart(7, '0')}`\n}\n\n// --- Helpers de validation ------------------------------------------------------------------\nconst isStr = (v) => typeof v === 'string'\nconst nonEmpty = (v) => isStr(v) && v.trim().length > 0\nconst isArr = Array.isArray\n\n// Compte les phrases d'un texte. Sert la contrainte du message unique (WBS ZM-L2-02).\n// Les abréviations courantes ne comptent pas comme fin de phrase.\nexport function sentenceCount(text) {\n  if (!nonEmpty(text)) return 0\n  const cleaned = String(text)\n    .replace(/\\b(M|Mme|Dr|etc|cf|ex|p|vs|Mr|St|n°|art)\\./gi, '$1')\n    .replace(/\\d+\\.\\d+/g, '0')\n  const parts = cleaned.split(/[.!?…]+(?:\\s|$)/).map((s) => s.trim()).filter(Boolean)\n  return parts.length\n}\n\n// --- 5.1 Brief --------------------------------------------------------------------------------\nexport function emptyBrief() {\n  return {\n    id: '', title: '', message: '', audience: '', register: 'créateur', intent: 'informer',\n    evidence: [], constraints: { languages: ['fr'], maxDuration: null, mentions: [] }, sources: [],\n  }\n}\n\nexport function validateBrief(brief) {\n  const errors = []\n  if (!brief || typeof brief !== 'object') return [{ field: 'brief', code: 'shape', message: 'Brief absent.' }]\n  if (!nonEmpty(brief.title)) errors.push({ field: 'title', code: 'required', message: 'Le titre de travail est obligatoire.' })\n  if (!nonEmpty(brief.message)) errors.push({ field: 'message', code: 'required', message: 'Le message est obligatoire : une phrase, celle que le public doit retenir.' })\n  // ZM-L2-02 : REFUS explicite, pas un avertissement.\n  else if (sentenceCount(brief.message) > 1) errors.push({ field: 'message', code: 'single-sentence', message: `Le message doit tenir en UNE phrase (${sentenceCount(brief.message)} détectées). Choisis celle qui compte.` })\n  if (!nonEmpty(brief.audience)) errors.push({ field: 'audience', code: 'required', message: 'Le public est obligatoire : à qui parles-tu, en clair ?' })\n  if (!REGISTERS.includes(brief.register)) errors.push({ field: 'register', code: 'enum', message: 'Registre inconnu.' })\n  if (!INTENTS.includes(brief.intent)) errors.push({ field: 'intent', code: 'enum', message: 'Intention inconnue.' })\n  if (brief.evidence && !isArr(brief.evidence)) errors.push({ field: 'evidence', code: 'shape', message: 'Les preuves doivent former une liste.' })\n  return errors\n}\n\n// --- 5.2 Cut ----------------------------------------------------------------------------------\nexport function validateCut(cut) {\n  const errors = []\n  if (!cut || typeof cut !== 'object') return [{ field: 'cut', code: 'shape', message: 'Cut absent.' }]\n  if (!nonEmpty(cut.briefId)) errors.push({ field: 'briefId', code: 'required', message: 'Le cut doit référencer un brief.' })\n  if (!isArr(cut.beats) || cut.beats.length === 0) {\n    errors.push({ field: 'beats', code: 'required', message: 'Un cut contient au moins un beat.' })\n    return errors\n  }\n  cut.beats.forEach((beat, i) => {\n    if (!BEAT_ROLES.includes(beat?.role)) errors.push({ field: `beats[${i}].role`, code: 'enum', message: `Beat ${i + 1} : rôle manquant ou inconnu.` })\n    if (!nonEmpty(beat?.text)) errors.push({ field: `beats[${i}].text`, code: 'required', message: `Beat ${i + 1} : texte vide.` })\n    if (beat?.weight != null && (typeof beat.weight !== 'number' || beat.weight < 0 || beat.weight > 1)) errors.push({ field: `beats[${i}].weight`, code: 'range', message: `Beat ${i + 1} : le poids doit être compris entre 0 et 1.` })\n    if (beat?.tempo && !BEAT_TEMPOS.includes(beat.tempo)) errors.push({ field: `beats[${i}].tempo`, code: 'enum', message: `Beat ${i + 1} : tempo inconnu.` })\n    if (beat?.slots && !isArr(beat.slots)) errors.push({ field: `beats[${i}].slots`, code: 'shape', message: `Beat ${i + 1} : les emplacements doivent former une liste.` })\n    if (isArr(beat?.slots) && beat.slots.length > 4) errors.push({ field: `beats[${i}].slots`, code: 'range', message: `Beat ${i + 1} : 4 emplacements média au maximum.` })\n  })\n  return errors\n}\n\n// --- 5.3 Theme --------------------------------------------------------------------------------\n// Les 7 groupes de décisions (01-PLAN §10.2). `surface`, `palette`, `typography`, `grid` sont\n// obligatoires ; `motion`, `chrome`, `sound` ont des valeurs par défaut (un thème d'article n'a\n// pas besoin de mouvement ni de son pour être valide).\nexport const THEME_GROUPS = ['surface', 'palette', 'typography', 'grid', 'motion', 'chrome', 'sound']\n\nexport function validateTheme(theme) {\n  const errors = []\n  if (!theme || typeof theme !== 'object') return [{ field: 'theme', code: 'shape', message: 'Thème absent.' }]\n  if (!/^T-\\d{2}-\\d-\\d$/.test(theme.id || '')) errors.push({ field: 'id', code: 'format', message: 'Identifiant attendu : T-FF-S-V (ex. T-01-3-2).' })\n  if (!nonEmpty(theme.name)) errors.push({ field: 'name', code: 'required', message: 'Le nom public du thème est obligatoire.' })\n  for (const group of ['surface', 'palette', 'typography', 'grid']) {\n    if (!theme[group] || typeof theme[group] !== 'object') errors.push({ field: group, code: 'required', message: `Groupe « ${group} » manquant.` })\n  }\n  if (theme.typography && !theme.typography.scale) errors.push({ field: 'typography.scale', code: 'required', message: 'Le thème doit poser son échelle typographique.' })\n  if (!isArr(theme.formats) || theme.formats.length === 0) errors.push({ field: 'formats', code: 'required', message: 'Le thème doit déclarer au moins un format natif.' })\n  // ZM-L4-16 : le calibrage est PRIVÉ. Un thème qui l'expose dans un champ public est refusé.\n  const publicText = `${theme.name || ''} ${theme.description || ''}`.toLowerCase()\n  const marks = ['bfm', 'carrefour', 'squeezie', 'playstation', 'weta', 'le monde', 'netflix', 'vogue', 'lidl']\n  const leaked = marks.filter((m) => publicText.includes(m))\n  if (leaked.length) errors.push({ field: 'name', code: 'trademark', message: `Marque déposée dans un champ public : ${leaked.join(', ')}. Le calibrage vit dans calibration.ref, jamais dans le nom.` })\n  return errors\n}\n\n// --- 5.4 Format --------------------------------------------------------------------------------\nexport const FORMAT_KINDS = ['web', 'still', 'print', 'video', 'overlay']\n\nexport function validateFormat(format) {\n  const errors = []\n  if (!format || typeof format !== 'object') return [{ field: 'format', code: 'shape', message: 'Format absent.' }]\n  if (!nonEmpty(format.id)) errors.push({ field: 'id', code: 'required', message: 'Identifiant de format manquant.' })\n  if (!FORMAT_KINDS.includes(format.kind)) errors.push({ field: 'kind', code: 'enum', message: 'Type de format inconnu.' })\n  const c = format.canvas\n  // Une page web n'a PAS de hauteur : le contenu coule. `h:0` y est donc légal et volontaire.\n  // Tout autre type de format (image, print, vidéo) doit poser ses deux dimensions.\n  if (!c || !(c.w > 0)) errors.push({ field: 'canvas', code: 'required', message: 'Largeur de sortie manquante.' })\n  else if (format.kind !== 'web' && !(c.h > 0)) errors.push({ field: 'canvas', code: 'required', message: `Hauteur de sortie manquante (obligatoire pour un format « ${format.kind} »).` })\n  if (['video', 'overlay'].includes(format.kind) && !(format.time?.fps > 0)) errors.push({ field: 'time.fps', code: 'required', message: 'Un format temporel doit poser ses images par seconde.' })\n  return errors\n}\n\n// --- 5.5 Job -----------------------------------------------------------------------------------\nexport function validateJob(job) {\n  const errors = []\n  if (!job || typeof job !== 'object') return [{ field: 'job', code: 'shape', message: 'Job absent.' }]\n  if (!nonEmpty(job.cutId)) errors.push({ field: 'cutId', code: 'required', message: 'Job sans cut.' })\n  if (!nonEmpty(job.themeId)) errors.push({ field: 'themeId', code: 'required', message: 'Job sans thème.' })\n  if (!nonEmpty(job.formatId)) errors.push({ field: 'formatId', code: 'required', message: 'Job sans format.' })\n  // RÈGLE DURE : pas de seed, pas de job. C'est ce qui rend un rendu rejouable.\n  if (job.seed == null || job.seed === '') errors.push({ field: 'seed', code: 'required', message: 'Job sans graine : le rendu ne serait pas reproductible.' })\n  return errors\n}\n\n// --- 5.6 Deliverable ----------------------------------------------------------------------------\nexport function validateDeliverable(deliverable) {\n  const errors = []\n  if (!deliverable || typeof deliverable !== 'object') return [{ field: 'deliverable', code: 'shape', message: 'Livrable absent.' }]\n  if (!nonEmpty(deliverable.jobId)) errors.push({ field: 'jobId', code: 'required', message: 'Livrable orphelin.' })\n  if (!(deliverable.bytes > 0)) errors.push({ field: 'bytes', code: 'required', message: 'Livrable vide.' })\n  // Un livrable sans empreinte ni sonde est « non vérifié » : il ne peut pas être déclaré fini.\n  if (!nonEmpty(deliverable.checksum)) errors.push({ field: 'checksum', code: 'required', message: 'Livrable sans empreinte : non vérifiable.' })\n  if (!deliverable.probe) errors.push({ field: 'probe', code: 'required', message: 'Livrable sans sonde : non vérifié.' })\n  return errors\n}\n\n// --- L0-07 : validateur unique ---------------------------------------------------------------\n// Un SEUL point d'entrée. Aucune validation ne doit être dupliquée ailleurs dans le produit.\nconst VALIDATORS = {\n  brief: validateBrief, cut: validateCut, theme: validateTheme,\n  format: validateFormat, job: validateJob, deliverable: validateDeliverable,\n}\n\nexport function validate(kind, value) {\n  const fn = VALIDATORS[kind]\n  if (!fn) throw new Error(`validate: contrat inconnu « ${kind} »`)\n  return fn(value)\n}\n\nexport function isValid(kind, value) { return validate(kind, value).length === 0 }\n\n// Empreinte de contenu, pour les livrables produits côté navigateur (pas de crypto asynchrone\n// nécessaire, on veut une signature stable et rapide, pas une garantie cryptographique).\nexport function checksumOf(text) {\n  const s = String(text)\n  return `zrm1-${hashString(s).toString(16)}-${s.length.toString(16)}`\n}\n","numLines":188,"startLine":1,"totalLines":188}},"sourceToolAssistantUUID":"4df580f2-b190-4c91-b399-478effc44e29","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"85a4f5d4-2455-4f40-ace7-61693dc5faa4","version":"2.1.219","gitBranch":"main","slug":"typed-plotting-oasis"}
