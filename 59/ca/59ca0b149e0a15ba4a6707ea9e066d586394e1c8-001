{"parentUuid":"4df580f2-b190-4c91-b399-478effc44e29","isSidechain":false,"promptId":"c5fb747f-c2f3-465c-a720-a1befa0b32ea","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Nc9QA34qusaKnqppjfoNDa","type":"tool_result","content":"1\t// ZenRayMedia — L0 : les six contrats de données.\n2\t// Doc de référence : docs/zenraymedia/01-PLAN.md §5, docs/zenraymedia/04-WBS-COMPOSANTS.md L0.\n3\t//\n4\t// RÈGLE DURE (01-PLAN §5.5) : tout Job porte une `seed`. Aucun aléa non graine n'est autorisé\n5\t// dans le produit -- sinon deux rendus du même contenu diffèrent et le pipeline n'est plus\n6\t// réparable (risque R3 de 02-RISQUES). `Math.random()` est donc INTERDIT dans ce dossier :\n7\t// on passe toujours par `rng(seed)` ci-dessous.\n8\t\n9\texport const REGISTERS = ['presse', 'créateur', 'institutionnel', 'luxe', 'technique', 'divertissement', 'pédagogique', 'promotionnel']\n10\texport const INTENTS = ['informer', 'convaincre', 'vendre', 'émouvoir', 'enseigner', 'annoncer', 'documenter']\n11\texport const BEAT_ROLES = ['hook', 'context', 'proof', 'demo', 'turn', 'payoff', 'cta']\n12\texport const BEAT_TEMPOS = ['still', 'calm', 'drive', 'snap']\n13\t\n14\texport const ROLE_LABELS = {\n15\t  hook: 'Accroche', context: 'Contexte', proof: 'Preuve', demo: 'Démonstration',\n16\t  turn: 'Bascule', payoff: 'Chute', cta: 'Appel',\n17\t}\n18\t\n19\t// --- Générateur déterministe (L0-10) -------------------------------------------------------\n20\t// mulberry32 : même graine -> même suite, sur toutes les machines. Utilisé pour le grain, les\n21\t// micro-décalages et tout choix \"aléatoire\" d'un thème.\n22\texport function rng(seed) {\n23\t  let a = (typeof seed === 'number' ? seed : hashString(String(seed ?? 'zenraymedia'))) >>> 0\n24\t  return function next() {\n25\t    a |= 0; a = (a + 0x6D2B79F5) | 0\n26\t    let t = Math.imul(a ^ (a >>> 15), 1 | a)\n27\t    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t\n28\t    return ((t ^ (t >>> 14)) >>> 0) / 4294967296\n29\t  }\n30\t}\n31\t\n32\texport function hashString(str) {\n33\t  let h = 2166136261 >>> 0\n34\t  for (let i = 0; i < str.length; i++) { h ^= str.charCodeAt(i); h = Math.imul(h, 16777619) }\n35\t  return h >>> 0\n36\t}\n37\t\n38\t// Identifiant stable et lisible, dérivé du contenu + d'un compteur fourni par l'appelant.\n39\t// Volontairement SANS Date.now() : un id ne doit pas dépendre de l'heure de fabrication.\n40\texport function makeId(prefix, seedText, counter = 0) {\n41\t  return `${prefix}-${hashString(`${seedText}#${counter}`).toString(36).padStart(7, '0')}`\n42\t}\n43\t\n44\t// --- Helpers de validation ------------------------------------------------------------------\n45\tconst isStr = (v) => typeof v === 'string'\n46\tconst nonEmpty = (v) => isStr(v) && v.trim().length > 0\n47\tconst isArr = Array.isArray\n48\t\n49\t// Compte les phrases d'un texte. Sert la contrainte du message unique (WBS ZM-L2-02).\n50\t// Les abréviations courantes ne comptent pas comme fin de phrase.\n51\texport function sentenceCount(text) {\n52\t  if (!nonEmpty(text)) return 0\n53\t  const cleaned = String(text)\n54\t    .replace(/\\b(M|Mme|Dr|etc|cf|ex|p|vs|Mr|St|n°|art)\\./gi, '$1')\n55\t    .replace(/\\d+\\.\\d+/g, '0')\n56\t  const parts = cleaned.split(/[.!?…]+(?:\\s|$)/).map((s) => s.trim()).filter(Boolean)\n57\t  return parts.length\n58\t}\n59\t\n60\t// --- 5.1 Brief --------------------------------------------------------------------------------\n61\texport function emptyBrief() {\n62\t  return {\n63\t    id: '', title: '', message: '', audience: '', register: 'créateur', intent: 'informer',\n64\t    evidence: [], constraints: { languages: ['fr'], maxDuration: null, mentions: [] }, sources: [],\n65\t  }\n66\t}\n67\t\n68\texport function validateBrief(brief) {\n69\t  const errors = []\n70\t  if (!brief || typeof brief !== 'object') return [{ field: 'brief', code: 'shape', message: 'Brief absent.' }]\n71\t  if (!nonEmpty(brief.title)) errors.push({ field: 'title', code: 'required', message: 'Le titre de travail est obligatoire.' })\n72\t  if (!nonEmpty(brief.message)) errors.push({ field: 'message', code: 'required', message: 'Le message est obligatoire : une phrase, celle que le public doit retenir.' })\n73\t  // ZM-L2-02 : REFUS explicite, pas un avertissement.\n74\t  else if (sentenceCount(brief.message) > 1) errors.push({ field: 'message', code: 'single-sentence', message: `Le message doit tenir en UNE phrase (${sentenceCount(brief.message)} détectées). Choisis celle qui compte.` })\n75\t  if (!nonEmpty(brief.audience)) errors.push({ field: 'audience', code: 'required', message: 'Le public est obligatoire : à qui parles-tu, en clair ?' })\n76\t  if (!REGISTERS.includes(brief.register)) errors.push({ field: 'register', code: 'enum', message: 'Registre inconnu.' })\n77\t  if (!INTENTS.includes(brief.intent)) errors.push({ field: 'intent', code: 'enum', message: 'Intention inconnue.' })\n78\t  if (brief.evidence && !isArr(brief.evidence)) errors.push({ field: 'evidence', code: 'shape', message: 'Les preuves doivent former une liste.' })\n79\t  return errors\n80\t}\n81\t\n82\t// --- 5.2 Cut ----------------------------------------------------------------------------------\n83\texport function validateCut(cut) {\n84\t  const errors = []\n85\t  if (!cut || typeof cut !== 'object') return [{ field: 'cut', code: 'shape', message: 'Cut absent.' }]\n86\t  if (!nonEmpty(cut.briefId)) errors.push({ field: 'briefId', code: 'required', message: 'Le cut doit référencer un brief.' })\n87\t  if (!isArr(cut.beats) || cut.beats.length === 0) {\n88\t    errors.push({ field: 'beats', code: 'required', message: 'Un cut contient au moins un beat.' })\n89\t    return errors\n90\t  }\n91\t  cut.beats.forEach((beat, i) => {\n92\t    if (!BEAT_ROLES.includes(beat?.role)) errors.push({ field: `beats[${i}].role`, code: 'enum', message: `Beat ${i + 1} : rôle manquant ou inconnu.` })\n93\t    if (!nonEmpty(beat?.text)) errors.push({ field: `beats[${i}].text`, code: 'required', message: `Beat ${i + 1} : texte vide.` })\n94\t    if (beat?.weight != null && (typeof beat.weight !== 'number' || beat.weight < 0 || beat.weight > 1)) errors.push({ field: `beats[${i}].weight`, code: 'range', message: `Beat ${i + 1} : le poids doit être compris entre 0 et 1.` })\n95\t    if (beat?.tempo && !BEAT_TEMPOS.includes(beat.tempo)) errors.push({ field: `beats[${i}].tempo`, code: 'enum', message: `Beat ${i + 1} : tempo inconnu.` })\n96\t    if (beat?.slots && !isArr(beat.slots)) errors.push({ field: `beats[${i}].slots`, code: 'shape', message: `Beat ${i + 1} : les emplacements doivent former une liste.` })\n97\t    if (isArr(beat?.slots) && beat.slots.length > 4) errors.push({ field: `beats[${i}].slots`, code: 'range', message: `Beat ${i + 1} : 4 emplacements média au maximum.` })\n98\t  })\n99\t  return errors\n100\t}\n101\t\n102\t// --- 5.3 Theme --------------------------------------------------------------------------------\n103\t// Les 7 groupes de décisions (01-PLAN §10.2). `surface`, `palette`, `typography`, `grid` sont\n104\t// obligatoires ; `motion`, `chrome`, `sound` ont des valeurs par défaut (un thème d'article n'a\n105\t// pas besoin de mouvement ni de son pour être valide).\n106\texport const THEME_GROUPS = ['surface', 'palette', 'typography', 'grid', 'motion', 'chrome', 'sound']\n107\t\n108\texport function validateTheme(theme) {\n109\t  const errors = []\n110\t  if (!theme || typeof theme !== 'object') return [{ field: 'theme', code: 'shape', message: 'Thème absent.' }]\n111\t  if (!/^T-\\d{2}-\\d-\\d$/.test(theme.id || '')) errors.push({ field: 'id', code: 'format', message: 'Identifiant attendu : T-FF-S-V (ex. T-01-3-2).' })\n112\t  if (!nonEmpty(theme.name)) errors.push({ field: 'name', code: 'required', message: 'Le nom public du thème est obligatoire.' })\n113\t  for (const group of ['surface', 'palette', 'typography', 'grid']) {\n114\t    if (!theme[group] || typeof theme[group] !== 'object') errors.push({ field: 