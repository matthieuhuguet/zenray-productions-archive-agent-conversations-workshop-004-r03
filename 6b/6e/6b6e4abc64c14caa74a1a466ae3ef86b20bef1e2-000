ult.references[0].targets.map((target) => target.projectId)).toEqual(['test-project', 'shared'])\\n+  })\\n+\\n+  it('rejects stale audits and unknown scene identities', () => {\\n+    expect(() => run([], undefined, { sceneSha256: 'new-hash' })).toThrow('Stale scene audit')\\n+    expect(() => run([], undefined, { projectId: 'missing' })).toThrow('Unknown scene project')\\n+    expect(() => run([], undefined, { sceneFileId: 'production:missing.hiplc' })).toThrow('Unknown scene file')\\n+  })\\n+\\n+  it('separates URI, relative, internal, output, sequence and unknown absent references', () => {\\n+    const result = run([\\n+      reference('/Users/zenray/invalid-uri', { pathKind: 'uri' }),\\n+      reference('/Users/zenray/invalid-relative', { pathKind: 'relative' }),\\n+      reference(null, { internal: true }),\\n+      reference('/Users/zenray/render.exr', { mode: 'output' }),\\n+      reference('/Users/zenray/sequence.0001.exr', { dynamic: true }),\\n+      reference('/Users/zenray/unknown.usd', { mode: 'unknown', existsAtCurrentFrame: false }),\\n+    ])\\n+    expect(result.references.map((entry) => entry.type)).toEqual(['uri', 'relative', 'internal', 'output', 'dynamic', 'unresolved'])\\n+    expect(result.references[4].sequenceVerified).toBe(false)\\n+    expect(result.references[5].role).toBe('unknown')\\n+  })\\n+\\n+  it('reports missing and cyclic dependencies while completing known mappings', () => {\\n+    const result = run([], [snapshot('test-project', [scene], ['shared', 'missing']), snapshot('shared', [], ['test-project'])])\\n+    expect(result.issues).toEqual([{ code: 'dependency-missing', projectId: 'test-project', dependency: 'missing' }, { code: 'dependency-cycle', projectId: 'test-project' }])\\n+  })\\n+\\n+  it('exports no paths or raw diagnostic text from the Mac', () => {\\n+    const texture = file('maps/color.png', '/Users/zenray/color.png')\\n+    const result = run([reference(texture.canonicalPath, { rawPath: '/Users/zenray/raw', re