dir, e.name)\n44\t    if (e.isDirectory()) walk(p, pred, acc)\n45\t    else if (e.isFile() && pred(e.name, p)) acc.push(p)\n46\t  }\n47\t  return acc\n48\t}\n49\t\n50\t// ── 1. Couverture : chaque transcript du disque a-t-il un manifeste ? ─────────\n51\tconst sources = walk(SRC_DIR, n => n.endsWith('.jsonl'))\n52\tconst manifests = walk(CHUNK_DIR, n => n === 'manifest.json')\n53\t    .map(p => ({ path: p, dir: resolve(p, '..'), data: JSON.parse(readFileSync(p, 'utf8')) }))\n54\t\n55\tconst bySource = new Map(manifests.map(m => [m.data.source, m]))\n56\tconst missing = sources.filter(s => !bySource.has(join('projects', relative(SRC_DIR, s))))\n57\tcheck('couverture — chaque conversation du disque est découpée', missing.length === 0,\n58\t  missing.length ? `${missing.length} sans manifeste, dont ${relative(ROOT, missing[0])}` : `${sources.length} conversations`)\n59\t\n60\t// ── 2. Fraîcheur : le manifeste décrit-il la taille actuelle du fichier ? ─────\n61\tlet stale = 0, staleBytes = 0\n62\tfor (const s of sources) {\n63\t  const key = join('projects', relative(SRC_DIR, s))\n64\t  const m = bySource.get(key)\n65\t  if (!m) continue\n66\t  const size = statSync(s).size\n67\t  if (m.data.size !== size) { stale++; staleBytes += Math.abs(size - m.data.size) }\n68\t}\n69\t// Une conversation EN COURS est forcément en retard de quelques kilo-octets :\n70\t// on tolère ce qui n'excède pas une tranche.\n71\tcheck('fraîcheur — les manifestes suivent les fichiers', staleBytes < 8 * 1024 * 1024,\n72\t  stale ? `${stale} en retard, ${(staleBytes / 1048576).toFixed(1)} Mo au total (normal si une conversation est ouverte)` : 'tous à jour')\n73\t\n74\t// ── 3. Intégrité : les tranches correspondent-elles à leur empreinte ? ────────\n75\tlet chunkCount = 0, chunkBytes = 0, badChunks = []\n76\tfor (const m of manifests) {\n77\t  for (const c of m.data.chunks) {\n78\t    const p = join(m.dir, c.name)\n79\t    chunkCount++\n80\t    if (!existsSync(p)) { badChunks.push(`${c.name} abs