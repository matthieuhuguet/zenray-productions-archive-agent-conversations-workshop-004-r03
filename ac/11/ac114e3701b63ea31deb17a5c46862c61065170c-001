s://linkedin.com/in/zenray/' },\n                  { label: 'matthieuhuguet.com',        href: 'https://matthieuhuguet.com' },\n                  { label: 'artstation.com/zenray',    href: 'https://artstation.com/zenray' },\n                ].map(({ label, href }) => (\n                  <a key={label} href={href}\n                    target={href.startsWith('http') ? '_blank' : undefined}\n                    rel=\"noopener noreferrer\"\n                    style={{ fontFamily: SERIF, fontSize: 14, color: S[500], textDecoration: 'none' }}\n                    onMouseEnter={e => { e.currentTarget.style.color = ACCENT; }}\n                    onMouseLeave={e => { e.currentTarget.style.color = S[500]; }}\n                  >\n                    {label}\n                  </a>\n                ))}\n                <span style={{ fontFamily: SERIF, fontSize: 14, color: S[500] }}>\n                  Aix-en-Provence, France · Remote\n                </span>\n                <span style={{ fontFamily: SERIF, fontSize: 14, color: S[400] }}>{available}</span>\n              </div>\n            </div>\n\n            {/* Lang toggle */}\n            <div style={{ flexShrink: 0, display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: 12 }}>\n              <button\n                onClick={() => setLang(l => l === 'en' ? 'fr' : 'en')}\n                style={btnStyle}\n                onMouseEnter={e => { e.currentTarget.style.color = ACCENT2; e.currentTarget.style.borderColor = '#93c5fd'; }}\n                onMouseLeave={e => { e.currentTarget.style.color = S[400];  e.currentTarget.style.borderColor = S[200]; }}\n              >\n                {en ? 'FR' : 'EN'}\n              </button>\n            </div>\n          </div>\n\n          {/* Summary */}\n          <p style={{ marginTop: 20, fontFamily: SERIF, fontSize: 14, color: S[600], lineHeight: 1.625, maxWidth: 672 }}>\n            {summary}\n          </p>\n\n          {/* Key metrics */}\n          <div style={{ display: 'flex', gap: 24, marginTop: 20 }}>\n            <div>\n              <div style={{ fontFamily: MONO, fontWeight: 600, color: ACCENT, fontSize: 16 }}>\n                {projects.length}\n              </div>\n              <div style={{ fontFamily: SERIF, fontSize: 11, color: S[400] }}>\n                {en ? 'projects' : 'projets'}\n                <span style={{ color: S[300], margin: '0 4px' }}>·</span>\n                17 {en ? 'artworks' : 'artworks'}\n              </div>\n            </div>\n            <div>\n              <div style={{ fontFamily: MONO, fontWeight: 600, color: ACCENT, fontSize: 16 }}>2.5K</div>\n              <div style={{ fontFamily: SERIF, fontSize: 11, color: S[400] }}>LinkedIn</div>\n            </div>\n          </div>\n        </div>\n\n        {/* ── Technical Skills ── */}\n        <Section title={en ? 'Technical Skills' : 'Competences techniques'}>\n          <div style={{ display: 'grid', gridTemplateColumns: isMobile ? '1fr' : '1fr 1fr', gap: '0 40px' }}>\n            <div>\n              <p style={{ fontFamily: MONO, fontSize: 10, color: S[400], textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 12, marginTop: 0 }}>\n                {en ? 'Engines / Tools' : 'Moteurs / Outils'}\n              </p>\n              {groupedSkills.engine.map(s => <SkillBlock key={s.name} s={s} />)}\n              <p style={{ fontFamily: MONO, fontSize: 10, color: S[400], textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 12, marginTop: 20 }}>\n                3D / Procedural\n              </p>\n              {groupedSkills.core.map(s => <SkillBlock key={s.name} s={s} />)}\n            </div>\n            <div style={{ marginTop: isMobile ? 16 : 0 }}>\n              <p style={{ fontFamily: MONO, fontSize: 10, color: S[400], textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 12, marginTop: 0 }}>\n                Pipeline / Code\n              </p>\n              {groupedSkills.tools.map(s => <SkillBlock key={s.name} s={s} />)}\n            </div>\n          </div>\n        </Section>\n\n        {/* ── Languages ── */}\n        <Section title={en ? 'Languages' : 'Langues'}>\n          <div style={{ display: 'flex', gap: 32, flexWrap: 'wrap' }}>\n            {langRows.map(l => (\n              <div key={l.lang} style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n                <span style={{ fontFamily: SERIF, color: S[800], fontSize: 14 }}>{l.lang}</span>\n                <Dots value={l.dots} />\n                <span style={{ fontFamily: SERIF, fontSize: 12, color: S[400] }}>{l.level}</span>\n              </div>\n            ))}\n          </div>\n        </Section>\n\n        {/* ── Projects ── */}\n        <section style={{ marginBottom: 40 }}>\n          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingBottom: 8, marginBottom: 16, borderBottom: `1px solid ${S[100]}` }}>\n            <h2 style={{ fontFamily: SERIF, fontWeight: 600, color: S[900], fontSize: 16, margin: 0 }}>\n              {en ? 'Projects' : 'Projets'} - matthieuhuguet.com\n            </h2>\n            <a href=\"https://artstation.com/zenray\" target=\"_blank\" rel=\"noopener noreferrer\"\n              style={{ fontFamily: MONO, fontSize: 10, color: S[400], textDecoration: 'none' }}\n              onMouseEnter={e => { e.currentTarget.style.color = ACCENT2; }}\n              onMouseLeave={e => { e.currentTarget.style.color = S[400]; }}\n            >\n              ArtStation &#x2197;\n            </a>\n          </div>\n          <div style={{ display: 'grid', gridTemplateColumns: isMobile ? '1fr' : '1fr 1fr', gap: 12 }}>\n            {projects.map(p => (\n              <div key={p.id}\n                style={{ border: `1px solid ${S[100]}`, borderRadius: 8, padding: 12, transition: 'border-color 0.2s, background 0.2s', background: 'transparent' }}\n                onMouseEnter={e => { e.currentTarget.style.borderColor = '#bfdbfe'; e.currentTarget.style.background = 'rgba(239,246,255,0.3)'; }}\n                onMouseLeave={e => { e.currentTarget.style.borderColor = S[100]; e.currentTarget.style.background = 'transparent'; }}\n              >\n                <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 8, marginBottom: 4 }}>\n                  <span style={{ fontFamily: SERIF, fontWeight: 600, color: S[800], fontSize: 12, lineHeight: 1.25 }}>\n                    {p.title}\n                  </span>\n                  {p.url && (\n                    <a href={p.url} target=\"_blank\" rel=\"noopener noreferrer\"\n                      style={{ color: ACCENT3, textDecoration: 'none', flexShrink: 0, fontFamily: MONO, fontSize: 10 }}\n                      onMouseEnter={e => { e.currentTarget.style.color = ACCENT; }}\n                      onMouseLeave={e => { e.currentTarget.style.color = ACCENT3; }}\n                    >\n                      &#x2197;\n                    </a>\n                  )}\n                </div>\n                <p style={{ fontFamily: MONO, fontSize: 10, color: ACCENT2, margin: '0 0 6px 0' }}>{p.brand}</p>\n                <p style={{ fontFamily: SERIF, fontSize: 11, color: S[500], lineHeight: 1.375, margin: 0 }}>\n                  {en ? (p.descriptionEn ?? p.description) : p.description}\n                </p>\n                {p.tags && (\n                  <div style={{ display: 'flex', flexWrap: 'wrap', marginTop: 6 }}>\n                    {p.tags.map(tag => <Tag key={tag} label={tag} />)}\n                  </div>\n                )}\n              </div>\n            ))}\n          </div>\n        </section>\n\n        {/* ── Experience ── */}\n        <Section title={en ? 'Experience' : 'Experiences'}>\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 24 }}>\n            {nonDiversExp.map((e, i) => {\n              const bullets = en ? (e.highlightsEn ?? e.highlights) : e.highlights;\n              return (\n                <div key={i} style={{ display: 'flex', gap: 16 }}>\n                  <div style={{ width: periodW, flexShrink: 0, paddingTop: 2 }}>\n                    <span style={{ fontFamily: MONO, fontSize: 11, color: S[400], lineHeight: 1.25, display: 'block' }}>\n                      {e.period}\n                    </span>\n                    {e.type && (\n                      <span style={{\n                        fontFamily: MONO, fontSize: 9, marginTop: 2, display: 'block',\n                        color: e.type === 'Freelance' ? ACCENT3 : e.type === 'Diplome' ? '#10b981' : S[300],\n                      }}>\n                        {e.type}\n                      </span>\n                    )}\n                  </div>\n                  <div style={{ flex: 1 }}>\n                    <div style={{ display: 'flex', alignItems: 'baseline', gap: 8, marginBottom: 2, flexWrap: 'wrap' }}>\n                      <span style={{ fontFamily: SERIF, fontWeight: 600, color: S[900], fontSize: 14 }}>{e.title}</span>\n                      <span style={{ fontFamily: SERIF, fontSize: 12, color: ACCENT2 }}>{e.company}</span>\n                      {e.location && (\n                        <span style={{ fontFamily: SERIF, fontSize: 12, color: S[400] }}>{e.location}</span>\n                      )}\n                    </div>\n                    <ul style={{ listStyle: 'none', padding: 0, margin: '4px 0 0 0' }}>\n                      {bullets.map((h, j) => (\n                        <li key={j} style={{ display: 'flex', gap: 6, marginBottom: 2 }}>\n                          <span style={{ fontFamily: SERIF, fontSize: 12, color: S[300], flexShrink: 0, marginTop: 2 }}>·</span>\n                          <span style={{ fontFamily: SERIF, fontSize: 12, color: S[500], lineHeight: 1.5 }}>{h}</span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </Section>\n\n        {/* ── Education ── */}\n        <Section title={en ? 'Education' : 'Formation'}>\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>\n            {nonDiversEdu.map((e, i) => {\n              const degree = en ? (e.degreeEn ?? e.degree) : e.degree;\n              const detail = en ? (e.detailEn ?? e.detail) : e.detail;\n              return (\n                <div key={i} style={{ display: 'flex', gap: 16 }}>\n                  <div style={{ width: periodW, flexShrink: 0 }}>\n                    <span style={{ fontFamily: MONO, fontSize: 11, color: S[400] }}>{e.period}</span>\n                  </div>\n                  <div style={{ flex: 1 }}>\n                    <div style={{ display: 'flex', alignItems: 'baseline', gap: 8, marginBottom: 2, flexWrap: 'wrap' }}>\n                      <span style={{ fontFamily: SERIF, fontWeight: 600, color: S[900], fontSize: 14 }}>{degree}</span>\n                      <span style={{ fontFamily: SERIF, fontSize: 12, color: ACCENT2 }}>{e.school}</span>\n                    </div>\n                    {detail && (\n                      <p style={{ fontFamily: SERIF, fontSize: 11, color: S[500], lineHeight: 1.375, margin: '2px 0 0 0' }}>\n                        {detail}\n                      </p>\n                    )}\n                    {e.skills && (\n                      <div style={{ display: 'flex', flexWrap: 'wrap', marginTop: 4 }}>\n                        {e.skills.map(s => <Tag key={s} label={s} />)}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </Section>\n\n        {/* ── Divers ── */}\n        <Section title=\"Divers\">\n          <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>\n            {diversItems.map((item, i) => (\n              <div key={i} style={{ display: 'flex', 