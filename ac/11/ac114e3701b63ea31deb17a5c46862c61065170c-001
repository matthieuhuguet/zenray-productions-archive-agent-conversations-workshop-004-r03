   title: 'MagickSlides',\n336\t    brand: 'Python · ImageMagick',\n337\t    description: 'Generation de slides premium via ImageMagick + execution de code. Construit avec Cursor IDE + Gemini Agent.',\n338\t    descriptionEn: 'Premium slide generation via ImageMagick + code execution. Built with Cursor IDE + Gemini Agent.',\n339\t    url: 'https://matthieuhuguet.com/reels/magick-slides',\n340\t    tags: ['Python', 'Tool', 'Automation'],\n341\t  },\n342\t  {\n343\t    id: 35,\n344\t    title: 'Noyes & LISAA Games 2021-2023',\n345\t    brand: 'Unity · LISAA Paris',\n346\t    description: \"Trailer compilation 7 jeux. Lead GD & Programmer sur Noyes (graduation project, jeu narratif atmospherique), Sea Of Love, Beat'em Up, Juryoku To, Turtle Quest, Crazy Kamikaze, Koldstare.\",\n347\t    descriptionEn: \"Trailer compilation of 7 games. Lead GD & Programmer on Noyes (graduation project, atmospheric narrative game), Sea Of Love, Beat'em Up, Juryoku To, Turtle Quest, Crazy Kamikaze, Koldstare.\",\n348\t    url: 'https://youtu.be/iWGyNtTCxaI',\n349\t    tags: ['Unity', 'Game Design', 'Narrative', 'Lead'],\n350\t  },\n351\t];\n352\t\n353\t/* ─── Sub-components ─────────────────────────────────────────────────────── */\n354\t\n355\tfunction Dots({ value }) {\n356\t  return (\n357\t    <span style={{ display: 'flex', gap: 3, alignItems: 'center', marginLeft: 8 }}>\n358\t      {Array.from({ length: 5 }).map((_, i) => (\n359\t        <span key={i} style={{\n360\t          width: 8, height: 8, borderRadius: '50%', flexShrink: 0, display: 'inline-block',\n361\t          background: i < value ? '#3b82f6' : S[100],\n362\t        }} />\n363\t      ))}\n364\t    </span>\n365\t  );\n366\t}\n367\t\n368\tfunction Tag({ label }) {\n369\t  return (\n370\t    <span style={{\n371\t      display: 'inline-block',\n372\t      fontFamily: MONO, fontSize: 10,\n373\t      color: S[500], background: S[100],\n374\t      borderRadius: 4, padding: '2px 6px',\n375\t      marginRight: 4, marginBottom: 4,\n376\t    }}>\n377\t      {label}\n378\t    </span>\n379\t  );\n380\t}\n381\t\n382\tfunction SkillBlock({ s }) {\n383\t  return (\n384\t    <div style={{ marginBottom: 10 }}>\n385\t      <div style={{ display: 'flex', alignItems: 'baseline', justifyContent: 'space-between', marginBottom: 2 }}>\n386\t        <span style={{ fontFamily: SERIF, fontSize: 14, color: S[800] }}>{s.name}</span>\n387\t        <Dots value={s.level} />\n388\t      </div>\n389\t      {s.tags && (\n390\t        <div style={{ display: 'flex', flexWrap: 'wrap' }}>\n391\t          {s.tags.map(tag => <Tag key={tag} label={tag} />)}\n392\t        </div>\n393\t      )}\n394\t    </div>\n395\t  );\n396\t}\n397\t\n398\tfunction Section({ title, children, action }) {\n399\t  return (\n400\t    <section style={{ marginBottom: 40 }}>\n401\t      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingBottom: 8, marginBottom: 16, borderBottom: `1px solid ${S[100]}` }}>\n402\t        <h2 style={{ fontFamily: SERIF, fontWeight: 600, color: S[900], fontSize: 16, margin: 0 }}>{title}</h2>\n403\t        {action}\n404\t      </div>\n405\t      {children}\n406\t    </section>\n407\t  );\n408\t}\n409\t\n410\t/* ─── Main ───────────────────────────────────────────────────────────────── */\n411\t\n412\texport default function CVPage({ lang: initialLang, isMobile }) {\n413\t  const [lang, setLang] = useState(initialLang === 'fr' ? 'fr' : 'en');\n414\t  const en = lang === 'en';\n415\t\n416\t  const groupedSkills = {\n417\t    core:   skills.filter(s => s.category === 'core'),\n418\t    engine: skills.filter(s => s.category === 'engine'),\n419\t    tools:  skills.filter(s => s.category === 'tools'),\n420\t  };\n421\t\n422\t  const langRows = [\n423\t    { lang: 'French',   level: en ? 'Native'            : 'Natif',             dots: 5 },\n424\t    { lang: 'English',  level: en ? 'Fluent (C1+)'      : 'Courant (C1+)',      dots: 4 },\n425\t    { lang: 'Japanese', level: en ? 'Intermediate (N4)' : 'Intermediaire (N4)', dots: 2 },\n426\t  ];\n427\t\n428\t  const summary = en\n429\t    ? 'Technical Artist specializing in Houdini + Unreal Engine 5. From procedural modeling to pipeline architecture - I design the systems studios need to scale production, automate workflows, and ship environments at a high visual standard. Tool development in Python, C++ and MCP. Bachelor Game Design LISAA Paris (2023) · Gnomon Online · CS50 Harvard (2024).'\n430\t    : \"Technical Artist specialise Houdini + Unreal Engine 5. De la modelisation procedurale a l'architecture pipeline - je concois les systemes dont les studios ont besoin pour scaler leur production et livrer a un haut niveau visuel. Developpement d'outils Python, C++ et MCP. Bachelor Game Design LISAA Paris (2023) · Gnomon Online · CS50 Harvard (2024).\";\n431\t\n432\t  const available = en\n433\t    ? 'Open to contract & freelance remote · min. 3 months'\n434\t    : 'Disponible contrat & freelance remote · min. 3 mois';\n435\t\n436\t  const nonDiversExp = experiences.filter(e => !e.divers);\n437\t  const nonDiversEdu = education.filter(e => !e.divers);\n438\t\n439\t  const diversItems = [\n440\t    ...experiences.filter(e => e.divers).map(e => ({\n441\t      period: e.period,\n442\t      sortYear: parseInt(e.period.match(/\\d{4}/)?.[0] ?? '0'),\n443\t      title: e.title,\n444\t      sub: e.company,\n445\t      detail: en ? (e.highlightsEn?.[0] ?? e.highlights[0]) : e.highlights[0],\n446\t    })),\n447\t    ...education.filter(e => e.divers).map(e => ({\n448\t      period: e.period,\n449\t      sortYear: parseInt(e.period.match(/\\d{4}/)?.[0] ?? '0'),\n450\t      title: en ? (e.degreeEn ?? e.degree) : e.degree,\n451\t      sub: e.school,\n452\t      detail: en ? (e.detailEn ?? e.detail) : e.detail,\n453\t    })),\n454\t  ].sort((a, b) => b.sortYear - a.sortYear);\n455\t\n456\t  const periodW = isMobile ? 80 : 112;\n457\t\n458\t  const btnStyle = {\n459\t    fontFamily: MONO, fontSize: 10, color: S[400],\n460\t    background: 'none', border: `1px solid ${S[200]}`,\n461\t    borderRadius: 4, padding: '4px 8px', cursor: 'pointer',\n462\t    transition: 'color 0.15s, border-color 0.15s',\n463\t  };\n464\t\n465\t  return (\n466\t    <div style={{ flex: 1, overflowY: 'auto', background: '#fff' }}>\n467\t      <div style={{\n468\t        maxWidth: 768,\n469\t        margin: '0 auto',\n470\t        padding: isMobile ? '24px 16px 80px' : '40px 40px 80px',\n471\t        position: 'relative',\n472\t      }}>\n473\t\n474\t        {/* ── Header ── */}\n475\t        <div style={{ marginBottom: 40, paddingBottom: 32, borderBottom: `1px solid ${S[100]}` }}>\n476\t          <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 24 }}>\n477\t            <div style={{ flex: 1, minWidth: 0 }}>\n478\t              <h1 style={{\n479\t                fontFamily: SERIF, fontWeight: 600, fontSize: 30,\n480\t                color: S[900], letterSpacing: '-0.025em',\n481\t                margin: '0 0 4px 0',\n482\t              }}>\n483\t                Matthieu Huguet\n484\t              </h1>\n485\t              <p style={{ fontFamily: SERIF, fontSize: 18, color: ACCENT, margin: '0 0 16px 0' }}>\n486\t                Technical Artist - Freelance\n487\t              </p>\n488\t              <div style={{ display: 'flex', flexWrap: 'wrap', columnGap: 24, rowGap: 4 }}>\n489\t                {[\n490\t                  { label: 'matth.huguet@gmail.com', href: 'mailto:matth.huguet@gmail.com' },\n491\t                  { label: 'linkedin.com/in/zenray',  href: 'https://linkedin.com/in/zenray/' },\n492\t                  { label: 'matthieuhuguet.com',        href: 'https://matthieuhuguet.com' },\n493\t                  { label: 'artstation.com/zenray',    href: 'https://artstation.com/zenray' },\n494\t                ].map(({ label, href }) => (\n495\t                  <a key={label} href={href}\n496\t                    target={href.startsWith('http') ? '_blank' : undefined}\n497\t                    rel=\"noopener noreferrer\"\n498\t                    style={{ fontFamily: SERIF, fontSize: 14, color: S[500], textDecoration: 'none' }}\n499\t                    onMouseEnter={e => { e.currentTarget.style.color = ACCENT; }}\n500\t                    onMouseLeave={e => { e.currentTarget.style.color = S[500]; }}\n501\t                  >\n502\t                    {label}\n503\t                  </a>\n504\t                ))}\n505\t                <span style={{ fontFamily: SERIF, fontSize: 14, color: S[500] }}>\n506\t                  Aix-en-Provence, France · Remote\n507\t                </span>\n508\t                <span style={{ fontFamily: SERIF, fontSize: 14, color: S[400] }}>{available}</span>\n509\t              </div>\n510\t            </div>\n511\t\n512\t            {/* Lang toggle */}\n513\t            <div style={{ flexShrink: 0, display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: 12 }}>\n514\t              <button\n515\t                onClick={() => setLang(l => l === 'en' ? 'fr' : 'en')}\n516\t                style={btnStyle}\n517\t                onMouseEnter={e => { e.currentTarget.style.color = ACCENT2; e.currentTarget.style.borderColor = '#93c5fd'; }}\n518\t                onMouseLeave={e => { e.currentTarget.style.color = S[400];  e.currentTarget.style.borderColor = S[200]; }}\n519\t              >\n520\t                {en ? 'FR' : 'EN'}\n521\t              </button>\n522\t            </div>\n523\t          </div>\n524\t\n525\t          {/* Summary */}\n526\t          <p style={{ marginTop: 20, fontFamily: SERIF, fontSize: 14, color: S[600], lineHeight: 1.625, maxWidth: 672 }}>\n527\t            {summary}\n528\t          </p>\n529\t\n530\t          {/* Key metrics */}\n531\t          <div style={{ display: 'flex', gap: 24, marginTop: 20 }}>\n532\t            <div>\n533\t              <div style={{ fontFamily: MONO, fontWeight: 600, color: ACCENT, fontSize: 16 }}>\n534\t                {projects.length}\n535\t              </div>\n536\t              <div style={{ fontFamily: SERIF, fontSize: 11, color: S[400] }}>\n537\t                {en ? 'projects' : 'projets'}\n538\t                <span style={{ color: S[300], margin: '0 4px' }}>·</span>\n539\t                17 {en ? 'artworks' : 'artworks'}\n540\t              </div>\n541\t            </div>\n542\t            <div>\n543\t              <div style={{ fontFamily: MONO, fontWeight: 600, color: ACCENT, fontSize: 16 }}>2.5K</div>\n544\t              <div style={{ fontFamily: SERIF, fontSize: 11, color: S[400] }}>LinkedIn</div>\n545\t            </div>\n546\t          </div>\n547\t        </div>\n548\t\n549\t        {/* ── Technical Skills ── */}\n550\t        <Section title={en ? 'Technical Skills' : 'Competences techniques'}>\n551\t          <div style={{ display: 'grid', gridTemplateColumns: isMobile ? '1fr' : '1fr 1fr', gap: '0 40px' }}>\n552\t            <div>\n553\t              <p style={{ fontFamily: MONO, fontSize: 10, color: S[400], textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 12, marginTop: 0 }}>\n554\t                {en ? 'Engines / Tools' : 'Moteurs / Outils'}\n555\t              </p>\n556\t              {groupedSkills.engine.map(s => <SkillBlock key={s.name} s={s} />)}\n557\t              <p style={{ fontFamily: MONO, fontSize: 10, color: S[400], textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 12, marginTop: 20 }}>\n558\t                3D / Procedural\n559\t              </p>\n560\t              {groupedSkills.core.map(s => <SkillBlock key={s.name} s={s} />)}\n561\t            </div>\n562\t            <div style={{ marginTop: isMobile ? 16 : 0 }}>\n563\t              <p style={{ fontFamily: MONO, fontSize: 10, color: S[400], textTransform: 'uppercase', letterSpacing: '0.1em', marginBottom: 12, marginTop: 0 }}>\n564\t                Pipeline / Code\n565\t              </p>\n566\t              {groupedSkills.tools.map(s => <SkillBlock key={s.name} s={s} />)}\n567\t            </div>\n568\t          </div>\n569\t        </Section>\n570\t\n571\t        {/* ── Languages ── */}\n572\t        <Section title={en ? 'Languages' : 'Langues'}>\n573\t          <div style={{ display: 'flex', gap: 32, flexWrap: 'wrap' }}>\n574\t            {langRows.map(l => (\n575\t              <div key={l.lang} style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n576\t                <span style={{ fontFamily: SERIF, color: S[800], fontSize: 14 }}>{l.lang}</span>\n577\t                <Dots value={l.dots} />\n578\t                <span style={{ fontFamily: SERIF, fontSize: 12, color: S[400] }}>{l.level}</span>\n579\t              </div>\n580\t            ))}\n581\t          </div>\n582\t        </Section>\n583\t\n584\t        {/* ── Projects ── */}\n585\t        <section style={{ marginBottom: 40 }}>\n586\t          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingBottom: 8, marginBottom: 16, borderBottom: `1px solid ${S[100]}` }}>\n587\t            <h2 style={{ fontFamily: SERIF, fontWeight: 600, color: S[900], fontSize: 16, margin: 0 }}>\n588\t              {en ? 'Projects' : 'Projets'} - matthieuhuguet.com\n589\t            </h2>\n590\t            <a href=\"https://artstation.com/zenray\" target=\"_blank\" rel=\"noopener noreferrer\"\n591\t              style={{ fontFamily: MONO, fontSize: 10, color: S[400], textDecoration: 'none' }}\n592\t              onMouseEnter={e => { e.currentTarget.style.color = ACCENT2; }}\n593\t              onMouseLeave={e => { e.currentTarget.style.color = S[400]; }}\n594\t            >\n595\t              ArtStation &#x2197;\n596\t            </a>\n597\t          </div>\n598\t          <div style={{ display: 'grid', gridTemplateColumns: isMobile ? '1fr' : '1fr 1fr', gap: 12 }}>\n599\t            {projects.map(p => (\n600\t              <div key={p.id}\n601\t                style={{ border: `1px solid ${S[100]}`, borderRadius: 8, padding: 12, transition: 'border-color 0.2s, background 0.2s', background: 'transparent' }}\n602\t                onMouseEnter={e => { e.currentTarget.style.borderColor = '#bfdbfe'; e.currentTarget.style.background = 'rgba(239,246,255,0.3)'; }}\n603\t                onMouseLeave={e => { e.currentTarget.style.borderColor = S[100]; e.currentTarget.style.background = 'transparent'; }}\n604\t              >\n605\t                <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 8, marginBottom: 4 }}>\n606\t                  <span style={{ fontFamily: SERIF, fontWeight: 600, color: S[800], fontSize: 12, lineHeight: 1.25 }}>\n607\t                    {p.title}\n608\t                  </span>\n609\t                  {p.url && (\n610\t                    <a href={p.url} target=\"_blank\" rel=\"noopener noreferrer\"\n611\t                      style={{ color: ACCENT3, textDecoration: 'none', flexShrink: 0, fontFamily: MONO, fontSize: 10 }}\n612\t                      onMouseEnter={e => { e.currentTarget.style.color = ACCENT; }}\n613\t                      onMouseLeave={e => { e.currentTarget.style.color = ACCENT3; }}\n614\t                    >\n615\t                      &#x2197;\n616\t                    </a>\n617\t                  )}\n618\t                </div>\n619\t                <p style={{ fontFamily: MONO, fontSize: 10, color: ACCENT2, margin: '0 0 6px 0' }}>{p.brand}</p>\n620\t                <p style={{ fontFamily: SERIF, fontSize: 11, color: S[500], lineHeight: 1.375, margin: 0 }}>\n621\t                  {en ? (p.descriptionEn ?? p.description) : p.description}\n622\t                </p>\n623\t                {p.tags && (\n624\t                  <div style={{ display: 'flex', flexWrap: 'wrap', marginTop: 6 }}>\n625\t                    {p.tags.map(tag => <Tag key={tag} label={tag} />)}\n626\t                  </div>\n627\t                )}\n628\t              </div>\n629\t            ))}\n630\t          </div>\n631\t        </se