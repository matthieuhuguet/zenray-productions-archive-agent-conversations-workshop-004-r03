0 0 0 0 1  0 0 0 1 0'/>\" +\n      \"</filter><rect width='100%' height='100%' filter='url(%23f)'/></svg>\";\n    return \"url(\\\"data:image/svg+xml,\" + encodeURIComponent(svg) + \"\\\")\";\n  }\n\n  var lyrInk = document.getElementById('lyr-ink');\n  var lyrGrain = document.getElementById('lyr-grain');\n  var lyrSpeckle = document.getElementById('lyr-speckle');\n  var seedLabel = document.getElementById('seed-label');\n\n  var OPACITY = { ink: .55, grain: .70, speckle: .3, vignette: 1 };\n\n  function regen(){\n    var a = Math.floor(Math.random()*999);\n    var b = Math.floor(Math.random()*999);\n    var c = Math.floor(Math.random()*999);\n    lyrInk.style.backgroundImage = ink(a);\n    lyrGrain.style.backgroundImage = grain(b);\n    lyrSpeckle.style.backgroundImage = speckle(c);\n    seedLabel.textContent = 'seed ' + a + ' / ' + b + ' / ' + c;\n  }\n\n  document.getElementById('regen').addEventListener('click', regen);\n\n  document.querySelectorAll('.toggle input').forEach(function(box){\n    box.addEventListener('change', function(){\n      var name = box.getAttribute('data-layer');\n      var el = document.getElementById('lyr-' + name);\n      el.style.opacity = box.checked ? OPACITY[name] : 0;\n    });\n  });\n\n  // init\n  lyrInk.style.opacity = OPACITY.ink;\n  lyrGrain.style.opacity = OPACITY.grain;\n  lyrSpeckle.style.opacity = OPACITY.speckle;\n  regen();\n})();\n</script>\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7249,"cache_read_input_tokens":375358,"output_tokens":20250,"output_tokens_details":{"thinking_tokens":13337},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":7249,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":20250,"cache_read_input_tokens":375358,"cache_creation_input_tokens":7