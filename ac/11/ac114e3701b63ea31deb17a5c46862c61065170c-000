ar(--text); font-weight:600;}\n\n  /* ---- stage ---- */\n  .stage-frame{\n    position:relative;\n    border:1px solid var(--border);\n    border-radius:4px;\n    background:#000;\n    overflow:hidden;\n  }\n  .stage{\n    position:relative;\n    width:100%;\n    aspect-ratio:5/3;\n    overflow:hidden;\n    filter:grayscale(1) contrast(1.06) brightness(.98);\n  }\n  .layer{position:absolute; inset:0; background-repeat:repeat; transition:opacity .35s ease;}\n  .l-base{background:radial-gradient(115% 95% at 36% 52%, #6f7276 0%, #35373a 42%, #121315 100%);}\n  .l-ink{ background-size:820px 820px; mix-blend-mode:multiply; }\n  .l-grain{ background-size:480px 480px; mix-blend-mode:screen; }\n  .l-speckle{ background-size:260px 260px; mix-blend-mode:screen; }\n  .l-vignette{ background:radial-gradient(135% 120% at 32% 38%, rgba(0,0,0,0) 28%, rgba(0,0,0,.5) 72%, rgba(0,0,0,.85) 100%); mix-blend-mode:multiply; }\n\n  .stage-meta{\n    position:absolute; left:12px; bottom:10px;\n    font-family:var(--mono); font-size:11px; letter-spacing:.04em;\n    color:rgba(255,255,255,.55);\n    pointer-events:none;\n  }\n  .stage-corner{\n    position:absolute; width:14px; height:14px; pointer-events:none;\n    border-color:rgba(255,255,255,.35);\n  }\n  .c-tl{top:8px; left:8px; border-top:1px solid; border-left:1px solid;}\n  .c-tr{top:8px; right:8px; border-top:1px solid; border-right:1px solid;}\n  .c-bl{bottom:8px; left:8px; border-bottom:1px solid; border-left:1px solid;}\n  .c-br{bottom:8px; right:8px; border-bottom:1px solid; border-right:1px solid;}\n\n  /* ---- controls ---- */\n  .controls{\n    display:flex; flex-wrap:wrap; align-items:center; gap:10px;\n  }\n  button.regen{\n    font-family:var(--mono); font-size:12.5px; font-weight:500;\n    letter-spacing:.02em;\n    background:var(--accent-soft); color:var(--accent);\n    border:1px solid rgba(201,131,90,.35);\n    border-radius:3px;\n    padding:9px 14px;\n    cursor:pointer;\n    transition:background .2s ease, border-color .2s ease;\n  }\n  button.regen:hover{background:rgba(201,131,90,.22); border-color:rgba(201,131,90,.55);}\n  button.regen:focus-visible{outline:2px solid var(--accent); outline-offset:2px;}\n\n  .toggles{display:flex; flex-wrap:wrap; gap:8px; margin-left:auto;}\n  .toggle{\n    display:flex; align-items:center; gap:7px;\n    font-family:var(--mono); font-size:12px; color:var(--text-muted);\n    background:var(--surface); border:1px solid var(--border);\n    border-radius:999px; padding:6px 12px 6px 8px;\n    cursor:pointer; user-select:none;\n  }\n  .toggle input{accent-color:var(--accent); width:13px; height:13px; margin:0;}\n  .toggle span{white-space:nowrap;}\n\n  /* ---- recipe grid ---- */\n  .recipe-head{display:flex; align-items:baseline; justify-content:space-between; gap:16px; flex-wrap:wrap;}\n  .recipe-head h2{\n    font-size:13px; font-family:var(--mono); text-transform:uppercase; letter-spacing:.1em;\n    color:var(--text-faint); margin:0; font-weight:500;\n  }\n  .grid{\n    display:grid;\n    grid-template-columns:repeat(auto-fit, minmax(260px, 1fr));\n    gap:14px;\n  }\n  .card{\n    background:var(--surface);\n    border:1px solid var(--border);\n    border-radius:5px;\n    padding:16px 17px 17px;\n    display:flex; flex-direction:column; gap:9px;\n  }\n  .card .idx{font-family:var(--mono); font-size:11px; color:var(--accent); letter-spacing:.06em;}\n  .card h3{margin:0; font-size:15px; font-weight:600;}\n  .card p{margin:0; font-size:13px; line-height:1.5; color:var(--text-muted);}\n  .card pre{\n    margin:2px 0 0;\n    font-family:var(--mono); font-size:11.3px; line-height:1.55;\n    color:#b7c2c6;\n    background:var(--surface-2);\n    border:1px solid var(--border);\n    border-radius:4px;\n    padding:9px 10px;\n    overflow-x:auto;\n    white-space:pre;\n  }\n\n  /* ---- measurement callout ---- */\n  .callout{\n    display:flex; gap:14px;\n    background:var(--surface);\n    border:1px solid var(--border);\n    border-left:2px solid var(--accent);\n    border-radius:4px;\n    padding:16px 18px;\n  }\n  .callout .tag{\n    font-family:var(--mono); font-size:11px; color:var(--accent);\n    letter-spacing:.08em; text-transform:uppercase; flex:none; padding-top:2px;\n  }\n  .callout p{margin:0; font-size:13.5px; line-height:1.6; color:var(--text-muted);}\n  .callout b{color:var(--text); font-weight:600;}\n  .callout code{font-family:var(--mono); font-size:12.5px; color:#b7c2c6;}\n\n  footer{font-size:12px; color:var(--text-faint); font-family:var(--mono);}\n\n  @media (max-width:640px){\n    .wrap{padding:40px 18px 60px;}\n    .toggles{margin-left:0;}\n  }\n</style>\n\n<div class=\"wrap\">\n\n  <header>\n    <div class=\"eyebrow\">Étude de look · matthieuhuguet.com</div>\n    <h1>Recréer le flou d'encre gris, sans le chevalier ni la créature</h1>\n    <p class=\"lede\">\n      La référence n'est pas une photo mais une illustration à l'encre et au lavis, scannée puis désaturée.\n      Ce studio isole <b>l'atmosphère</b> (fond, bavures d'encre, grain, poussière, vignette) de son\n      <b>sujet</b> (les deux personnages), pour obtenir un calque réutilisable sur n'importe quel contenu,\n      exactement comme le grain cinéma déjà en place sur la page Works.\n    </p>\n  </header>\n\n  <div class=\"stage-frame\">\n    <div class=\"stage\" id=\"stage\">\n      <div class=\"layer l-base\"></div>\n      <div class=\"layer l-ink\" id=\"lyr-ink\"></div>\n      <div class=\"layer l-grain\" id=\"lyr-grain\"></div>\n      <div class=\"layer l-speckle\" id=\"lyr-speckle\"></div>\n      <div class=\"layer l-vignette\" id=\"lyr-vignette\"></div>\n      <div class=\"stage-corner c-tl\"></div>\n      <div class=\"stage-corner c-tr\"></div>\n      <div class=\"stage-corner c-bl\"></div>\n      <div class=\"stage-corner c-br\"></div>\n      <div class=\"stage-meta\" id=\"seed-label\">seed —</div>\n    </div>\n  </div>\n\n  <div class=\"controls\">\n    <button class=\"regen\" id=\"regen\">↻ Nouvelle variation</button>\n    <div class=\"toggles\">\n      <label class=\"toggle\"><input type=\"checkbox\" checked data-layer=\"ink\"><span>Encre</span></label>\n      <label class=\"toggle\"><input type=\"checkbox\" checked data-layer=\"grain\"><span>Grain</span></label>\n      <label class=\"toggle\"><input type=\"checkbox\" checked data-layer=\"speckle\"><span>Poussière</span></label>\n      <label class=\"toggle\"><input type=\"checkbox\" checked data-layer=\"vignette\"><span>Vignette</span></label>\n    </div>\n  </div>\n\n  <section>\n    <div class=\"recipe-head\"><h2>La pile, calque par calque</h2></div>\n    <div class=\"grid\">\n\n      <div class=\"card\">\n        <span class=\"idx\">01 · fond</span>\n        <h3>Lavis de base</h3>\n        <p>Dégradé radial simple, foyer clair décalé, coins qui s'assombrissent vers le noir. Pas de filtre, juste trois arrêts de couleur.</p>\n        <pre>radial-gradient(115% 95% at 36% 52%,\n  #6f7276 0%, #35373a 42%, #121315 100%)</pre>\n      </div>\n\n      <div class=\"card\">\n        <span class=\"idx\">02 · bavure</span>\n        <h3>Encre (nouveau calque)</h3>\n        <p>Bruit fractal à basse fréquence, flouté, puis l'alpha est cassée en paliers discrets au lieu d'un dégradé lisse : c'est ce qui simule l'encre qui sature le papier par zones plutôt qu'un fondu propre.</p>\n        <pre>feTurbulence fractalNoise 0.012 0.018, oct.4\nfeGaussianBlur stdDeviation 6\nfeComponentTransfer → feFuncA discrete\n  (paliers, pas de dégradé continu)\nfeColorMatrix → gris plat #6b6c70, alpha conservée\nblend: multiply · opacity .55</pre>\n      </div>\n\n      <div class=\"card\">\n        <span class=\"idx\">03 · grain</span>\n        <h3>Grain fin (déjà en prod)</h3>\n        <p>C'est le calque « Cinema film grain » déjà présent dans <code>App.jsx</code> (~L3010), inspiré Dune. Repris tel quel, seed rendue variable pour l'exploration.</p>\n        <pre>feTurbulence turbulence 0.95 1.05, oct.1\nfeGaussianBlur stdDeviation 0.3\nfeColorMatrix → gris