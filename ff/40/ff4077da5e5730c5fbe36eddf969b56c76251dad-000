registre, { resourceId, from, to, canonical, kind, maintenant }) {\n  if (!registre || registre.resourceId !== resourceId) return null\n  if (!from || !to || from === to) return null\n\n  const suivant = { ...registre }\n  // Seul le canonique déplace sa source, et seulement s'il en était bien la source.\n  //\n  // DEUX CHAMPS SELON LA NATURE, et c'est le cas qu'on oublie : une ressource FEUILLE porte\n  // `sourcePath` (le manifeste du média), une ressource DOSSIER porte `sourceDir` (le dossier réel\n  // dont les autres emplacements sont des vues). Brancher ce module sans couvrir le second casserait\n  // le déplacement d'un dossier lié, en silence.\n  if (canonical && kind !== 'folder' && registre.sourcePath === from) suivant.sourcePath = to\n  if (canonical && kind === 'folder' && registre.sourceDir === from) suivant.sourceDir = to\n\n  const emplacements = new Set(Array.isArray(registre.placements) ? registre.placements : [registre.sourcePath || registre.sourceDir || from].filter(Boolean))\n  emplacements.delete(from)\n  emplacements.add(to)\n  suivant.placements = [...emplacements]\n  suivant.updatedAt = maintenant || new Date().toISOString()\n  return suivant\n}\n\n// Applique PLUSIEURS déplacements au même registre, en une passe.\n//\n// C'est le cas du déplacement de dossier : plusieurs emplacements d'une même ressource peuvent\n// bouger dans le même arbre. Les appliquer un par un en écrivant à chaque fois ferait perdre toutes\n// les mutations sauf la dernière — le dernier écrivain gagne, les autres disparaissent sans bruit.\nexport function deplacerPlusieurs(registre, mouvements, maintenant) {\n  let courant = registre\n  let touche = false\n  for (const m of mouvements || []) {\n    const suivant = deplacerDansRegistre(courant, { ...m, maintenant })\n    if (suivant) { courant = suivant; touche = true }\n  }\n  return touche ? courant : null\n}\nShell cwd was reset to /Users/zenray/.claude/Memory1","is_error":false}]},"uuid":"d00d3318-9f6c-42fc-83fa-11