)\n      if (j && j.markdown != null && !j.missing) { setCur({ path }); setStatus('note du jour ouverte ✓'); return } // déjà créée -> on ouvre\n      const res = await apiPost('save', { path, markdown: `# ${title}\\n\\n` })\n      if (!res.ok) { setStatus('erreur ' + (res.error || '')); return }\n      // L'icône est cosmétique : on ne fait pas attendre l'ouverture pour elle, et son échec n'annule rien.\n      apiPost('save', { path: path.replace(/\\.md$/, '.props.json'), markdown: JSON.stringify({ icon: 'note.text' }) }).catch(() => {})\n      setCur({ path }); setStatus('note du jour créée ✓'); loadTree()\n    } catch { setStatus('erreur réseau') }\n    finally { setChargeNote(false) }\n  }\n  // ═══ LA COUVERTURE D'UN DOSSIER PARTAGÉ ══════════════════════════════════════════════════════\n  //\n  // Quatre balises `og:image` sont justes au sens du protocole et INVISIBLES en pratique : aucune\n  // messagerie ne lit la deuxième. Pour qu'on voie quatre photos, il faut leur en donner UNE qui\n  // les contienne. Le navigateur sait le faire — il a un canvas, un décodeur par format et de quoi\n  // réencoder — là où un Worker n'a rien de tout cela. On compose donc ici, une fois par partage.\n  //\n  // ÉCHOUER EST SANS CONSÉQUENCE, et c'est voulu : sans couverture, `share-og` retombe sur la\n  // première vignette, comportement d'avant. Un aperçu un peu moins riche ne doit jamais empêcher\n  // un lien d'être partagé.\n  const construireCouvertureDossier = React.useCallback(async (dir) => {\n    const prefixe = dir + '/'\n    const images = getIndexPaths()\n      .filter((p) => p.startsWith(prefixe) && p.endsWith('.img.json') && !p.slice(prefixe.length).includes('/'))\n      .sort()\n      .slice(0, 4)\n    if (images.length < 4) return           // moins de quatre : une seule photo, règle de Matthieu\n    const urls = (await Promise.all(images.map((p) => adresseVignetteIndex(getNodeThumb(p))))).filter(Boolean)\n    if (urls.length < 4) return\n    const blob = await