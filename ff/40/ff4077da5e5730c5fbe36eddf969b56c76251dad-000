onst nextN = (existing.length ? Math.max(...existing) : 0) + 1\n        const name = shardName(kind, vis, nextN)\n        const description = pub\n          ? 'ZenRay drive — shard PUBLIC (fichiers hashés SHA-256, servis via jsDelivr, aucun nom humain)'\n          : 'ZenRay drive — shard privé (fichiers hashés SHA-256)'\n        const cr = await ghRetry(\n          () => gh(token, 'user/repos', { method: 'POST', body: JSON.stringify({ name, private: !pub, description, auto_init: true }) }),\n          { tries: 4, retryOn: (r) => r.status >= 500 } // 422 (déjà existant) traité plus bas, pas de retry.\n        )\n        if (!cr || (!cr.ok && cr.status !== 422)) { const t = cr ? await cr.text() : 'network'; return res.status(200).json({ error: 'github', detail: String(t).slice(0, 160) }) }\n        // drive-3 : un 422 signifie « le repo existe déjà » (numérotation sous-évaluée, ex. shard hors fenêtre de\n        // pagination). On NE doit PAS le maquiller en « Créé » : on le rapporte tel quel (existed:true) pour que\n        // l'UI dise « Repo déjà présent » au lieu de mentir. Le README/branche existent déjà, rien d'autre à poser.\n        const existed = !!cr && cr.status === 422\n        if (existed) return res.status(200).json({ ok: true, name, existed: true })\n        // Attendre que la branche soit prête avant de poser le README (évite un 409 sur ref absente).\n        const ready = await waitShardReady(token, name)\n        if (!ready) return res.status(200).json({ error: 'github', detail: 'shard-not-ready' })\n        await ensureShardReadme(token, name, pub)\n        return res.status(200).json({ ok: true, name })\n      } catch (e) { return res.status(200).json({ error: 'fetch' }) }\n    }\n    return res.status(400).json({ error: 'bad-action' })\n  }\n  // GET ?action=tree&repo=<name>[&prefix=ab] : ARBORESCENCE d'un repo shard (objectif 2a), lecture seule.\n  //   - sans prefix : groupe les blobs par PRÉFIXE de 2 caractères (ab/) avec compte + octets par g