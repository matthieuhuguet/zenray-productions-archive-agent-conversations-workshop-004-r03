max-retries' }\n}\n90:  Alignées (lâcher = RÉORDONNER, mécanique du Shelf). Titre + note descriptive en h3 haut-gauche,\n// INGESTION D'IMAGE RÉSILIENTE pour le Shelf.\n// Prend une URL externe (API média, web) OU un dataUrl (fichier local converti), télécharge les octets CÔTÉ\n// SERVEUR (pas de CORS), les stocke dans le repo PUBLIC `zenray-shelf-img`, et renvoie une URL jsDelivr\n// ÉPINGLÉE AU COMMIT (immuable, servie par le CDN). But : ne plus dépendre de l'hôte d'origine — les API média\n// peuvent tomber, jsDelivr non. Layout PLAT à la racine (cohérent avec le seed : `<slug>-<rand>.<ext>`).\nimport { logStart, logEnd, describeCommand } from './cmdlog.js'\n\nconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\nconst REPO = process.env.SHELF_IMG_REPO || 'zenrayshards-img-124ff562adad' // ex zenray-shelf-img, renommé 2026-07-05 (rename v2) — les ÉCRITURES API ne suivent pas la redirection GitHub, d'où la mise à jour\nconst BRANCH = process.env.SHELF_IMG_BRANCH || 'main'\nconst MAX_BYTES = 12 * 1024 * 1024 // 12 Mo : large pour un poster, borne anti-abus.\nconst sleep = (ms) => new Promise((r) => setTimeout(r, ms))\n\nconst slug = (s) => (s || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '').slice(0, 48) || 'poster'\nconst extFor = (ct, url) => {\n  ct = (ct || '').toLowerCase()\n  if (ct.includes('webp')) return 'webp'\n  if (ct.includes('avif')) return 'avif'\n  if (ct.includes('png')) return 'png'\n  if (ct.includes('gif')) return 'gif'\n  if (ct.includes('jpeg') || ct.includes('jpg')) return 'jpg'\n  const m = (url || '').split('?')[0].match(/\\.(jpe?g|png|webp|avif|gif)$/i)\n  return m ? m[1].toLowerCase().replace('jpeg', 'jpg') : 'jpg'\n}\n\nexport default async function handler(req, res) {\n  if (req.method !== 'POST') { res.setHeader('Allow', 'POST'); return res.status(405).end() }\n  const token = process.env.GITHUB_TOKEN\n  if (!token) return res.status(200).json({ ok: false, error: 'no-