waitMs = waitMs }\n}\n\nconst defaultSleep = (ms) => new Promise((r) => setTimeout(r, ms))\nconst b64 = (u8) => (typeof Buffer !== 'undefined' ? Buffer.from(u8.buffer, u8.byteOffset, u8.byteLength).toString('base64') : btoa(String.fromCharCode(...u8)))\n\nexport function makeGitHub({ token, owner = 'matthieuhuguet', dataRepo = 'zenray-data', branch = 'main', fetchImpl = (...a) => fetch(...a), sleep = defaultSleep, tries = 4 } = {}) {\n  if (!token) throw new GhError('fatal', 'no-token')\n  const headers = { Authorization: `Bearer ${token}`, 'User-Agent': 'zenray-progress', 'Content-Type': 'application/json' }\n  const gh = { rate: null }\n\n  async function gql(query, variables) {\n    let last = null\n    for (let attempt = 0; attempt < tries; attempt++) {\n      let res\n      try { res = await fetchImpl('https://api.github.com/graphql', { method: 'POST', headers, body: JSON.stringify({ query, variables }) }) } catch (e) { last = new GhError('down', String((e && e.message) || e)); await sleep(400 * (attempt + 1)); continue }\n      const remaining = res.headers && res.headers.get && res.headers.get('x-ratelimit-remaining')\n      if (remaining != null) gh.rate = { graphqlRemaining: Number(remaining) }\n      if (res.status === 403 || res.status === 429) {\n        const retryAfter = Number(res.headers.get('retry-after'))\n        const waitMs = Number.isFinite(retryAfter) && retryAfter > 0 ? retryAfter * 1000 : 30_000\n        if (waitMs <= 4000 && attempt < tries - 1) { await sleep(waitMs + 200); continue }\n        throw new GhError('rate', 'rate-limited', waitMs)\n      }\n      if (res.status >= 500 || res.status === 499) { last = new GhError('down', `http-${res.status}`); await sleep(500 * (attempt + 1)); continue }\n      if (!res.ok) throw new GhError('fatal', `http-${res.status}`)\n      let json\n      try { json = await res.json() } catch { last = new GhError('down', 'bad-json'); await sleep(400 * (attempt + 1)); continue }\n      const err = json && Array.isArray(json.errors) && json.errors[0]\n      if (err) {\n        if (err.type === 'STALE_DATA' || /Expected branch to point/i.test(err.message || '')) throw new GhError('stale', 'stale')\n        if (err.type === 'RATE_LIMITED' || /rate limit/i.test(err.message || '')) throw new GhError('rate', 'rate-limited', 60_000)\n        if (err.type === 'NOT_FOUND') throw new GhError('fatal', 'not-found')\n        if (/timeout|timed out|something went wrong/i.test(err.message || '')) { last = new GhError('down', err.message); await sleep(500 * (attempt + 1)); continue }\n        throw new GhError('fatal', String(err.message || err.type || 'graphql-error').slice(0, 160))\n      }\n      return json.data\n    }\n    throw last || new GhError('down', 'unknown')\n  }\n\n  /** `repo` = 'owner/name' or just 'name' (then `owner` applies). */\n  const full = (repo) => (repo.includes('/') ? repo : `${owner}/${repo}`)\n\n  /**\n   * One query: branch head, repository size, and for each `exprs[i]` ({ path }) the blob text / tree existence.\n   * Returns { oid, diskUsageKb, items:[{ kind:'blob'|'tree'|null, text, size }] } (items aligned with `paths`).\n   */\n  async function read(repo, paths = []) {\n    const [o, n] = full(repo).split('/')\n    const vars = { o, n, ref: `refs/heads/${branch}` }\n    const decl = ['$o:String!', '$n:String!', '$ref:String!']\n    const sel = paths.map((p, i) => { vars[`e${i}`] = `${branch}:${p}`; decl.push(`$e${i}:String!`); return `a${i}: object(expression:$e${i}){ __typename ... on Blob { text byteSize isBinary } ... on Tree { oid } }` })\n    const q = `query(${decl.join(',')}){ repository(owner:$o,name:$n){ diskUsage ref(qualifiedName:$ref){ target{ oid } } ${sel.join(' ')} } }`\n    const data = await gql(q, vars)\n    const repoNode = data && data.repository\n    if (!repoNode) throw new GhError('fatal', 'no-repository')\n    const items = paths.map((_, i) => {\n      const it = repoNode[`a${i}`]\n      if (!it) return { kind: null, text: null