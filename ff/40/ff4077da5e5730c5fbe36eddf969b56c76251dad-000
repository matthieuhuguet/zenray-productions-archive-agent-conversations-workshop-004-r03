 const dot = base.lastIndexOf('.')\n  if (dot <= 0) return null\n  const ext = base.slice(dot + 1).toLowerCase()\n  if (!IMAGE_EXTS.includes(ext)) return null\n  let stem = cleanSegment(base.slice(0, dot))\n  stem = [...stem].slice(0, GUEST.STEM_MAX).join('').trim() || 'photo'\n  return { stem, ext, display: `${stem}.${ext}` }\n}\n\n/** Magic bytes of the first chunk: the browser-declared type is never trusted. */\nexport function looksLikeImage(u8) {\n  if (!u8 || u8.length < 12) return false\n  const b = u8\n  if (b[0] === 0xff && b[1] === 0xd8 && b[2] === 0xff) return true                                   // jpeg\n  if (b[0] === 0x89 && b[1] === 0x50 && b[2] === 0x4e && b[3] === 0x47) return true                   // png\n  if (b[0] === 0x47 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x38) return true                   // gif\n  if (b[0] === 0x42 && b[1] === 0x4d) return true                                                    // bmp\n  if ((b[0] === 0x49 && b[1] === 0x49 && b[2] === 0x2a && b[3] === 0) || (b[0] === 0x4d && b[1] === 0x4d && b[2] === 0 && b[3] === 0x2a)) return true // tiff\n  if (b[0] === 0x52 && b[1] === 0x49 && b[2] === 0x46 && b[3] === 0x46 && b[8] === 0x57 && b[9] === 0x45 && b[10] === 0x42 && b[11] === 0x50) return true // webp\n  if (b[4] === 0x66 && b[5] === 0x74 && b[6] === 0x79 && b[7] === 0x70) return true                   // heic / heif / avif (ISO-BMFF ftyp)\n  return false\n}\nEOF\ncat > src/lib/guestNames.test.js <<'EOF'\nimport { describe, expect, it } from 'vitest'\nimport { cleanGuestName, cleanSubPath, splitImageName, looksLikeImage } from './guestNames.js'\nimport { packFrame, unpackFrame, sliceParts } from './guestFrame.js'\n\ndescribe('cleanGuestName', () => {\n  it('garde les accents, retire les séparateurs et les points de tête', () => {\n    expect(cleanGuestName('  Marie-Éloïse  ')).toBe('Marie-Éloïse')\n    expect(cleanGuestName('../../etc/passwd')).toBe('etc passwd')\n    expect(cleanGuestName('.hidden')).toBe('hidd