(!res.ok) return null\n  const buf = Buffer.from(await res.arrayBuffer())\n  return { bytes: m.thumbIv ? decrypt(buf, m.thumbIv) : buf, source }\n}\n\nexport async function buildCover(dir, { force = false } = {}) {\n  const kids = (await api({ action: 'children', dir })).entries || []\n  const images = kids.map((e) => e.path).filter((p) => p.endsWith('.img.json') && !p.slice(dir.length + 1).includes('/')).sort()\n  if (images.length < 4) return { dir, status: `skipped (${images.length} images: four or nothing)` }\n  const picks = pickCandidates(images, 8)\n  const chosen = []\n  for (const p of [...picks, ...images.filter((x) => !picks.includes(x))].slice(0, 16)) {\n    if (chosen.length === 4) break\n    const t = await thumbOf(p).catch(() => null)\n    if (t) chosen.push({ p, ...t })\n  }\n  if (chosen.length < 4) return { dir, status: 'skipped (fewer than four usable thumbnails)' }\n  const sig = createHash('sha1').update(chosen.map((c) => c.source).join('|')).digest('hex').slice(0, 16)\n  const target = `${dir}/${COVER_FILE}`\n  const prev = await api({ action: 'read', path: target })\n  let prevSig = null; try { prevSig = JSON.parse(prev.markdown).sig } catch {}\n  if (!force && prevSig === sig) return { dir, status: 'up to date' }\n  const work = mkdtempSync(path.join(tmpdir(), 'zr-cover-'))\n  const files = chosen.map((c, i) => { const f = path.join(work, `t${i}.webp`); writeFileSync(f, c.bytes); return f })\n  const out = path.join(work, 'cover.webp')\n  const tile = (f) => ['(', f, '-resize', `${CASE}x${CASE}^`, '-gravity', 'center', '-extent', `${CASE}x${CASE}`, ')']\n  execFileSync('magick', [\n    '-size', `${COTE}x${COTE}`, 'xc:#17181b',\n    ...files.flatMap((f, i) => [...tile(f), '-gravity', 'northwest', '-geometry', `+${(i % 2) * (CASE + LISERE)}+${Math.floor(i / 2) * (CASE + LISERE)}`, '-composite']),\n    '-quality', '86', out,\n  ])\n  const b64 = readFileSync(out).toString('base64')\n  const res = await fetch(`${site}/api/page`, {\n    method: 'POST', headers: { 'content-type': 'application/json', 'x-zr-auth': secret },\n    body: JSON.stringify({ action: 'save', path: target, markdown: JSON.stringify({ b64, mime: 'image/webp', sig, at: new Date().toISOString() }), ...(prev.sha ? { sha: prev.sha } : {}) }),\n  }).then((r) => r.json())\n  return { dir, status: res.ok ? `written (${Math.round(b64.length * 0.75 / 1024)} KB, ${chosen.map((c) => c.p.split('/').pop().replace('.img.json', '')).join(', ')})` : `FAILED ${JSON.stringify(res)}` }\n}\n\n// every active FOLDER share (not revoked, not expired), read from the private drive repo with the local `gh`\nfunction activeFolderShares() {\n  const gh = (a) => execFileSync('gh', a, { encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 })\n  const tree = JSON.parse(gh(['api', 'repos/matthieuhuguet/zenray-data/git/trees/main:_shares%2Fv1?recursive=1'])).tree.filter((x) => x.type === 'blob')\n  const dirs = new Set()\n  for (const f of tree) {\n    try {\n      const rec = JSON.parse(Buffer.from(JSON.parse(gh(['api', `repos/matthieuhuguet/zenray-data/git/blobs/${f.sha}`])).content, 'base64').toString('utf8'))\n      if (rec.kind === 'folder' && !rec.revokedAt && Date.parse(rec.expiresAt) > Date.now()) dirs.add(rec.path)\n    } catch { /* unreadable record: skip */ }\n  }\n  return [...dirs]\n}\n\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {\n  if (!secret) { console.error('ZENRAY_API_SECRET is required'); process.exit(2) }\n  const targets = flag('--all') ? activeFolderShares() : [args.find((a) => !a.startsWith('--') && a !== opt('--site'))].filter(Boolean)\n  if (!targets.length) { console.error('usage: build-share-cover.mjs <folder path> | --all'); process.exit(2) }\n  let failed = 0\n  for (const dir of targets) {\n    const r = await buildCover(dir, { force: flag('--force') }).catch((e) => ({ dir, status: `FAILED ${e.message}` }))\n    console.log(`${r.status.startsWith('FAILED') ? '✗' : '✓'} ${dir.split('/').slice(-2).join('/')} : $