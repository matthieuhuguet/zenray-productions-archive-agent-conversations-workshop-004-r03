{"parentUuid":"d075acc9-2fa3-45c3-86e5-7a0b883af6e5","isSidechain":false,"promptId":"212570e0-88cc-4346-8e5e-23f5a2760bfc","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QGrqayWB7CTBzGtNDsHArE","type":"tool_result","content":"// img-ingest.mjs — SIDECAR Node d'ingestion IMAGE en masse (choix A1 : sidecar pur, PAS de navigateur headless).\n//\n// EN CLAIR : quand le script d'archive en masse (archive-folder.mjs) croise une IMAGE, il NE doit PLUS la\n// découper en morceaux binaires opaques (.file.json). Une image, on sait l'afficher tout de suite. Ce module\n// reproduit en Node EXACTEMENT le pipeline image de l'app :\n//   1. chiffre l'image (AES-256-GCM, clé maître, IV déterministe = dédup) ;\n//   2. la pousse CHIFFRÉE sur un shard PUBLIC zenray-img-public-NN (servi par jsDelivr) ;\n//   3. fabrique une VRAIE vignette .webp (ffmpeg), chiffrée elle aussi ;\n//   4. rend un manifeste .img.json IDENTIQUE au schéma in-app (buildPublicImgManifest).\n// Résultat : l'image archivée s'ouvre inline dans Create, avec sa vignette, ZÉRO réassemblage.\n//\n// POURQUOI A1 (sidecar) ET PAS A2 (navigateur headless rejouant captureImage) : zéro dépendance lourde,\n// zéro risque, diff borné. Coût assumé : garder ce fichier synchrone du schéma .img.json. Si la logique\n// image diverge un jour, réévaluer A2 (noté, pas fait). Réutilise la lib CANONIQUE Scripts/lib/img-pipeline.mjs.\n//\n// CONTRAINTE DURE (héritée du modèle projet) : push par GIT (transport hors quota REST), cap dur < 5 Go/shard\n// avec rollover, jamais de token committé, public par défaut (P0 anti-fuite : chemins = hash, aucun nom humain).\n\nimport { readFile, writeFile, mkdir, rm } from 'node:fs/promises'\nimport { spawnSync, execFileSync } from 'node:child_process'\nimport path from 'node:path'\nimport { existsSync, readFileSync } from 'node:fs'\nimport {\n  sha256Hex, ivFromHash, encryptDeterministic, loadMasterKey,\n  shardPathFor, shardChunkPathFor, splitIntoChunks, SHARD_CAP_BYTES, jsDelivrUrl,\n  buildPublicImgManifest, GIT_ENV, THUMB_MAX_SHORT, THUMB_QUALITY,\n} from './lib/img-pipeline.mjs'\nimport { classifyCommitResult, requireCommitSha } from './lib/git-result.mjs'\n\n// OUTILS IMAGE Node : cwebp (libwebp) pour la vignette .webp ; sips (natif macOS) pour les dimensions et\n// pour décoder les formats que cwebp ne lit pas (HEIC, TIFF exotiques) en PNG intermédiaire. ffprobe reste\n// un dernier recours pour les dimensions. Tous surchargeables par env pour portabilité.\nconst CWEBP = process.env.ZR_CWEBP || '/opt/homebrew/bin/cwebp'\nconst SIPS = process.env.ZR_SIPS || '/usr/bin/sips'\nconst FFPROBE = process.env.ZR_FFPROBE || '/opt/homebrew/bin/ffprobe'\nconst MAGICK_IDENTIFY = process.env.ZR_IDENTIFY || '/opt/homebrew/bin/identify'\nconst REPO_CREATE_TIMEOUT_MS = Number(process.env.ZR_REPO_CREATE_TIMEOUT_MS) || 30000\n\n// L'image est poussée TELLE QUELLE (octets d'origine chiffrés, jamais ré-encodés) : préserve la qualité,\n// garde l'idempotence par hash du clair d'origine. Seule la vignette est dérivée. Le ciphertext est ensuite\n// DÉCOUPÉ en morceaux ≤19 Mo (splitIntoChunks, lib/img-pipeline.mjs) — plus de version recompressée\n// dispPath : la reconstruction bit-exacte via jsDelivr remplace l'ancien barreau d'affichage (2026-07-07).\n\n// ═══ LES DIMENSIONS DOIVENT ÊTRE CELLES AFFICHÉES, PAS CELLES DU CAPTEUR (2026-09-03) ═══════════\n//\n// SYMPTÔME signalé par Matthieu : plein de miniatures étirées horizontalement sur le site, « un effet\n// d'agrandissement en scale x ». Ce n'était pas un bug CSS : les vignettes elles-mêmes, en pixels, sur\n// le drive, étaient déformées.\n//\n// LA CAUSE. `sips -g pixelWidth -g pixelHeight` rend le buffer BRUT du capteur, PAS la taille telle\n// qu'affichée. Mesuré sur une vraie photo iPhone portrait : sips annonce 5712x4284 (paysage) alors que\n// son tag EXIF Orientation vaut 6 (rotation 90°) et que la photo, ouverte normalement, est bien\n// PORTRAIT 4284x5712. Vérifié aussi sur HEIC : sips se trompe pareil, `identify` a raison nativement.\n//\n// CE QUE ÇA CASSAIT, à DEUX endroits qui partagent cette fonction :\n//   1. Le manifeste (w,h) sert à donner sa forme à la boîte du Quick Look (ratio = w/h). Une boîte\n//      shapée en paysage pour une photo portrait suffit déjà à tout dérégler.\n//   2. PIRE : `makeThumbAt()` calcule la géométrie de la vignette À PARTIR de ce même (w,h), puis\n//      appelle `magick … -auto-orient -resize <geom>!`. Le `-auto-orient` pivote CORRECTEMENT les\n//      pixels vers le portrait, mais le `!` de la géométrie FORCE le résultat dans le cadre PAYSAGE\n//      calculé par erreur — ImageMagick étire alors le portrait déjà pivoté pour qu'il rentre dans un\n//      rectangle qui n'a jamais eu la bonne forme. La distorsion est donc CUITE dans les octets du\n//      fichier .webp poussé sur le drive, pas seulement un problème d'affichage.\n//\n// LE CORRECTIF. `identify -auto-orient` rend la taille TELLE QU'AFFICHÉE, JPEG et HEIC compris (les deux\n// mesurés le 2026-09-03), en une seule commande. Il devient la source PRINCIPALE ; sips reste un repli\n// pour les formats qu'ImageMagick ne sait pas ouvrir (RAW exotiques), avec sa limite documentée : il ne\n// corrige pas l'orientation, donc un RAW portrait mal orienté resterait signalé en paysage dans ce cas\n// de repli seulement. ffprobe ferme la marche, inchangé.\nfunction imageDims(abs) {\n  try {\n    const out = execFileSync(MAGICK_IDENTIFY, ['-auto-orient', '-format', '%wx%h', abs], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 15000 }).toString()\n    const m = out.match(/(\\d+)x(\\d+)/)\n    if (m) return { w: parseInt(m[1], 10), h: parseInt(m[2], 10) }\n  } catch {}\n  try {\n    const out = execFileSync(SIPS, ['-g', 'pixelWidth', '-g', 'pixelHeight', abs], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 30000 }).toString()\n    const w = (out.match(/pixelWidth:\\s*(\\d+)/) || [])[1]\n    const h = (out.match(/pixelHeight:\\s*(\\d+)/) || [])[1]\n    if (w && h) return { w: parseInt(w, 10), h: parseInt(h, 10) }\n  } catch {}\n  try {\n    const out = execFileSync(FFPROBE, ['-v', 'error', '-select_streams', 'v:0', '-show_entries', 'stream=width,height', '-of', 'csv=p=0:s=x', abs], { stdio: ['ignore', 'pipe', 'ignore'], timeout: 3000\n    const m = out.match(/(\\d+)x(\\d+)/)\n    if (m) return { w: parseInt(m[1], 10), h: parseInt(m[2], 10) }\n  } catch {}\n  return { w: 0, h: 0 }\n}\n\n// SUPPRIMÉ (2026-07-13) : makeThumbWebp, l'ancienne vignette 384px/q72. Elle rendait les aperçus flous\n// sur les écrans haute densité (iPhone 15 Pro Max). La SEULE fabrique de vignette est désormais\n// makeThumbAt() plus bas : petit côté <= 1080px, WebP qualité 60, jamais d'agrandissement.\n// Les 2552 images DJI déjà en ligne ont été régénérées à ce format le 2026-07-13 (voir PROGRESS.md).\n// Si tu cherches l'ancien code : git log -S makeThumbWebp — ne le réintroduis pas.\n\n// ── CONTEXTE SHARD IMAGE PUBLIC (git push incrémental, rollover < 5 Go) ───────────────────────────────\n// Le bulk crée UN contexte partagé en début de run, le passe à chaque ingestImageBulk, puis appelle\n// flushImgShard() à la fin (push final + commit SHA pour pinner les URLs jsDelivr). Patron jumeau du shard\n// de archive-folder.mjs, mais sur la famille zenray-img-public-NN (publique, chiffrée).\nexport function makeImgShardCtx({ token, owner = 'matthieuhuguet', work, repoRoot, log = console.log, onPushed = () => {} }) {\n  const key = loadMasterKey(repoRoot, { readFileSync })\n  if (!key) throw new Error('clé maître média introuvable (ZENRAY_MEDIA_KEY ou <repo>/.zenray-media-key) — img-ingest impossible')\n  const GENV = { ...process.env, ...GIT_ENV }\n  const cloneUrl = (repo) => `https://x-access-token:${token}@github.com/${owner}/${repo}.git`\n  const git = (dir, a, timeout = 240000) => spawnSync('git', ['-C', dir, ...a], { encoding: 'utf8', env: GENV, timeout, killSignal: 'SIGKILL' })\n  const head = (dir, label) => requireCommitSha(git(dir, ['rev-parse', 'HEAD']), label)\n  const commitStaged = (dir, message, label) => {\n    const add = git(dir, ['add', '-A'])\n    if (add.status !== 0) throw new Error(`git add ${label}: ` + (add.stderr || '').slice(-200))\n    const commit = git(dir, ['commit', '-q', '-m', message])\n    const staged = commit.status === 0 ? null : git(dir, ['diff', '--cached', '--quiet'])\n    const issue = classifyCommitResult(commit.status, staged?.status)\n    if (issue === 'failed') throw new Error(`git commit ${label}: ` + (commit.stderr || commit.stdout || staged?.stderr || 'sans message').slice(-200))\n    return issue\n  }\n\n  const ctx = {\n    token, owner, work, key, log,\n    repo: null, dir: null, bytes: 0, pending: 0,\n    commitOf: {},          // repo -> commit SHA (rempli au flush ; pour pinner jsDelivr)\n    // staged[] : { repo, hashedPath, kind:'img'|'thumb' } — info de debug seulement.\n  }\n\n  // MODÈLE 2026-07-05 (décision Matthieu, même contrat que makeVidRawShardCtx) : repo NEUF par lot,\n  // nom aléatoire zenrayshards-img-<hex12>, PUBLIC (jsDelivr exige public — seule famille publique de la\n  // convention). ZÉRO clone d'un shard existant, ZÉRO check de place distant. Le découpage au sein d'un\n  // lot géant reste anticipé par compteur LOCAL (writeBinary). Ne JAMAIS recréer un ancien nom de repo :\n  // les vieux manifestes reposent sur la redirection GitHub ancien->nouveau nom (vérifiée OK le 2026-07-05\n  // sur raw.githubusercontent.com ET jsDelivr, chemins non cachés).\n  async function openShard() {\n    const { randomBytes } = await import('node:crypto')\n    ctx.repo = `zenrayshards-img-${randomBytes(6).toString('hex')}`\n    ctx.dir = path.join(work, ctx.repo)\n    await rm(ctx.dir, { recursive: true, force: true })\n    await mkdir(ctx.dir, { recursive: true })\n    git(ctx.dir, ['init', '-q']); git(ctx.dir, ['branch', '-M', 'main'])\n    git(ctx.dir, ['config', 'user.email', 'bot@zenray']); git(ctx.dir, ['config', 'user.name', 'zenray-bot'])\n    git(ctx