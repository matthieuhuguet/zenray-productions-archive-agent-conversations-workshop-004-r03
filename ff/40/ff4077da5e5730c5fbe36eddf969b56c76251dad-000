an] [--only=img|vid]\n//   plan.json = [{ \"src\": \"/abs/file\", \"dest\": \"pages/…/<Author>\", \"name\": \"<Author> - IMG_1.HEIC\", \"by\": \"<Author>\" }, …]\n//   --plan : prints the table (counts per folder, already-online skips) and stops, zero network, zero shard.\n// REST used : 1 call per new shard (repo creation), index-add once at the end. Never a per-file REST call.\n\nimport { makeImgShardCtx, ingestImageBulk, resolveImgManifest } from './img-ingest.mjs'\nimport { makeVidRawShardCtx, ingestVideoRaw } from './video-raw-lib.mjs'\nimport { jsDelivrUrl, GIT_ENV } from './lib/img-pipeline.mjs'\nimport { kindForName } from '../src/lib/fileKinds.js'\nimport { appendPublicDelta, thumbsForPaths } from '../server/page.js'\nimport { execFileSync } from 'node:child_process'\nimport { existsSync, readFileSync } from 'node:fs'\nimport { mkdir, writeFile, rm, stat } from 'node:fs/promises'\nimport path from 'node:path'\n\nconst REPO = '/Users/zenray/Create/Build/Productions/GithubProductions/ZenRayProgress'\nconst OWNER = process.env.CONTENT_OWNER || 'matthieuhuguet'\nconst token = process.env.GITHUB_TOKEN\nconst CLONE = process.env.ZR_ZDATA_CLONE\nconst args = process.argv.slice(2)\nconst planFile = args.find((a) => !a.startsWith('--'))\nconst PLAN_ONLY = args.includes('--plan')\nconst ONLY = (args.find((a) => a.startsWith('--only=')) || '').slice(7) // '', 'img' or 'vid'\nconst BATCH = Number(process.env.ZR_MAPPED_BATCH || 100) // manifests committed every BATCH files (checkpoint)\nif (!planFile) { console.error('usage: GITHUB_TOKEN=.. ZR_ZDATA_CLONE=.. node upload-mapped-git.mjs <plan.json> [--plan] [--only=img|vid]'); process.exit(1) }\nif (!PLAN_ONLY && (!token || !CLONE)) { console.error('GITHUB_TOKEN and ZR_ZDATA_CLONE (isolated sparse clone of zenray-data) are required'); process.exit(1) }\nif (CLONE && !existsSync(path.join(CLONE, '.git'))) { console.error(`clone not found: ${CLONE}`); process.exit(1) }\n\nconst plan = JSON.parse(readFileSync(planFile, 'utf8'))\nconst kindOf = (e) => { const k = kindForName(e.src); return k === 'video' ? 'vid' : (k === 'image' || k === 'image-lib') ? 'img' : 'other' }\nconst stemOf = (name) => name.replace(/\\.[^.]+$/, '')\nconst extLower = (name) => name.split('.').pop().toLowerCase()\nconst manifestPathOf = (e) => (kindOf(e) === 'vid'\n  ? `${e.dest}/${stemOf(e.name)}.${extLower(e.src)}.media.json`\n  : `${e.dest}/${e.name}.img.json`)\n\nconst GENV = { ...process.env, ...GIT_ENV }\nconst git = (a, timeout = 300000) => execFileSync('git', ['-C', CLONE, ...a], { env: GENV, timeout, encoding: 'utf8' })\nif (!PLAN_ONLY) { if (git(['status', '--porcelain']).trim()) throw new Error('clone is dirty, refusing to start'); git(['pull', '--rebase', '-q']) }\n\n// 1) validation + local skips (zero network) / FR : validation et sauts locaux\nconst bad = [], other = [], todo = []\nconst names = new Set()\nfor (const e of plan) {\n  const k = kindOf(e)\n  if (k === 'other') { other.push(e.src); continue }\n  if (ONLY && ONLY !== k) continue\n  const key = manifestPathOf(e)\n  if (names.has(key)) throw new Error(`duplicate target ${key}`)\n  names.add(key)\n  try { await stat(e.src) } catch { bad.push(e.src); continue }\n  if (CLONE && existsSync(path.join(CLONE, key))) continue // already online\n  todo.push({ ...e, kind: k, key })\n}\nconst perDest = {}\nfor (const e of todo) perDest[e.dest] = (perDest[e.dest] || { img: 0, vid: 0 }), perDest[e.dest][e.kind]++\nconsole.log(`plan: ${plan.length} entries, to upload ${todo.length} (img ${todo.filter((e) => e.kind === 'img').length}, vid ${todo.filter((e) => e.kind === 'vid').length}), missing sources ${bad.length}, unknown kinds ${other.length}`)\nfor (const [d, c] of Object.entries(perDest).sort()) console.log(`  ${d.split('/').slice(-1)[0].padEnd(24)} img ${String(c.img).padStart(4)}  vid ${String(c.vid).padStart(4)}`)\nif (bad.length) console.log('missing:', bad.slice(0, 5))\nif (other.length) console.log('unknown kinds:', other.slice(0, 5))\nif (PLAN_ONLY || !todo.length || bad.length || other.length) process.exit(bad.length || other.length ? 1 : 0)\n\n// 2) commit + push manifests, checkpoint after every batch (retry on non-fast-forward) / FR : point de reprise\nconst writtenPaths = []\nasync function commitManifests(blobs, label) {\n  if (!blobs.length) return\n  for (const b of blobs) { const abs = path.join(CLONE, b.path); await mkdir(path.dirname(abs), { recursive: true }); await writeFile(abs, b.content) }\n  git(['add', '--', ...blobs.map((b) => b.path)])\n  git(['commit', '-q', '-m', `add: ${label} (${blobs.length} manifests)`])\n  for (let a = 0; a < 5; a++) {\n    try { git(['push', '-q', 'origin', 'HEAD:main'], 600000); break }\n    catch (e) { console.log(`push rejected, pull --rebase and retry ${a + 1}/5`); git(['pull', '--rebase', '-q']); if (a === 4) throw e }\n  }\n  for (const b of blobs) writtenPaths.push(b.path)\n  console.log(`  checkpoint: ${blobs.length} manifests pushed (${writtenPaths.length} total)`)\n}\n\nconst withBy = (content, e) => { const m = JSON.parse(content); if (e.by) m.by = e.by; return JSON.stringify(m) }\nconst runWork = path.join(process.env.HOME, '.zr-archive-work-mapped', `run-${process.pid}-${Date.now().toString(36)}`)\nlet ok = 0, failed = 0\nconst failures = []\nconst imgCtxRepos = new Set()\ntry {\n  // 3) images -> public shard\n  const imgs = todo.filter((e) => e.kind === 'img')\n  if (imgs.length) {\n    const ctx = makeImgShardCtx({ token, work: path.join(runWork, 'img'), repoRoot: REPO, log: (...a) => console.log('   ', ...a) })\n    await ctx.openShard()\n    for (let i = 0; i < imgs.length; i += BATCH) {\n      const slice = imgs.slice(i, i + BATCH), pendings = []\n      for (const e of slice) {\n        try { pendings.push({ e, p: await ingestImageBulk(e.src, e.name, e.dest, ctx) }) }\n        catch (err) { failed++; failures.push(e.src); console.log(`✗ FAIL ${e.name}: ${(err && err.message || err).toString().slice(0, 160)}`) }\n      }\n      await ctx.flush()\n      const blobs = []\n      for (const { e, p } of pendings) {\n        try { const sb = resolveImgManifest(p, ctx); blobs.push({ path: sb.path, content: withBy(sb.content, e) }); imgCtxRepos.add(p.repo) }\n        catch (err) { failed++; failures.push(e.src); console.log(`✗ resolve ${e.name}: ${(err && err.message || err).toString().slice(0, 120)}`) }\n      }\n      await commitManifests(blobs, `images ${i + 1}-${i + slice.length}`)\n      ok += blobs.length\n      console.log(`  images ${Math.min(i + BATCH, imgs.length)}/${imgs.length} online`)\n    }\n  }\n  // 4) videos -> private shard (one flush per video inside ingestVideoRaw)\n  const vids = todo.filter((e) => e.kind === 'vid')\n  if (vids.length) {\n    const vctx = makeVidRawShardCtx({ token, work: path.join(runWork, 'vid'), log: (...a) => console.log('   ', ...a), type: 'vid', vis: 'private' })\n    let blobs = []\n    for (let i = 0; i < vids.length; i++) {\n      const e = vids[i]\n      try {\n        const { manifestPath, manifest } = await ingestVideoRaw(e.src, { dest: e.dest, base: stemOf(e.name), vctx, workDir: path.join(runWork, 'remux'), log: () => {} })\n        if (manifestPath !== e.key) throw new Error(`manifest path mismatch ${manifestPath} != ${e.key}`)\n        manifest.name = e.name // title carries the author / FR : le titre porte l'auteur\n        if (e.by) manifest.by = e.by\n        blobs.push({ path: manifestPath, content: JSON.stringify(manifest) })\n        console.log(`✓ [${i + 1}/${vids.length}] ${e.name}`)\n      } catch (err) { failed++; failures.push(e.src); console.log(`✗ FAIL ${e.name}: ${(err && err.message || err).toString().slice(0, 160)}`) }\n      if (blobs.length >= BATCH || (i === vids.length - 1 && blobs.length)) { await commitManifests(blobs, `videos to ${i + 1}`); ok += blobs.length; blobs = [] }\n    }\n  }\n} finally {\n  await rm(runWork, { recursive: true, force: true }).catch(() => {})\n}\n\n// 5) one single index-add with the full list (never several, see INDEX-ERREURS-FEATURES 2026-07-14) / FR : un seul index-add\nif (writtenPaths.length) {\n  try {\n    const allThumbs = {}\n    for (let i = 0; i < writtenPaths.length; i += 200) Object.assign(allThumbs, await thumbsForPaths(token, writtenPaths.slice(i, i + 200)))\n    const idxOk = await appendPublicDelta(token, writtenPaths, allThumbs)\n    console.log(`  index-add: ${idxOk ? writtenPaths.length : 0}/${writtenPaths.length} paths added to the public delta`)\n  } catch (e) { console.log(`  ⚠ index-add failed (recoverable with scripts/index-add-paths.mjs): ${(e && e.message || e).toString().slice(0, 120)}`) }\n}\nconsole.log(`\\n✓✓ MAPPED GIT UPLOAD DONE: ${ok} manifests online, ${failed} failure(s).`)\nif (failures.length) console.log('failed sources:', failures.join('\\n  '))\nprocess.exit(failed ? 1 : 0)\n","structuredPatch":[{"oldStart":113,"oldLines":6,"newStart":113,"newLines":10,"lines":["   const vids = todo.filter((e) => e.kind === 'vid')","   if (vids.length) {","     const vctx = makeVidRawShardCtx({ token, work: path.join(runWork, 'vid'), log: (...a) => console.log('   ', ...a), type: 'vid', vis: 'private' })","+    // One shared private shard for the whole job: ingestVideoRaw calls beginFile() per video, which would open a NEW repo for every","+    // clip (179 repos for 179 clips, measured 2 October 2026). A no-op beginFile keeps one shard, rollover stays at SHARD_CAP.","+    // FR : un seul shard privé partagé ; sans cela, un repo neuf par clip (179 repos pour 179 clips, mesuré le 2 October 2026).","+    vctx.beginFile = async () => {}","     let blobs = []","     for (let i = 0; i < vids.length; i++) {","       const e = vids[i]"]}],"userModified":false,"replaceAll":false},"serverClassifierContext":{"request":"f589f0dc-38e1-4616-9a15-cfe8d9e7ce2f","context":{"git_state":{"cwd":"/Users/zenray/.claude/Memory1","root":"/Users/zenray/.claude/Memory1","branch":"main","default_branch":"main","status":{"clean":false,"counts":{"staged":0,"modified":1,