onst BRANCH = process.env.CONTENT_BRANCH || 'main'\n\n// AES-GCM: same algo as client-side media/crypto.js (12-byte IV, 16-byte tag at the end of the ciphertext).\nfunction decryptAesGcm(cipherBuf, ivB64, keyB64) {\n  const key = Buffer.from(keyB64, 'base64')\n  const iv = Buffer.from(ivB64, 'base64')\n  const tag = cipherBuf.subarray(cipherBuf.length - 16)\n  const data = cipherBuf.subarray(0, cipherBuf.length - 16)\n  const decipher = createDecipheriv('aes-256-gcm', key, iv)\n  decipher.setAuthTag(tag)\n  return Buffer.concat([decipher.update(data), decipher.final()])\n}\n\nconst mimeForExt = (ext) => ({\n  jpg: 'image/jpeg', jpeg: 'image/jpeg', png: 'image/png', webp: 'image/webp', gif: 'image/gif',\n  avif: 'image/avif', heic: 'image/heic', bmp: 'image/bmp', tif: 'image/tiff', tiff: 'image/tiff',\n}[ext] || 'application/octet-stream')\n\n// jsDelivr can answer 404 or a hiccup for a few seconds after a brand-new commit (a guest's photo, viewed by someone else seconds later):\n// retry a little, then ask GitHub itself for the very same pinned file (the shards are public; raw is not rate-limited and has no negative\n// cache for a commit that exists). This is only the LAST resort of the viewing proxy: nothing in the upload path touches raw.\nconst jsdelivrToRaw = (url) => { const m = /^https:\\/\\/cdn\\.jsdelivr\\.net\\/gh\\/([^/]+)\\/([^@/]+)@([0-9a-f]{40})\\/(.+)$/.exec(url); return m ? `https://raw.githubusercontent.com/${m[1]}/${m[2]}/${m[3]}/${m[4]}` \nasync function fetchCdn(url, tries = 3) {\n  let last = null\n  for (let i = 0; i < tries; i++) {\n    try { last = await fetch(url); if (last.ok) return last } catch { last = null }\n    if (i < tries - 1) await new Promise((r) => setTimeout(r, 600 * (i + 1)))\n  }\n  const raw = jsdelivrToRaw(url)\n  if (raw) { try { const r = await fetch(raw); if (r.ok) return r } catch { /* keep the jsDelivr answer */ } }\n  return last || new Response('', { status: 502 })\n}\n\nexport default async function handler(req, res