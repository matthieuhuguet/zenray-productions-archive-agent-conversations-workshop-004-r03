uestUpload, importMediaKey } from './guestUploadCore.js'\nimport { makeFakeGitHub } from './testing/fakeGithub.js'\nimport { GhError } from './githubGraphql.js'\nimport { GUEST } from '../src/config/guestUpload.js'\nimport { packFrame, unpackFrame } from '../src/lib/guestFrame.js'\n\nconst ROOT = 'pages/Photos/Mariage'\nconst TOKEN = 'zrs1.token-for-tests'\nconst KEYRAW = crypto.getRandomValues(new Uint8Array(32))\nconst SECRET = 'receipt-secret'\nconst jpeg = (n, seed = 1) => { const u = new Uint8Array(n); for (let i = 0; i < n; i++) u[i] = (i * 31 + seed) & 255; u.set([0xff, 0xd8, 0xff, 0xe0, 0, 16, 0x4a, 0x46, 0x49, 0x46, 0, 1], 0); return u }\nconst webpThumb = (seed = 9) => { const u = new Uint8Array(300); u.fill(seed); u.set([0x52, 0x49, 0x46, 0x46, 1, 2, 3, 4, 0x57, 0x45, 0x42, 0x50], 0); return u }\nconst sha256Hex = async (u8) => Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256', u8)), (b) => b.toString(16).padStart(2, '0')).join('')\nconst decryptWith = async (cipher, ivB64) => new Uint8Array(await crypto.subtle.decrypt({ name: 'AES-GCM', iv: Uint8Array.from(atob(ivB64), (c) => c.charCodeAt(0)) }, await crypto.subtle.importKey('raw', KEYRAW, 'AES-GCM', false, ['decrypt']), cipher))\n\nlet gh, key\nconst base = () => ({ gh, key, secret: SECRET, resolveShare: async (t) => (t === TOKEN ? { kind: 'folder', path: ROOT } : Promise.reject(new Error('invalid-share'))), sleep: async () => {} })\nbeforeEach(async () => { gh = makeFakeGitHub(); key = await importMediaKey(btoa(String.fromCharCode(...KEYRAW))) })\n\n// Build a request exactly like the browser does, then run it through the real frame code.\nasync function send({ name = 'Marie', sub = '', op = 'put', photos = [], shard = null, token = TOKEN, extra = {} } = {}) {\n  const payloads = []; const parts = []\n  for (const ph of photos) for (const pt of ph.parts || []) { parts.push({ pid: ph.pid, role: pt.role, idx: pt.idx || 0, len: pt.bytes.length }); payloads.push(pt.bytes) }\n  const head = { v