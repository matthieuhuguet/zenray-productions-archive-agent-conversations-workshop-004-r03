String().slice(0, 10)}.json`).text).n).toBe(1)\n    expect(JSON.parse(gh.file('zenray-data', `${GUEST.STATE_DIR}/shard.json`).text).repo).toBe(r.shard)\n  })\n\n  it('rejouer la MÊME requête ne crée rien de plus (idempotent)', async () => {\n    const ph = await onePhoto('IMG_0001.JPG', jpeg(4000))\n    await send({ photos: [ph] })\n    const commits = gh.stats.commits\n    const again = await send({ photos: [ph] })\n    expect(again.results[0].status).toBe('exists')\n    expect(gh.stats.commits).toBe(commits)\n  })\n\n  it('réponse perdue APRÈS le commit : le renvoi rend « exists », jamais un doublon', async () => {\n    const ph = await onePhoto('IMG_0002.JPG', jpeg(4000, 3))\n    gh.faults.commit = [null, 'lose']                      // shard commit ok, drive commit applied but its reply is lost\n    const first = await send({ photos: [ph] })\n    expect(first.ok).toBe(false); expect(first.retry).toBe(true)\n    const second = await send({ photos: [ph] })\n    expect(second.results[0].status).toBe('exists')\n    expect(gh.listPaths('zenray-data', `${ROOT}/Marie/`).filter((p) => p.endsWith('.img.json'))).toHaveLength(1)\n  })\n\n  it('un nom de fichier déjà pris par une AUTRE photo reçoit un suffixe d’empreinte, sans rien écraser', async () => {\n    const a = await onePhoto('IMG_0001.JPG', jpeg(4000, 1))\n    const b = await onePhoto('IMG_0001.JPG', jpeg(4000, 2)); b.pid = 'p-second'\n    await send({ photos: [a] })\n    const r = await send({ photos: [b] })\n    expect(r.results[0].status).toBe('added')\n    expect(r.results[0].path).toBe(`${ROOT}/Marie/IMG_0001-${b.hash.slice(0, 8)}.JPG.img.json`)\n    expect(JSON.parse(gh.file('zenray-data', `${ROOT}/Marie/IMG_0001.JPG.img.json`).text).contentHash).toBe(a.hash)   // first one untouched\n  })\n\n  it('deux photos au même nom dans UNE requête : la seconde est suffixée', async () => {\n    const a = await onePhoto('IMG_0001.JPG', jpeg(3000, 1)), b = await onePhoto('IMG_0001.JPG', jpeg(3000, 2)); b.pid = 'p-b'\n    const r = await send({ photos: [a, b] })\n    expect(r.results.map((x) => x.status)).toEqual(['added', 'added'])\n    expect(new Set(r.results.map((x) => x.path)).size).toBe(2)\n  })\n})\n\ndescribe('une grosse photo d’Anne, en plusieurs morceaux et plusieurs requêtes', () => {\n  async function big(nChunks) {\n    const chunks = Array.from({ length: nChunks }, (_, i) => jpeg(70_000 + i * 11, i + 5)); const all = new Uint8Array(chunks.reduce((n, c) => n + c.length, 0)); let o = 0; for (const c of chunks) { all.set(c, o); o += c.length }\n    return { chunks, all, hash: await sha256Hex(all) }\n  }\n  it('chaque morceau est chiffré à part (ivs[]), le manifeste n’est écrit qu’à la dernière requête', async () => {\n    const { chunks, all, hash } = await big(3)\n    const mk = (i, final, receipts) => ({ pid: 'p-big', name: 'DSC_9999.JPG', size: all.length, hash, nChunks: 3, finalize: final, receipts, parts: [{ role: 'chunk', idx: i, bytes: chunks[i] }, ...(i === 0 ? [{ role: 'thumb', bytes: webpThumb() }] : [])] })\n    const r0 = await send({ name: 'Anne', photos: [mk(0, false, [])] })\n    expect(r0.results[0].status).toBe('part'); expect(gh.listPaths('zenray-data', `${ROOT}/Anne/`)).toEqual([])\n    const r1 = await send({ name: 'Anne', shard: r0.shard, photos: [mk(1, false, r0.results[0].receipts)] })\n    const r2 = await send({ name: 'Anne', shard: r0.shard, photos: [mk(2, true, [...r0.results[0].receipts, ...r1.results[0].receipts])] })\n    expect(r2.results[0].status).toBe('added')\n    const m = JSON.parse(gh.file('zenray-data', `${ROOT}/Anne/DSC_9999.JPG.img.json`).text)\n    expect(m.cdnChunks).toHaveLength(3); expect(m.ivs).toHaveLength(3); expect(m.iv).toBe(m.ivs[0])\n    const plain = []\n    for (let i = 0; i < 3; i++) plain.push(await decryptWith(gh.file(r0.shard, m.cdnChunks[i]).bytes, m.ivs[i]))\n    expect(Array.from(plain.flatMap((p) => Array.from(p)))).toEqual(Array.from(all))\n  })\n\n  it('des reçus falsifiés ne produisent PAS de manifeste', async () => {\n    const { chunks, all, hash } = await big(2)\n    const mk = (i, final, receipts) => ({ pid: 'p-forged', name: 'X.JPG', size: all.length, hash, nChunks: 2, finalize: final, receipts, parts: [{ role: 'chunk', idx: i, bytes: chunks[i] }] })\n    const r0 = await send({ name: 'Anne', photos: [mk(0, false, [])] })\n    const forged = r0.results[0].receipts.map((x) => ({ ...x, path: 'ab/cd/not-mine.bin' }))\n    const r1 = await send({ name: 'Anne', shard: r0.shard, photos: [mk(1, true, forged)] })\n    expect(r1.results[0].status).toBe('incomplete')\n    expect(gh.listPaths('zenray-data', `${ROOT}/Anne/`).filter((p) => p.endsWith('.img.json'))).toEqual([])\n  })\n})\n\ndescribe('le dossier d’un invité et les limites', () => {\n  it('un dossier du propriétaire du même nom n’est jamais réutilisé : « Photos (invité) »', async () => {\n    await gh.commit('zenray-data', { expectedHeadOid: 'c0000', headline: 'owner', additions: [{ path: `${ROOT}/Photos/owner.img.json`, text: '{}' }] })\n    const r = await send({ name: 'Photos', photos: [await onePhoto('a.jpg', jpeg(3000))] })\n    expect(r.folder).toBe('Photos (invité)')\n    expect(gh.file('zenray-data', `${ROOT}/Photos (invité)/a.jpg.img.json`)).toBeTruthy()\n    expect(gh.file('zenray-data', `${ROOT}/Photos/a.jpg.img.json`)).toBeNull()\n  })\n\n  it('un dossier à soi : les sous-dossiers se créent (mkdir) et reçoivent les photos', async () => {\n    const mk = await send({ name: 'Marie', sub: 'Soirée/Danse', op: 'mkdir' })\n    expect(mk.ok).toBe(true)\n    expect(gh.file('zenray-data', `${ROOT}/Marie/Soirée/Danse/${GUEST.FOLDER_MARKER}`)).toBeTruthy()\n    const r = await send({ name: 'Marie', sub: 'Soirée/Danse', photos: [await onePhoto('d.jpg', jpeg(3000))] })\n    expect(r.results[0].path).toBe(`${ROOT}/Marie/Soirée/Danse/d.jpg.img.json`)\n  })\n\n  it('un nom piégé reste dans le dossier partagé', async () => {\n    const r = await send({ name: '../../secret', photos: [await onePhoto('a.jpg', jpeg(3000))] })\n    expect(r.folder).toBe('secret')\n    expect(gh.listPaths('zenray-data').every((p) => p.startsWith(`${ROOT}/secret/`) || p.startsWith(GUEST.STATE_DIR))).toBe(true)\n  })\n\n  it('1024 photos par jour : au-delà, un arrêt poli avec l’heure de reprise', async () => {\n    const day = new Date().toISOString().slice(0, 10)\n    await gh.commit('zenray-data', { expectedHeadOid: 'c0000', headline: 'ledger', additions: [{ path: `${GUEST.STATE_DIR}/ledger/${day}.json`, text: JSON.stringify({ n: GUEST.DAILY_MAX }) }] })\n    const r = await send({ photos: [await onePhoto('a.jpg', jpeg(3000))] })\n    expect(r).toMatchObject({ ok: false, retry: false, reason: 'daily' }); expect(r.waitMs).toBeGreaterThan(0)\n  })\n\n  it('refuse ce qui n’est pas une image, ou dépasse 95 Mo', async () => {\n    const txt = new TextEncoder().encode('hello this is definitely not an image file at all')\n    const notImg = { pid: 'p-t', name: 'a.jpg', size: txt.length, hash: await sha256Hex(txt), nChunks: 1, parts: [{ role: 'chunk', idx: 0, bytes: txt }] }\n    const huge = { ...(await onePhoto('b.jpg', jpeg(3000))), pid: 'p-h', size: GUEST.MAX_PHOTO_BYTES + 1 }\n    const pdf = { ...(await onePhoto('c.pdf', jpeg(3000))), pid: 'p-p' }\n    const r = await send({ photos: [notImg, huge, pdf] })\n    expect(r.results.map((x) => `${x.status}:${x.reason}`).sort()).toEqual(['rejected:size', 'rejected:type', 'rejected:type'])\n    expect(gh.listPaths('zenray-data', ROOT)).toEqual([])\n  })\n\n  it('un lien invalide ou révoqué : arrêt poli, rien d’écrit', async () => {\n    const r = await send({ token: 'zrs1.other', photos: [await onePhoto('a.jpg', jpeg(3000))] })\n    expect(r).toMatchObject({ ok: false, retry: false, reason: 'invalid-link' }); expect(gh.stats.commits).toBe(0)\n    const off = await processGuestUpload({ ...base(), resolveShare: async () => ({ kind: 'folder', path: ROOT, guestUpload: false }), header: { v: 1, d: TOKEN, name: 'M', photos: [], parts: [] }, payload: new Uint8Array(0