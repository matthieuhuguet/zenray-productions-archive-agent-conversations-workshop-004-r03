d: hashed encrypted images served by jsDelivr' }) })\n    } catch (e) { throw new GhError('down', String((e && e.message) || e)) }\n    if (res.status === 403 || res.status === 429) throw new GhError('rate', 'rate-limited', 60_000)\n    if (!res.ok) throw new GhError(res.status >= 500 ? 'down' : 'fatal', `create-shard-${res.status}`)\n    for (let i = 0; i < 20; i++) {\n      await sleep(1200)\n      try { const st = await read(name, []); if (st.oid) return name } catch (e) { if (e instanceof GhError && e.kind === 'fatal') { /* repository not visible yet */ } }\n    }\n    throw new GhError('down', 'shard-not-ready')\n  }\n\n  return Object.assign(gh, { gql, read, commit, readText, createShard, dataRepo: full(dataRepo), owner })\n}\nEOF\ncat > server/githubGraphql.test.js <<'EOF'\n// @vitest-environment node\nimport { describe, expect, it, vi } from 'vitest'\nimport { makeGitHub, GhError } from './githubGraphql.js'\n\nconst res = (body, status = 200, headers = {}) => new Response(typeof body === 'string' ? body : JSON.stringify(body), { status, headers })\nconst make = (fetchImpl, extra = {}) => makeGitHub({ token: 't', fetchImpl, sleep: async () => {}, ...extra })\n\ndescribe('githubGraphql.read', () => {\n  it('rend la tête, la taille et un item par chemin (blob, arbre, absent)', async () => {\n    const fetchImpl = vi.fn(async () => res({ data: { repository: { diskUsage: 12, ref: { target: { oid: 'abc' } }, a0: { __typename: 'Blob', text: '{\"x\":1}', byteSize: 7, isBinary: false }, a1: { __typename: 'Tree', oid: 'tt' }, a2: null } } }))\n    const gh = make(fetchImpl)\n    const r = await gh.read('zenray-data', ['a.json', 'dir', 'none'])\n    expect(r.oid).toBe('abc'); expect(r.diskUsageKb).toBe(12)\n    expect(r.items.map((i) => i.kind)).toEqual(['blob', 'tree', null]); expect(r.items[0].text).toBe('{\"x\":1}')\n    const body = JSON.parse(fetchImpl.mock.calls[0][1].body)\n    expect(body.variables.e0).toBe('main:a.json')       // paths travel as VARIABLES, nev