 oy=(-OFFSET if dd=='top'  else OFFSET if dd=='bottom' else 0)","+                px=ox*(1-tp); py=oy*(1-tp)","+            x0=it['x0']+px","+            draw_right(img,str(it['n']),x0+NUM_W-30,it['ty']+py,    f_num,  GRAY, a)","+            draw_left (img,it['title'], x0+NUM_W,   it['ty']+py,    f_title,WHITE,a)","+            draw_left (img,it['src'],   x0+NUM_W,   it['ty']+50+py, f_src,  GRAY, a)","         img.save(f\"{SEGDIR}/f_{frame:04d}.png\")"," ","-    subprocess.run([","-        \"ffmpeg\",\"-y\",\"-r\",str(FPS),\"-i\",f\"{SEGDIR}/f_%04d.png\",","-        \"-c:v\",\"prores_ks\",\"-profile:v\",\"4444\",\"-pix_fmt\",\"yuva444p10le\", OUT_FILE","-    ], check=True, capture_output=True)","+    subprocess.run([\"ffmpeg\",\"-y\",\"-r\",str(FPS),\"-i\",f\"{SEGDIR}/f_%04d.png\",","+        \"-c:v\",\"prores_ks\",\"-profile:v\",\"4444\",\"-pix_fmt\",\"yuva444p10le\",OUT_FILE],","+        check=True,capture_output=True)","     print(f\"-> {OUT_FILE}  ({TOTAL/FPS:.2f}s)\")"," ","-if __name__ == \"__main__\":","+if __name__==\"__main__\":","     main()"]}],"originalFile":"#!/usr/bin/env python3\n\"\"\"\n\"Music Credits\" 4K transparent (ProRes 4444 alpha), 8 s.\n20 entrees (titre blanc Sans Medium + source verte Serif dessous) en 2 colonnes\nx 10 lignes. Chaque entree s'assemble depuis une direction aleatoire\n(gauche/haut/droite/bas), tres rapide, ~2.5/s. Header \"Music Credits\" vert italique.\n\"\"\"\nfrom PIL import Image, ImageDraw, ImageFont, ImageFilter\nimport os, subprocess, random\n\nOUT_FILE = \"/Users/zenray/Downloads/DJI/22 Juin 2026/Videos/Montage/Music Credits.mov\"\nSEGDIR   = \"/tmp/music_credits\"\nW, H = 3840, 2160\nFPS  = 24\nDUR_S = 8.0\nTOTAL = int(FPS * DUR_S)            # 192 frames\n\nFONT_SANS_MED = \"/Users/zenray/Library/Fonts/AnthropicSans-Medium.ttf\"\nFONT_SERIF    = \"/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\"\nFONT_ITALIC   = \"/Users/zenray/Library/Fonts/AnthropicSerif-Italic.ttf\"\n\nWHITE = (255, 255, 255)\nGREEN = (99, 214, 96)              # #63d660\n\nSHADOW_R = 10\nT_TITLE = 46\nT_SRC   = 34\nT_HEAD  = 78\n\n# (titre, source)\nENTRIES = [\n    (\"A World of Contradictions\",      \"Yugo Kanno · Psycho-Pass\"),\n    (\"A Journey (A Dream of Flight)\",  \"Joe Hisaishi · The Wind Rises\"),\n    (\"Nahoko (An Unexpected Meeting)\", \"Joe Hisaishi · The Wind Rises\"),\n    (\"A Shooting Star\",                \"Joe Hisaishi · The Wind Rises\"),\n    (\"slow summer eve\",                \"Kensuke Ushio · Chainsaw Man\"),\n    (\"Reze\",                           \"Kensuke Ushio · Chainsaw Man\"),\n    (\"Sal Blossoms\",                   \"Kensuke Ushio · The Heike Story\"),\n    (\"The Beginning\",                  \"Kensuke Ushio · The Heike Story\"),\n    (\"Adonis and Amara\",               \"Ludwig Göransson · Creed II\"),\n    (\"Under Water\",                    \"Ludwig Göransson · Creed II\"),\n    (\"I Will Go To War\",               \"Ludwig Göransson · Creed II\"),\n    (\"Ice Cold\",                       \"Ludwig Göransson · Creed II\"),\n    (\"Significance (Nothing)\",         \"Keiichi Okabe · NieR:Automata\"),\n    (\"Forest Kingdom\",                 \"Keigo Hoashi · NieR:Automata\"),\n    (\"Rebirth & Hope\",                 \"Keigo Hoashi · NieR:Automata\"),\n    (\"Fortress of Lies\",               \"Keiichi Okabe · NieR:Automata\"),\n    (\"The Tower\",                      \"Keiichi Okabe · NieR:Automata\"),\n    (\"Atsu's Theme\",                   \"Toma Otowa · Ghost of Yōtei\"),\n    (\"CRISIS CORE Theme - Succession\", \"Takeharu Ishimoto · Crisis Core FF7\"),\n    (\"Gray Heron III\",                 \"Joe Hisaishi · The Boy and the Heron\"),\n]\n\nrandom.seed(7)\n\n_fc = {}\ndef gf(path, sz):\n    k = (path, sz)\n    if k not in _fc:\n        _fc[k] = ImageFont.truetype(path, sz)\n    return _fc[k]\n\ndef ease_out_quint(t):\n    t = max(0.0, min(1.0, t)); return 1 - (1 - t) ** 5\ndef smoothstep(t):\n    t = max(0.0, min(1.0, t)); return t * t * (3 - 2 * t)\n\ndef draw_center(canvas, text, cx, baseline, font, color, alpha):\n    \"\"\"Texte centre horizontalement sur cx, baseline=y (anchor ls).\"\"\"\n    if alpha <= 0 or not text.strip():\n        return\n    w = font.getlength(text)\n    x = cx - w / 2\n    bb = font.getbbox(text, anchor=\"ls\")\n    pad = SHADOW_R * 2 + 4\n    lw = int(bb[2]-bb[0]) + pad*2\n    lh = int(bb[3]-bb[1]) + pad*2\n    lx = pad - bb[0]; ly = pad - bb[1]\n    shd = Image.new(\"RGBA\", (lw, lh), (0,0,0,0))\n    ImageDraw.Draw(shd).text((lx, ly), text, font=font, fill=(0,0,0,alpha), anchor=\"ls\")\n    shd = shd.filter(ImageFilter.GaussianBlur(SHADOW_R))\n    txt = Image.new(\"RGBA\", (lw, lh), (0,0,0,0))\n    ImageDraw.Draw(txt).text((lx, ly), text, font=font, fill=(*color, alpha), anchor=\"ls\")\n    comb = Image.alpha_composite(shd, txt)\n    dx = int(x + bb[0] - pad); dy = int(baseline + bb[1] - pad)\n    cx2, cy2 = max(0, dx), max(0, dy)\n    cr = comb.crop((cx2-dx, cy2-dy, min(comb.width, W-dx), min(comb.height, H-dy)))\n    if cr.width > 0 and cr.height > 0:\n        canvas.alpha_composite(cr, (cx2, cy2))\n\n# ── Layout : header + 2 colonnes x 10 lignes ──\nCOLS = 2; ROWS = 10\ncol_cx = [W*0.27, W*0.73]\nhead_y = 300\ntop_y  = 560\nrow_h  = 152\n\nDIRS = ['left', 'right', 'top', 'bottom']\nitems = []\nfor i, (title, src) in enumerate(ENTRIES):\n    col = i // ROWS\n    row = i % ROWS\n    cx  = col_cx[col]\n    ty  = top_y + row * row_h          # baseline titre\n    sy  = ty + 50                      # baseline source\n    items.append({'title': title, 'src': src, 'cx': cx, 'ty': ty, 'sy': sy,\n                  'dir': random.choice(DIRS)})\n\n# Timing : ~2.5 entrees / s. start espace de STEP frames, anim courte.\nSTEP   = 7\nANIM_F = 6\nOFFSET = 260\n\ndef main():\n    os.makedirs(SEGDIR, exist_ok=True)\n    for f in os.listdir(SEGDIR): os.remove(f\"{SEGDIR}/{f}\")\n\n    f_title = gf(FONT_SANS_MED, T_TITLE)\n    f_src   = gf(FONT_SERIF, T_SRC)\n    f_head  = gf(FONT_ITALIC, T_HEAD)\n\n    for frame in range(TOTAL):\n        img = Image.new(\"RGBA\", (W, H), (0,0,0,0))\n        # header (apparait en premier)\n        he = frame\n        if he >= 0:\n            ha = int(255 * smoothstep(min(he/ANIM_F, 1.0)))\n            draw_center(img, \"Music Credits\", W/2, head_y, f_head, GREEN, ha)\n        # entrees\n        for i, it in enumerate(items):\n            start = ANIM_F + 2 + i * STEP\n            e = frame - start\n            if e < 0:\n                continue\n            if e >= ANIM_F:\n                px = py = 0; a = 255\n            else:\n                raw = e / ANIM_F\n                tp = ease_out_quint(raw); a = int(255 * smoothstep(raw))\n                d = it['dir']\n                ox = (-OFFSET if d=='left' else OFFSET if d=='right' else 0)\n                oy = (-OFFSET if d=='top'  else OFFSET if d=='bottom' else 0)\n                px = ox*(1-tp); py = oy*(1-tp)\n            draw_center(img, it['title'], it['cx']+px, it['ty']+py, f_title, WHITE, a)\n            draw_center(img, it['src'],   it['cx']+px, it['sy']+py, f_src,   GREEN, a)\n        img.save(f\"{SEGDIR}/f_{frame:04d}.png\")\n\n    subprocess.run([\n        \"ffmpeg\",\"-y\",\"-r\",str(FPS),\"-i\",f\"{SEGDIR}/f_%04d.png\",\n        \"-c:v\",\"prores_ks\",\"-profile:v\",\"4444\",\"-pix_fmt\",\"yuva444p10le\", OUT_FILE\n    ], check=True, capture_output=True)\n    print(f\"-> {OUT_FILE}  ({TOTAL/FPS:.2f}s)\")\n\nif __name__ == \"__main__\":\n    main()\n","userModified":false},"sourceToolAssistantUUID":"b877e960-fb52-458b-8be8-5df04a50112a","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"290d8314-6c8c-472b-b948-bbbfc1e9bcca","version":"2.1.181","gitBranch":"main"}
