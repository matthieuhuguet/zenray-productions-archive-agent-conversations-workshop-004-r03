om.seed(7)\n\nENTRIES = [\n    (\"A World of Contradictions\",      \"Yugo Kanno · Psycho-Pass\"),\n    (\"A Journey (A Dream of Flight)\",  \"Joe Hisaishi · The Wind Rises\"),\n    (\"Nahoko (An Unexpected Meeting)\", \"Joe Hisaishi · The Wind Rises\"),\n    (\"A Shooting Star\",                \"Joe Hisaishi · The Wind Rises\"),\n    (\"slow summer eve\",                \"Kensuke Ushio · Chainsaw Man\"),\n    (\"Reze\",                           \"Kensuke Ushio · Chainsaw Man\"),\n    (\"Sal Blossoms\",                   \"Kensuke Ushio · The Heike Story\"),\n    (\"The Beginning\",                  \"Kensuke Ushio · The Heike Story\"),\n    (\"Adonis and Amara\",               \"Ludwig Göransson · Creed II\"),\n    (\"Under Water\",                    \"Ludwig Göransson · Creed II\"),\n    (\"I Will Go To War\",               \"Ludwig Göransson · Creed II\"),\n    (\"Ice Cold\",                       \"Ludwig Göransson · Creed II\"),\n    (\"Significance (Nothing)\",         \"Keiichi Okabe · NieR:Automata\"),\n    (\"Forest Kingdom\",                 \"Keigo Hoashi · NieR:Automata\"),\n    (\"Rebirth & Hope\",                 \"Keigo Hoashi · NieR:Automata\"),\n    (\"Fortress of Lies\",               \"Keiichi Okabe · NieR:Automata\"),\n    (\"The Tower\",                      \"Keiichi Okabe · NieR:Automata\"),\n    (\"Atsu's Theme\",                   \"Toma Otowa · Ghost of Yōtei\"),\n    (\"CRISIS CORE Theme - Succession\", \"Takeharu Ishimoto · Crisis Core FF7\"),\n    (\"Gray Heron III\",                 \"Joe Hisaishi · The Boy and the Heron\"),\n]\n\n_fc = {}\ndef gf(p, s):\n    k=(p,s)\n    if k not in _fc: _fc[k]=ImageFont.truetype(p,s)\n    return _fc[k]\n\ndef ease_out_quint(t):\n    t=max(0.0,min(1.0,t)); return 1-(1-t)**5\ndef smoothstep(t):\n    t=max(0.0,min(1.0,t)); return t*t*(3-2*t)\n\ndef draw_left(canvas, text, x, baseline, font, color, alpha):\n    if alpha<=0 or not text.strip(): return\n    bb=font.getbbox(text, anchor=\"ls\")\n    pad=SHADOW_R*2+4\n    lw=int(bb[2]-bb[0])+pad*2; lh=int(bb[3]-bb[1])+pad*2\n    lx=pad-bb[0]; ly=pad-bb[1]\n    shd=Image.new(\"RGBA\",(lw,lh),(0,0,0,0))\n    ImageDraw.Draw(shd).text((lx,ly),text,font=font,fill=(0,0,0,int(alpha*0.7)),anchor=\"ls\")\n    shd=shd.filter(ImageFilter.GaussianBlur(SHADOW_R))\n    txt=Image.new(\"RGBA\",(lw,lh),(0,0,0,0))\n    ImageDraw.Draw(txt).text((lx,ly),text,font=font,fill=(*color,alpha),anchor=\"ls\")\n    comb=Image.alpha_composite(shd,txt)\n    dx=int(x+bb[0]-pad); dy=int(baseline+bb[1]-pad)\n    cx,cy=max(0,dx),max(0,dy)\n    cr=comb.crop((cx-dx,cy-dy,min(comb.width,W-dx),min(comb.height,H-dy)))\n    if cr.width>0 and cr.height>0: canvas.alpha_composite(cr,(cx,cy))\n\ndef draw_right(canvas, text, xright, baseline, font, color, alpha):\n    draw_left(canvas, text, xright-font.getlength(text), baseline, font, color, alpha)\n\n# ── Layout type Spotify : 2 colonnes ──\nROWS=10\nCOL_X=[360, 2060]          # bord gauche de chaque colonne (zone numero)\nNUM_W=90                   # largeur reservee au numero\nHEAD_Y=300\nCOLHEAD_Y=470\nTOP_Y=600\nROW_H=150\n\nDIRS=['left','right','top','bottom']\nitems=[]\nfor i,(title,src) in enumerate(ENTRIES):\n    col=i//ROWS; row=i%ROWS\n    x0=COL_X[col]\n    ty=TOP_Y+row*ROW_H\n    items.append({'n':i+1,'title':title,'src':src,'x0':x0,'ty':ty,\n                  'dir':random.choice(DIRS)})\n\nSTEP=7; ANIM_F=6; OFFSET=240\n\ndef main():\n    os.makedirs(SEGDIR,exist_ok=True)\n    for f in os.listdir(SEGDIR): os.remove(f\"{SEGDIR}/{f}\")\n    f_head =gf(SANS_BOLD,96)\n    f_ch   =gf(SANS_REG,30)\n    f_num  =gf(SANS_REG,38)\n    f_title=gf(SANS_MED,46)\n    f_src  =gf(SANS_REG,33)\n\n    for frame in range(TOTAL):\n        img=Image.new(\"RGBA\",(W,H),(0,0,0,0))\n        d=ImageDraw.Draw(img)\n        he=frame\n        ha=int(255*smoothstep(min(he/ANIM_F,1.0))) if he>=0 else 0\n        # header vert + entetes de colonne gris + lignes fines grises\n        draw_left(img,\"Music Credits\",COL_X[0],HEAD_Y,f_head,GREEN,ha)\n        for cx in COL_X:\n            draw_left(img,\"#\",cx,COLHEAD_Y,f_ch,GRAY,int(ha*0.8))\n            draw_left(img,\"Title\",cx+NUM_W,COLHEAD_Y,f_ch,GRAY,int(ha*0.8))\n            ly=COLHEAD_Y+26\n            d.line([(cx,ly),(cx+1480,ly)],fill=(167,167,167,int(ha*0.35)),width=2)\n        # entrees\n        for it in items:\n            start=ANIM_F+2+(it['n']-1)*STEP\n            e=frame-start\n            if e<0: continue\n            if e>=ANIM_F: px=py=0; a=255\n            else:\n                raw=e/ANIM_F; tp=ease_out_quint(raw); a=int(255*smoothstep(raw))\n                dd=it['dir']\n                ox=(-OFFSET if dd=='left' else OFFSET if dd=='right' else 0)\n                oy=(-OFFSET if dd=='top'  else OFFSET if dd=='bottom' else 0)\n                px=ox*(1-tp); py=oy*(1-tp)\n            x0=it['x0']+px\n            draw_right(img,str(it['n']),x0+NUM_W-30,it['ty']+py,    f_num,  GRAY, a)\n            draw_left (img,it['title'], x0+NUM_W,   it['ty']+py,    f_title,WHITE,a)\n            draw_left (img,it['src'],   x0+NUM_W,   it['ty']+50+py, f_src,  GRAY, a)\n        img.save(f\"{SEGDIR}/f_{frame:04d}.png\")\n\n    subprocess.run([\"ffmpeg\",\"-y\",\"-r\",str(FPS),\"-i\",f\"{SEGDIR}/f_%04d.png\",\n        \"-c:v\",\"prores_ks\",\"-profile:v\",\"4444\",\"-pix_fmt\",\"yuva444p10le\",OUT_FILE],\n        check=True,capture_output=True)\n    print(f\"-> {OUT_FILE}  ({TOTAL/FPS:.2f}s)\")\n\nif __name__==\"__main__\":\n    main()\n","structuredPatch":[{"oldStart":7,"oldLines":8,"newStart":7,"newLines":10,"lines":[" Chaque entree s'assemble depuis une direction aleatoire, ~2.5/s, tres rapide."," \"\"\""," from PIL import Image, ImageDraw, ImageFont, ImageFilter","-import os, subprocess, random","+import os, subprocess, random, json"," ","+TIMELINE = json.load(open(os.path.join(os.path.dirname(__file__), \"loop_timeline.json\")))","+"," OUT_FILE = \"/Users/zenray/Downloads/DJI/22 Juin 2026/Videos/Montage/Music Credits.mov\""," SEGDIR   =