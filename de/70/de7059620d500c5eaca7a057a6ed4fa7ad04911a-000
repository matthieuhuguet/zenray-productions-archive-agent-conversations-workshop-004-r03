pplique a toutes les dimensions/polices.\nSCALE = 2\nBASE_OUT = \"/Users/zenray/Downloads/DJI/16 Juin 2026/BestOf/Videos/InterviewPablo/\"\nW, H  = 1920 * SCALE, 1080 * SCALE   # 3840 x 2160\nFPS   = 24\n\nFONT_REG = \"/Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf\"\nFONT_ITA = \"/Users/zenray/Library/Fonts/AnthropicSerif-Italic.ttf\"\nFONT_SANS_MED = \"/Users/zenray/Library/Fonts/AnthropicSans-Medium.ttf\"\n\nWHITE = (255, 255, 255)\nDIM   = (170, 170, 170)\n\nSHADOW_R   = 7  * SCALE\nOFFSET_IN  = 160 * SCALE\nOFFSET_OUT = 70 * SCALE\nWORD_GAP   = 20 * SCALE\nLINE_GAP   = 14 * SCALE\n\n\ndef ease_out_quint(t):\n    t = max(0.0, min(1.0, t))\n    return 1 - (1 - t) ** 5\n\ndef smoothstep(t):\n    t = max(0.0, min(1.0, t))\n    return t * t * (3 - 2 * t)\n\ndef smootherstep(t):\n    t = max(0.0, min(1.0, t))\n    return t * t * t * (t * (6 * t - 15) + 10)\n\n\ndef draw_word(canvas, text, x, y, font, color, alpha):\n    if alpha <= 0 or not text.strip():\n        return\n    bb = font.getbbox(text, anchor=\"ls\")\n    if bb[2] - bb[0] <= 0:\n        return\n    pad = SHADOW_R * 2 + 4\n    lw  = bb[2] - bb[0] + pad * 2\n    lh  = bb[3] - bb[1] + pad * 2\n    lx  = pad - bb[0]\n    ly  = pad - bb[1]\n\n    shd_img = Image.new(\"RGBA\", (lw, lh), (0, 0, 0, 0))\n    ImageDraw.Draw(shd_img).text((lx, ly), text, font=font,\n                                  fill=(0, 0, 0, alpha), anchor=\"ls\")\n    shd_img = shd_img.filter(ImageFilter.GaussianBlur(SHADOW_R))\n\n    txt_img = Image.new(\"RGBA\", (lw, lh), (0, 0, 0, 0))\n    r, g, b = color\n    ImageDraw.Draw(txt_img).text((lx, ly), text, font=font,\n                                  fill=(r, g, b, alpha), anchor=\"ls\")\n\n    combined = Image.alpha_composite(shd_img, txt_img)\n\n    dx = int(x + bb[0] - pad)\n    dy = int(y + bb[1] - pad)\n    cx2, cy2 = max(0, dx), max(0, dy)\n    cr = combined.crop((cx2 - dx, cy2 - dy,\n                        min(combined.width,  W - dx),\n                        min(combined.height, H - dy)))\n    if cr.width > 0 and cr.height > 0:\n        canvas.alpha_composite(cr, (cx2, cy2))\n\n\ndef generate(lines_spec, out_name, target_s, seed=1, anim_f=8, exit_f=7):\n    random.seed(seed)\n    OUT_DIR  = f\"/tmp/c4k_{seed}\"\n    OUT_FILE = BASE_OUT + out_name\n    TARGET   = int(FPS * target_s)\n\n    os.makedirs(OUT_DIR, exist_ok=True)\n    for f in os.listdir(OUT_DIR): os.remove(f\"{OUT_DIR}/{f}\")\n\n    fc = {}\n    def gf(fp, sz):\n        k = (fp, sz)\n        if k not in fc:\n            fc[k] = ImageFont.truetype(fp, sz)\n        return fc[k]\n\n    def line_h(line):\n        return max(gf(fp,sz).getmetrics()[0] + gf(fp,sz).getmetrics()[1]\n                   for _, fp, sz, _ in line)\n\n    lhs      = [line_h(l) for l in lines_spec]\n    total_h  = sum(lhs) + LINE_GAP * (len(lhs) - 1)\n    y_top    = (H - total_h) // 2\n\n    baselines = []\n    y = y_top\n    for i, line in enumerate(lines_spec):\n        ascent = max(gf(fp,sz).getmetrics()[0] for _,fp,sz,_ in line)\n        baselines.append(y + ascent)\n        y += lhs[i] + LINE_GAP\n\n    line_data = []\n    for li, line in enumerate(lines_spec):\n        bl = baselines[li]\n        words = []\n        for text, fp, sz, col in line:\n            f = gf(fp, sz)\n            words.append({'text': text, 'font': f, 'color': col,\n                          'adv': f.getlength(text)})\n        total_w = sum(w['adv'] for w in words) + WORD_GAP * (len(words) - 1)\n        x = (W - total_w) // 2\n        for w in words:\n            w['x'] = x\n            w['y'] = bl\n            x += w['adv'] + WORD_GAP\n        line_data.append(words)\n\n    flat = [w for line in line_data for w in line]\n    n    = len(flat)\n\n    WORD_DELAY = 1\n    LINE_PAUSE = 1\n    EXIT_DELAY = 1\n\n    line_starts = []\n    t = 0\n    for ws in line_data:\n        line_starts.append(t)\n        t += (len(ws) - 1) * WORD_DELAY + anim_f + LINE_PAUSE\n\n    last_li        = len(line_data) - 1\n    line_last_done = (line_starts[last_li]\n                      + (len(line_data[last_li]) - 1) * WORD_DELAY + anim_f)\n    exit_tail  = (n - 1) * EXIT_DELAY + exit_f\n    HOLD_F     = max(TARGET - line_last_done - exit_tail, 2)\n    all_done   = line_last_done + HOLD_F\n    TOTAL      = all_done + (n - 1) * EXIT_DELAY + exit_f\n\n    print(f\"  {out_name}: {TOTAL} frames = {TOTAL/FPS:.2f}s  hold={HOLD_F}f\")\n\n    DIRS = ['left', 'right', 'top']\n    dirs = [[random.choice(DIRS) for _ in ws] for ws in line_data]\n\n    for frame in range(TOTAL):\n        img  = Image.new(\"RGBA\", (W, H), (0, 0, 0, 0))\n        eidx = 0\n        for li, ws in enumerate(line_data):\n            ls = line_starts[li]\n            for wi, word in enumerate(ws):\n                fx, fy = word['x'], word['y']\n                e_in   = frame - (ls + wi * WORD_DELAY)\n                if e_in < 0:\n                    eidx += 1\n                    continue\n                if e_in >= anim_f:\n                    px, py = fx, fy\n                    alpha  = 255\n                else:\n                    raw   = e_in / anim_f\n                    t_pos = ease_out_quint(raw)\n                    t_alf = smoothstep(raw)\n                    d  = dirs[li][wi]\n                    ox = (-OFFSET_IN if d == 'left'\n                          else OFFSET_IN if d == 'right'\n                          else 0)\n                    oy = -OFFSET_IN if d == 'top' else 0\n                    px    = int(fx + ox * (1 - t_pos))\n                    py    = int(fy + oy * (1 - t_pos))\n                    alpha = int(255 * t_alf)\n                e_out = frame - (all_done + eidx * EXIT_DELAY)\n                dy    = 0\n                if e_out >= 0:\n                    t_out = smootherstep(min(e_out / exit_f, 1.0))\n                    alpha = int(255 * (1 - t_out))\n                    dy    = int(-OFFSET_OUT * smoothstep(min(e_out / exit_f, 1.0)))\n                draw_word(img, word['text'], px, py + dy,\n                          word['font'], word['color'], alpha)\n                eidx += 1\n        img.save(f\"{OUT_DIR}/frame_{frame:04d}.png\")\n\n    subprocess.run([\n        \"ffmpeg\", \"-y\", \"-r\", str(FPS),\n        \"-i\", f\"{OUT_DIR}/frame_%04d.png\",\n        \"-c:v\", \"prores_ks\", \"-profile:v\", \"4444\",\n        \"-pix_fmt\", \"yuva444p10le\", OUT_FILE\n    ], check=True, capture_output=True)\n    print(f\"  -> {OUT_FILE}\")\n\n\nS = SCALE\n# ═══════════════════════════════════════════════════════════════════\n# 1. Short Interview — 8s, titre \"AI in the process of creation.\"\ngenerate([\n    [(\"Short\", FONT_REG, 44*S, DIM),\n     (\"Interview\", FONT_REG, 44*S, DIM)],\n    [(\"AI\", FONT_REG, 64*S, WHITE),\n     (\"in\", FONT_REG, 64*S, WHITE),\n     (\"the\", FONT_REG, 64*S, WHITE),\n     (\"process\", FONT_REG, 64*S, WHITE),\n     (\"of\", FONT_REG, 64*S, WHITE),\n     (\"creation.\", FONT_ITA, 64*S, WHITE)],\n    [(\"Pablo\", FONT_REG, 60*S, WHITE)],\n    [(\"Matthieu\", FONT_REG, 60*S, WHITE)],\n], \"Credit Short Interview.mov\", target_s=8.0, seed=11, anim_f=8, exit_f=7)\n\n# ═══════════════════════════════════════════════════════════════════\n# 2. Realisation — 3s, \"Matthieu Huguet, Realisation\"\ngenerate([\n    [(\"Matthieu\",    FONT_REG, 72*S, WHITE),\n     (\"Huguet,\",     FONT_REG, 72*S, WHITE),\n     (\"Realisation\", FONT_REG, 72*S, WHITE)],\n], \"Credit Realisation.mov\", target_s=3.0, seed=5, anim_f=8, exit_f=7)\n","structuredPatch":[{"oldStart":192,"oldLines":16,"newStart":192,"newLines":17,"lines":[" # ═══════════════════════════════════════════════════════════════════"," # 1. Short Interview — 8s, titre \"AI in the process of creation.\""," generate([","-    [(\"Short\", FONT_REG, 44*S, DIM),","-     (\"Interview\", FONT_REG, 44*S, DIM)],","-    [(\"AI\", FONT_REG, 64*S, WHITE),","-     (\"in\", FONT_REG, 64*S, WHITE),","-     (\"the\", FONT_REG, 64*S, WHITE),","-     (\"process\", FONT_REG, 64*S, WHITE),","-     (\"of\", FONT_REG, 64*S, WHITE),","-     (\"creation.\", FONT_ITA, 64*S, WHITE)],","-    [(\"Pablo\", FONT_REG, 60*S, WHITE)],","-    [(\"Matthieu\", FONT_REG, 60*S, WHITE)],","+    [(\"Short\", FONT_ITA, 44*S, DIM),","+     (\"Interview\", FONT_ITA, 44*S, DIM)],","+    [(\"AI\", FONT_SANS_MED, 64*S, WHITE),","+     (\"in\", FONT_SANS_MED, 64*S, WHITE),","+     (\"the\", FONT_SANS_MED, 64*S, WHITE),","+     (\"process\", FONT_SANS_MED, 64*S, WHITE),","+     (\"of\", FONT_SANS_MED, 64*S, WHITE),","+     (\"creation.\", FONT_SANS_MED, 64*S, WHITE)],","+    [(\"Pablo\", FONT_REG, 60*S, WHITE),","+     (\"-\", FONT_REG, 60*S, WHITE),","+     (\"Matthieu\", FONT_REG, 60*S, WHITE)],"," ], \"Credit Short Interview.mov\", target_s=8.0, seed=11, anim_f=8, exit_f=7)"," "," # ═══════════════════════════════════════════════════════════════════"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"1bd92b5a-584c-4d62-8fb4-e90e5948c19b","userType":"external","entrypoint":"claude-desktop","cwd":"/Users/zenray/Create/Build/Memory","sessionId":"290d8314-6c8c-472b-b948-bbbfc1e9bcca","version":"2.1.177","gitBranch":"main"}
