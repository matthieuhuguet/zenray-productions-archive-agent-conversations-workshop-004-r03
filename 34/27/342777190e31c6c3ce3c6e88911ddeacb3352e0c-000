\" 2>/dev/null)\"\n  [[ -n \"$prog\" ]] || prog=\"$($PB -c 'Print :ProgramArguments:0' \"$f\" 2>/dev/null)\"\n  [[ -n \"$prog\" ]] || prog=\"$($PB -c 'Print :Program' \"$f\" 2>/dev/null)\"\n  iv=\"$($PB -c 'Print :StartInterval' \"$f\" 2>/dev/null)\"\n  freq=\"à la demande\"; [[ -n \"$iv\" ]] && freq=\"toutes les ${iv}s\"\n  ral=\"$($PB -c 'Print :RunAtLoad' \"$f\" 2>/dev/null)\"; [[ \"$ral\" == \"true\" ]] && freq=\"$freq · au login\"\n  IFS='|' read -r cls state <<<\"$(status_for \"$label\")\"\n  case \"$cls\" in active) ((n_active++));; sched) ((n_sched++));; error) ((n_err++));; idle) ((n_idle++));; esac\n  JOB_ROWS+=\"<tr><td><span class='dot $cls'></span>$(esc \"$state\")</td><td class='b'>$(esc \"$label\")</td><td>$(esc \"$freq\")</td><td class='mono'>$(esc \"$(short \"$prog\")\")</td></tr>\"\ndone\n\n# Scripts claude-sync : actifs (hors _deprecated) vs dépréciés\nSCRIPT_ROWS=\"\"\nif [[ -d \"$CS\" ]]; then\n  while IFS= read -r s; do\n    [[ -n \"$s\" ]] || continue\n    SCRIPT_ROWS+=\"<tr><td><span class='dot sched'></span>actif</td><td class='b'>$(esc \"$(basename \"$s\")\")</td><td>script</td><td class='mono'>$(esc \"$(short \"$s\")\")</td></tr>\"\n  done < <(find \"$CS\" -maxdepth 3 -name '*.sh' -not -path '*/_deprecated/*' -not -path '*/.git/*' 2>/dev/null | sort)\n  while IFS= read -r s; do\n    [[ -n \"$s\" ]] || continue\n    ((n_dep++))\n    SCRIPT_ROWS+=\"<tr><td><span class='dot dep'></span>déprécié</td><td class='b'>$(esc \"$(basename \"$s\")\")</td><td>archivé</td><td class='mono'>$(esc \"$(short \"$s\")\")</td></tr>\"\n  done < <(find \"$CS/_deprecated\" \\( -name '*.sh' -o -name '*.plist' \\) 2>/dev/null | sort)\nfi\n\ncat > \"$OUT\" <<HTML\n<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>ZenStatus</title>\n<style>\n:root{color-scheme:dark}\n*{box-sizing:border-box}\nbody{margin:0;background:#0b0b0c;color:#e8e8ea;font:14px/1.5 -apple-system,\"Anthr