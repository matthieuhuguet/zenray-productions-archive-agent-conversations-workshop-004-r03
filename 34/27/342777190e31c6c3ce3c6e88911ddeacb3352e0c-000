then badge=\"<span class='dot ok'></span>Tourne maintenant\"; ((n_ok++))\n    elif [[ \"$st\" == \"0\" ]]; then badge=\"<span class='dot ok'></span>Actif\"; ((n_ok++))\n    else badge=\"<span class='dot err'></span>En erreur\"; ((n_err++)); fi\n  fi\n  ROWS+=\"<tr><td class='st'>$badge</td><td class='b'>$(esc \"$title\")</td><td class='d'>$(esc \"$desc\")</td><td class='f'>$(esc \"$freq\")</td></tr>\"\ndone\n\nDEP=\"\"\nif [[ -d \"$CS/_deprecated\" ]]; then\n  for d in \"$CS\"/_deprecated/*/; do\n    [[ -d \"$d\" ]] || continue\n    name=\"$(basename \"$d\")\"; ((n_dep++))\n    IFS='|' read -r dt dd <<<\"$(describe_dep \"$name\")\"\n    DEP+=\"<tr><td class='st'><span class='dot dep'></span>Désactivé</td><td class='b'>$(esc \"$dt\")</td><td class='d'>$(esc \"$dd\")</td><td class='f'>—</td></tr>\"\n  done\nfi\n\ncat > \"$OUT\" <<HTML\n<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>ClaudeSync</title>\n<style>\n:root{--ink:#1a1714;--mut:#8c857d;--line:#ece8e2;--accent:#cc7c5e;\n  --sans:\"Anthropic Sans\",\"AnthropicSans\",-apple-system,sans-serif;\n  --serif:\"Anthropic Serif\",\"AnthropicSerif\",Georgia,serif}\n*{box-sizing:border-box}\nbody{margin:0;background:#fff;color:var(--ink);font:16px/1.6 var(--serif);padding:48px 44px;max-width:1080px}\nh1{font-family:var(--sans);font-size:30px;font-weight:800;letter-spacing:-.01em;margin:0 0 8px}\n.intro{font-family:var(--serif);color:#5a544d;font-size:16px;margin:0 0 6px;max-width:660px}\n.sub{font-family:var(--sans);color:var(--mut);font-size:12px;letter-spacing:.02em;margin-bottom:30px}\n.cards{display:flex;gap:14px;margin-bottom:34px}\n.card{border:1px solid var(--line);border-radius:14px;padding:16px 22px;min-width:128px}\n.card .n{font-family:var(--sans);font-size:30px;font-weight:800;line-height:1}\n.card .l{font-family:var(--sans);font-size:12px;color:var(--mut);margin-top:6px}\nh2{font-family:var(--sans);font-size:12px;color:var(--mut);font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin:34px 0 12px}\ntable{width:100%;border-collapse:collapse;border:1px solid var(--line);border-radius:14px;overflow:hidden}\ntd{padding:16px 18px;border-top:1px solid var(--line);vertical-align:top}\ntr:first-child td{border-top:0}\n.st{font-family:var(--sans);white-space:nowrap;font-weight:600;font-size:14px;width:180px;color:var(--ink)}\n.b{font-family:var(--sans);font-weight:700;width:210px}\n.d{font-family:var(--serif);color:#4f4942;max-width:520px}\n.f{font-family:var(--sans);color:var(--mut);white-space:nowrap;text-align:right;font-size:13px}\n.dot{display:inline-block;width:8px;height:8px;border-radius:50%;margin-right:10px;vertical-align:middle}\n.ok{background:var(--accent)}\n.err{background:var(--accent);box-shadow:0 0 0 3px rgba(204,124,94,.22)}\n.idle,.dep{background:#cfcabf}\n</style></head><body>\n<h1>ClaudeSync</h1>\n<p class=\"intro\">Les petits robots qui tournent tout seuls en fond sur ton Mac pour sauvegarder et synchroniser tes conversations Claude entre tes comptes. Voici ce que fait chacun et s'il va bien.</p>\n<div class=\"sub\">Vérifié le $now · se met à jour à chaque ouverture</div>\n<div class=\"cards\">\n<div class=\"card\"><div class=\"n\" style=\"color:#34d399\">$n_ok</div><div class=\"l\">qui marchent</div></div>\n<div class=\"card\"><div class=\"n\" style=\"color:#f87171\">$n_err</div><div class=\"l\">en panne</div></div>\n<div class=\"card\"><div class=\"n\" style=\"color:#fbbf24\">$n_dep</div><div class=\"l\">à la retraite</div></div>\n</div>\n<h2>Services en marche</h2>\n<table>${ROWS:-<tr><td colspan=4>aucun service trouvé</td></tr>}</table>\n<h2>Anciens services (désactivés, gardés en archive)</h2>\n<table>${DEP:-<tr><td colspan=4>aucun</td></tr>}</table>\n</body></html>\nHTML\n\nopen \"$OUT\"\n","structuredPatch":[{"oldStart":102,"oldLines":9,"newStart":102,"newLines":9,"lines":[" <p class=\"intro\">Les petits robots qui tournent tout seuls en fond 