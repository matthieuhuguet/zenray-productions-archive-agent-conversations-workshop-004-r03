 \"$p\" | tr -d ' ')\"\n  printf \"<details class='code'><summary>Voir le code source (%s lignes)</summary><pre>\" \"$n\"\n  sed 's/&/\\&amp;/g; s/</\\&lt;/g; s/>/\\&gt;/g' \"$p\"\n  printf \"</pre></details>\"\n}\n\n# Nom clair + explication + fréquence, par service. \"titre|explication|fréquence\"\ndescribe() {\n  case \"$1\" in\n    com.zenray.autoupdate)\n      echo \"Sauvegarde automatique|Dossiers ~/.claude + Memory → dépôts GitHub|Surveille les dossiers Claude et les envoie sur GitHub à chaque modification. Assure la remontée des sessions et de la mémoire.|En continu\" ;;\n    com.zenray.sessions-sync)\n      echo \"Synchronisation des comptes|Les comptes Claude entre eux (dossier claude-code-sessions)|Recopie les conversations entre les comptes Claude pour les rendre disponibles sur chacun.|Toutes les minutes\" ;;\n    com.zenray.conversations-backup)\n      echo \"Copie de secours|Conversations ~/.claude → dossier de sauvegarde claude-sync|Duplique les conversations Claude dans un dossier de sauvegarde dédié.|Toutes les minutes\" ;;\n    com.zenray.youtube-focus-guard.tabs)\n      echo \"Garde-fou YouTube|Onglets youtube.com du navigateur|Surveille les onglets du navigateur pour limiter l'usage de YouTube.|En continu\" ;;\n    *)\n      echo \"${1#com.zenray.}|—|Service qui tourne en fond.|—\" ;;\n  esac\n}\n\n# Explication des services désactivés (archives), par dossier\ndescribe_dep() {\n  case \"$1\" in\n    git-drive-sync)\n      echo \"Ancien envoi vers GitHub|Remplacé par « Sauvegarde automatique » le 11 juin 2026. Conservé en archive, inactif.\" ;;\n    sessions-sync)\n      echo \"Ancienne version de la synchronisation|Version réactivée depuis. Cette copie sert uniquement d'archive.\" ;;\n    *)\n      echo \"$1|Service archivé, inactif.\" ;;\n  esac\n}\n\nn_ok=0; n_err=0; n_dep=0\nROWS=\"\"\nfor f in \"$LA\"/com.zenray.*.plist; do\n  [[ -e \"$f\" ]] || continue\n  label=\"$($PB -c 'Print :Label' \"$f\" 2>/dev/null)\"; [[ -n \"$label\" ]] || label=\"$(basename \"$f\" .plist)\"\n  IFS='|' read -r title cible desc freq <<<\"$(describe \"$label\")\"\n  prog=\"$($PB -c 'Print :ProgramArguments:1' \"$f\" 2>/dev/null)\"\n  [[ -n \"$prog\" ]] || prog=\"$($PB -c 'Print :ProgramArguments:0' \"$f\" 2>/dev/null)\"\n  [[ -n \"$prog\" ]] || prog=\"$($PB -c 'Print :Program' \"$f\" 2>/dev/null)\"\n  fname=\"$(basename \"$prog\")\"\n\n  line=\"$(printf '%s\\n' \"$LL\" | awk -v l=\"$label\" '$3==l{print; exit}')\"\n  if [[ -z \"$line\" ]]; then\n    badge=\"<span class='dot idle'></span>Arrêté\"\n  else\n    pid=\"$(awk '{print $1}' <<<\"$line\")\"; st=\"$(awk '{print $2}' <<<\"$line\")\"\n    if [[ \"$pid\" != \"-\" && -n \"$pid\" ]]; then badge=\"<span class='dot ok'></span>En cours\"; ((n_ok++))\n    elif [[ \"$st\" == \"0\" ]]; then badge=\"<span class='dot ok'></span>Actif\"; ((n_ok++))\n    else badge=\"<span class='dot err'></span>En erreur\"; ((n_err++)); fi\n  fi\n  ROWS+=\"<tr><td class='st'>$badge</td><td class='b'>$(esc \"$title\")<div class='cible'><span class='arr'>agit sur</span> $(esc \"$cible\")</div></td><td class='d'>$(esc \"$desc\")<div class='tech'>Fichier <b>$(esc \"$fname\")</b> · $(esc \"$(short \"$prog\")\")</div>$(codeof \"$prog\")</td><td class='f'>$(esc \"$freq\")</td></tr>\"\ndone\n\nDEP=\"\"\nif [[ -d \"$CS/_deprecated\" ]]; then\n  for d in \"$CS\"/_deprecated/*/; do\n    [[ -d \"$d\" ]] || continue\n    name=\"$(basename \"$d\")\"; ((n_dep++))\n    IFS='|' read -r dt dd <<<\"$(describe_dep \"$name\")\"\n    depfile=\"$(find \"$d\" \\( -name '*.sh' -o -name '*.mjs' \\) 2>/dev/null | head -1)\"\n    [[ -n \"$depfile\" ]] && depline=\"<div class='tech'>Fichier <b>$(esc \"$(basename \"$depfile\")\")</b> · $(esc \"$(short \"$d\")\")</div>\" || depline=\"\"\n    DEP+=\"<tr><td class='st'><span class='dot dep'></span>Désactivé</td><td class='b'>$(esc \"$dt\")</td><td class='d'>$(esc \"$dd\")$depline$(codeof \"$depfile\")</td><td class='f'>—</td></tr>\"\n  done\nfi\n\ncat > \"$OUT\" <<HTML\n<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>ClaudeSync</title>\n<style>\n:root{--ink:#1a1714;--mut:#8c857d;--line:#ece8e2;--accent:#cc7c5e;\n  --sans:\"Anthropic Sans\",\"AnthropicSans\",-apple-system,sans-serif;\n  --serif:\"Anthropic Serif\",\"AnthropicSerif\",Georgia,serif}\n*{box-sizing:border-box}\nbody{margin:0;background:#fff;color:var(--ink);font:16px/1.6 var(--serif);padding:48px 44px;max-width:1080px}\nh1{font-family:var(--sans);font-size:30px;font-weight:500;letter-spacing:-.01em;margin:0 0 8px}\n.intro{font-family:var(--serif);color:#5a544d;font-size:16px;margin:0 0 6px;max-width:660px}\n.sub{font-family:var(--sans);color:var(--mut);font-size:12px;letter-spacing:.02em;margin-bottom:30px}\n.cards{display:flex;gap:14px;margin-bottom:34px}\n.card{border:1px solid var(--line);border-radius:14px;padding:16px 22px;min-width:128px}\n.card .n{font-family:var(--sans);font-size:30px;font-weight:500;line-height:1}\n.card .l{font-family:var(--sans);font-size:12px;color:var(--mut);margin-top:6px}\nh2{font-family:var(--sans);font-size:12px;color:var(--mut);font-weight:500;text-transform:uppercase;letter-spacing:.08em;margin:34px 0 12px}\ntable{width:100%;border-collapse:collapse;border:1px solid var(--line);border-radius:14px;overflow:hidden}\ntd{padding:16px 18px;border-top:1px solid var(--line);vertical-align:top}\ntr:first-child td{border-top:0}\n.st{font-family:var(--sans);white-space:nowrap;font-weight:500;font-size:14px;width:180px;color:var(--ink)}\n.b{font-family:var(--sans);font-weight:500;width:210px}\n.d{font-family:var(--serif);color:#4f4942;max-width:540px}\n.tech{font-family:\"Anthropic Mono\",\"AnthropicMono\",ui-monospace,Menlo,monospace;font-size:11.5px;color:#a59e95;margin-top:7px;letter-spacing:-.01em}\n.tech b{color:#7a736a;font-weight:500}\n.code{margin-top:10px}\n.code summary{font-family:var(--sans);font-size:12.5px;color:var(--accent);cursor:pointer;font-weig