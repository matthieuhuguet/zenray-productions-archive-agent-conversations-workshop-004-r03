 de bord clair de tes services qui tournent en fond.\n# Explique en français ce que fait chaque robot, son état, sa fréquence. Aucun jargon.\n# Source : claude-sync/claudesync/claudesync.sh (copie embarquée dans ClaudeSync.app).\n\nOUT=\"/tmp/claudesync.html\"\nLA=\"$HOME/Library/LaunchAgents\"\nCS=\"$HOME/Create/Build/Productions/GithubProductions/claude-sync\"\nPB=\"/usr/libexec/PlistBuddy\"\nnow=\"$(date '+%d/%m/%Y à %H:%M')\"\n\nLL=\"$(launchctl list 2>/dev/null)\"\nesc() { printf '%s' \"$1\" | sed 's/&/\\&amp;/g; s/</\\&lt;/g; s/>/\\&gt;/g'; }\n\n# Nom clair + explication + fréquence, par service. \"titre|explication|fréquence\"\ndescribe() {\n  case \"$1\" in\n    com.zenray.autoupdate)\n      echo \"Sauvegarde automatique|Surveille tes dossiers Claude et les envoie sur GitHub dès que quelque chose change. C'est lui qui fait remonter tes sessions et ta mémoire.|En continu\" ;;\n    com.zenray.sessions-sync)\n      echo \"Sync entre tes comptes|Recopie tes conversations entre tes 7 comptes Claude, pour que tu les retrouves sur n'importe lequel.|Toutes les minutes\" ;;\n    com.zenray.conversations-backup)\n      echo \"Copie de secours|Range une copie de tes conversations dans un dossier de sauvegarde, au cas où.|Toutes les minutes\" ;;\n    com.zenray.youtube-focus-guard.tabs)\n      echo \"Garde-fou YouTube|Surveille tes onglets pour t'éviter de te perdre sur YouTube et rester concentré.|En continu\" ;;\n    *)\n      echo \"${1#com.zenray.}|Service qui tourne en fond.|—\" ;;\n  esac\n}\n\n# Explication des services désactivés (archives), par dossier\ndescribe_dep() {\n  case \"$1\" in\n    git-drive-sync)\n      echo \"Ancien envoi vers GitHub|Remplacé par la « Sauvegarde automatique » le 11 juin 2026. Archivé, ne tourne plus.\" ;;\n    sessions-sync)\n      echo \"Ancienne version du sync comptes|Réactivée depuis. Cette copie est juste l'archive.\" ;;\n    *)\n      echo \"$1|Service archivé, ne tourne plus.\" ;;\n  esac\n}\n\nn_ok=0; n_err=0; n_dep=0\nROWS=\"\"\nfor f in \"$LA\"/com.zenray.*.plist; do\n  [[ -e \"$f\" ]] || continue\n  label=\"$($PB -c 'Print :Label' \"$f\" 2>/dev/null)\"; [[ -n \"$label\" ]] || label=\"$(basename \"$f\" .plist)\"\n  IFS='|' read -r title desc freq <<<\"$(describe \"$label\")\"\n\n  line=\"$(printf '%s\\n' \"$LL\" | awk -v l=\"$label\" '$3==l{print; exit}')\"\n  if [[ -z \"$line\" ]]; then\n    badge=\"<span class='dot idle'></span>Arrêté\"\n  else\n    pid=\"$(awk '{print $1}' <<<\"$line\")\"; st=\"$(awk '{print $2}' <<<\"$line\")\"\n    if [[ \"$pid\" != \"-\" && -n \"$pid\" ]]; then badge=\"<span class='dot ok'></span>Tourne maintenant\"; ((n_ok++))\n    elif [[ \"$st\" == \"0\" ]]; then badge=\"<span class='dot ok'></span>Actif\"; ((n_ok++))\n    else badge=\"<span class='dot err'></span>En erreur\"; ((n_err++)); fi\n  fi\n  ROWS+=\"<tr><td class='st'>$badge</td><td class='b'>$(esc \"$title\")</td><td class='d'>$(esc \"$desc\")</td><td class='f'>$(esc \"$freq\")</td></tr>\"\ndone\n\nDEP=\"\"\nif [[ -d \"$CS/_deprecated\" ]]; then\n  for d in \"$CS\"/_deprecated/*/; do\n    [[ -d \"$d\" ]] || continue\n    name=\"$(basename \"$d\")\"; ((n_dep++))\n    IFS='|' read -r dt dd <<<\"$(describe_dep \"$name\")\"\n    DEP+=\"<tr><td class='st'><span class='dot dep'></span>Désactivé</td><td class='b'>$(esc \"$dt\")</td><td class='d'>$(esc \"$dd\")</td><td class='f'>—</td></tr>\"\n  done\nfi\n\ncat > \"$OUT\" <<HTML\n<!doctype html><html lang=\"fr\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>ClaudeSync</title>\n<style>\n:root{color-scheme:dark}*{box-sizing:border-box}\nbody{margin:0;background:#0b0b0c;color:#e8e8ea;font:15px/1.55 -apple-system,\"AnthropicSans\",Inter,sans-serif;padding:34px 40px;max-width:1100px}\nh1{font-size:24px;font-weight:800;margin:0 0 4px}\n.intro{color:#a0a0a8;font-size:14px;margin:0 0 4px;max-width:680px}\n.sub{color:#6a6a72;font-size:12px;margin-bottom:24px}\n.cards{display:flex;gap:12px;margin-bottom:26px}\n.card{background:#151517;border:1px solid #232327;border-radius:12px;padding:14px 20px;min-width:120px}\n.card .n{font-size:26px;font-weight:800}.card .l{font-size:12px;color:#8a8a92}\nh2{font-size:13px;color:#9a9aa2;font-weight:600;text-transform:uppercase;letter-spacing:.05em;margin:26px 0 10px}\ntable{width:100%;border-collapse:collapse;background:#151517;border:1px solid #232327;border-radius:12px;overflow:hidden}\ntd{padding:14px 16px;border-top:1px solid #1e1e22;vertical-align:top}\ntr:first-child td{border-top:0}\n.st{white-space:nowrap;font-weight:600;width:170px}\n.b{font-weight:700;width:220px}\n.d{color:#c2c2c8}\n.f{color:#8a8a92;white-space:nowrap;text-align:right;font-size:13px}\n.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:9px;vertical-align:middle}\n.ok{background:#34d399}.err{background:#f87171}.idle{background:#5a5a62}.dep{background:#fbbf24}\n</style></head><body>\n<h1>ClaudeSync</h1>\n<p class=\"intro\">Les petits robots qui tournent tout seuls en fond sur ton Mac pour sauvegarder et synchroniser tes conversations Claude entre tes comptes. Voici ce que fait chacun et s'il va bien.</p>\n<div class=\"sub\">Vérifié le $now · se met à jour à chaque ouverture</div>\n<div class=\"cards\">\n<div class=\"card\"><div class=\"n\" style=\"color:#34d399\">$n_ok</div><div class=\"l\">qui marchent</div></div>\n<div class=\"card\"><div class=\"n\" style=\"color:#f87171\">$n_err</div><div class=\"l\">en panne</div></div>\n<div class=\"card\"><div class=\"n\" style=\"color:#fbbf24\">$n_dep</div><div class=\"l\">à la retraite</div></div>\n</div>\n<h2>Services en marche</h2>\n<table>${ROWS:-<tr><td colspan=4>aucun service trouvé</td></tr>}</table>\n<h2>Anciens services (désactivés, gardés en archive)</h2>\n<table>${DEP:-<tr><td colspan=4>aucun</td></tr>}</table>\n</body></html>\nHTML\n\nopen \"$OUT\"\n","structuredPatch":[{"oldStart":73,"oldLines":24,"newStart":73,"newLines":30,"lines":[" <!doctype html><html lang=\"fr\"><h