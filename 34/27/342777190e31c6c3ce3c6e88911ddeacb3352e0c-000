nshort() { printf '%s' \"$1\" | sed \"s#$HOME#~#\"; }\n# Dérouleur \"Voir le code\" : affiche le code source réel du script (lu sur le disque).\ncodeof() {\n  local p=\"$1\"; [[ -f \"$p\" ]] || return\n  local n; n=\"$(wc -l < \"$p\" | tr -d ' ')\"\n  printf \"<details class='code'><summary>Voir le code source (%s lignes)</summary><pre>\" \"$n\"\n  sed 's/&/\\&amp;/g; s/</\\&lt;/g; s/>/\\&gt;/g' \"$p\"\n  printf \"</pre></details>\"\n}\n\n# Nom clair + explication + fréquence, par service. \"titre|explication|fréquence\"\ndescribe() {\n  case \"$1\" in\n    com.zenray.autoupdate)\n      echo \"Sauvegarde automatique|Surveille les dossiers Claude et les envoie sur GitHub à chaque modification. Assure la remontée des sessions et de la mémoire.|En continu\" ;;\n    com.zenray.sessions-sync)\n      echo \"Synchronisation des comptes|Recopie les conversations entre les comptes Claude pour les rendre disponibles sur chacun.|Toutes les minutes\" ;;\n    com.zenray.conversations-backup)\n      echo \"Copie de secours|Duplique les conversations Claude dans un dossier de sauvegarde dédié.|Toutes les minutes\" ;;\n    com.zenray.youtube-focus-guard.tabs)\n      echo \"Garde-fou YouTube|Surveille les onglets du navigateur pour limiter l'usage de YouTube.|En continu\" ;;\n    *)\n      echo \"${1#com.zenray.}|Service qui tourne en fond.|—\" ;;\n  esac\n}\n\n# Explication des services désactivés (archives), par dossier\ndescribe_dep() {\n  case \"$1\" in\n    git-drive-sync)\n      echo \"Ancien envoi vers GitHub|Remplacé par « Sauvegarde automatique » le 11 juin 2026. Conservé en archive, inactif.\" ;;\n    sessions-sync)\n      echo \"Ancienne version de la synchronisation|Version réactivée depuis. Cette copie sert uniquement d'archive.\" ;;\n    *)\n      echo \"$1|Service archivé, inactif.\" ;;\n  esac\n}\n\nn_ok=0; n_err=0; n_dep=0\nROWS=\"\"\nfor f in \"$LA\"/com.zenray.*.plist; do\n  [[ -e \"$f\" ]] || continue\n  label=\"$($PB -c 'Print :Label' \"$f\" 2>/dev/null)\"; [[ -