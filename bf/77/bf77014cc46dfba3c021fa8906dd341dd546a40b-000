-dossier.\n\nUsage :\n    python3 instagram_maxq.py <dossier_source> [--max-mb 8] [--width 0]\n                              [--out instagram] [--jobs 16] [--keep-exif]\n\"\"\"","originalFile":"#!/usr/bin/env python3\n\"\"\"Convertit des photos pour Instagram en consommant le budget de poids autorise.\n\nPrincipe : Instagram impose deux plafonds, une largeur maximale acceptee (1440 px)\net un poids maximal par photo (8 Mo). L'algorithme redimensionne une seule fois en\nLanczos, puis cherche par bisection la qualite JPEG la plus haute qui tient sous le\nplafond de poids. Le sous-echantillonnage chroma est desactive (4:4:4), ce qui est le\nvrai levier de qualite sur les rouges et les details fins quand le budget est large.\n\nLes originaux ne sont jamais touches : la sortie va dans un sous-dossier.\n\nUsage :\n    python3 instagram_maxq.py <dossier_source> [--width 1440] [--max-mb 7.5]\n                              [--out instagram] [--jobs 16] [--keep-exif]\n\"\"\"\n\nimport argparse\nimport io\nimport sys\nfrom concurrent.futures import ProcessPoolExecutor\nfrom pathlib import Path\n\nfrom PIL import Image\n\nEXTENSIONS = {\".jpg\", \".jpeg\", \".png\", \".tif\", \".tiff\", \".webp\"}\nImage.MAX_IMAGE_PIXELS = None\n\n\ndef encode(img, quality, icc):\n    buf = io.BytesIO()\n    img.save(\n        buf,\n        format=\"JPEG\",\n        quality=quality,\n        subsampling=0,          # 4:4:4, aucune perte de chroma\n        optimize=True,\n        progressive=True,\n        icc_profile=icc,\n    )\n    return buf.getvalue()\n\n\ndef convert(args):\n    src, out_dir, width, max_bytes, keep_exif = args\n    with Image.open(src) as im:\n        im = im.convert(\"RGB\")\n        icc = im.info.get(\"icc_profile\")\n        exif = im.info.get(\"exif\") if keep_exif else None\n        w, h = im.size\n        if w > width:\n            im = im.resize((width, round(h * width / w)), Image.LANCZOS)\n        final_w, final_h = im.size\n\n        # Bisection : plus haute qualite dont le poids tient sous le plafond.\n        lo, hi, best, best_data = 60, 100, None, None\n        while lo <= hi:\n            mid = (lo + hi) // 2\n            data = encode(im, mid, icc)\n            if len(data) <= max_bytes:\n                best, best_data = mid, data\n                lo = mid + 1\n            else:\n                hi = mid - 1\n\n        if best_data is None:               # meme la qualite plancher deborde\n            best, best_data = 60, encode(im, 60, icc)\n\n    dst = out_dir / (Path(src).stem + \".jpg\")\n    dst.write_bytes(best_data)\n    if keep_exif and exif:\n        with Image.open(dst) as re_im:\n            re_im.save(dst, format=\"JPEG\", quality=best, subsampling=0,\n                       optimize=True, progressive=True, icc_profile=icc, exif=exif)\n    return {\n        \"src\": Path(src).name,\n        \"dst\": dst.name,\n        \"px\": f\"{final_w}x{final_h}\",\n        \"quality\": best,\n        \"kb\": round(dst.stat().st_size / 1024),\n        \"budget_pct\": round(100 * dst.stat().st_size / max_bytes, 1),\n    }\n\n\ndef main():\n    p = argparse.ArgumentParser()\n    p.add_argument(\"source\")\n    p.add_argument(\"--width\", type=int, default=1440,\n                   help=\"largeur maximale acceptee par Instagram\")\n    p.add_argument(\"--max-mb\", type=float, default=7.5,\n                   help=\"plafond de poids par photo, marge sous les 8 Mo d'Instagram\")\n    p.add_argument(\"--out\", default=\"instagram\", help=\"nom du sous-dossier de sortie\")\n    p.add_argument(\"--jobs\", type=int, default=16)\n    p.add_argument(\"--keep-exif\", action=\"store_true\",\n                   help=\"conserve les metadonnees, geolocalisation comprise\")\n    a = p.parse_args()\n\n    src_dir = Path(a.source).expanduser().resolve()\n    out_dir = src_dir / a.out\n    out_dir.mkdir(exist_ok=True)\n\n    files = sorted(f for f in src_dir.iterdir()\n                   if f.is_file() and f.suffix.lower() in EXTENSIONS)\n    if not files:\n        sys.exit(f\"aucune image dans {src_dir}\")\n\n    max_bytes = int(a.max_mb * 1024 * 1024)\n    jobs = [(f, out_dir, a.width, max_bytes, a.keep_exif) for f in files]\n    with ProcessPoolExecutor(max_workers=a.jobs) as pool:\n        results = list(pool.map(convert, jobs))\n\n    print(f\"{'source':<12}{'sortie':<12}{'pixels':<12}{'qualite':>8}{'poids':>10}{'budget':>9}\")\n    for r in sorted(results, key=lambda r: r[\"src\"]):\n        print(f\"{r['src']:<12}{r['dst']:<12}{r['px']:<12}\"\n              f\"{r['quality']:>8}{str(r['kb']) + ' ko':>10}{str(r['budget_pct']) + ' %':>9}\")\n    print(f\"\\n{len(results)} photos dans {out_dir}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","structuredPatch":[{"oldStart":1,"oldLines":16,"newStart":1,"newLines":18,"lines":[" #!/usr/bin/env python3"," \"\"\"Convertit des photos pour Instagram en consommant le budget de poids autorise."," ","-Principe : Instagram impose deux plafonds, une largeur maximale acceptee (1440 px)","-et un poids maximal par photo (8 Mo). L'algorithme redimensionne une seule fois en","-Lanczos, puis cherche par bisection la qualite JPEG la plus haute qui tient sous le","-plafond de poids. Le sous-echantillonnage chroma est desactive (4:4:4), ce qui est le","-vrai levier de qualite sur les rouges et les details fins quand le budget est large.","+CONSIGNE MATTHIEU (2026-08-06), non negociable : on ne redimensionne pas. La photo","+garde la definition de l'original, et le seul plafond est le poids, 8 Mo par photo.","+L'algorithme cherche par bisection la qualite JPEG la plus haute qui tienne sous ce","+plafond, en chroma 4:4:4, ce qui sature le budget au lieu de le laisser inutilise."," ","+Le redimensionnement reste possible mais uniquement sur demande explicite, via","+--width ; par defaut il n'a pas lieu.","+"," Les originaux ne sont jamais touches : la sortie va dans un sous-dossier."," "," Usage :","-    python3 instagram_maxq.py <dossier_source> [--width 1440] [--m