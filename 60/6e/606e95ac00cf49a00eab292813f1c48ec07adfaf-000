l_whisper.json\"))\n\nSONG = set(range(5, 29)) | set(range(224, 249)) | {334, 335}\n\nrows = []\nfor i, c in enumerate(cues):\n    n = c[\"n\"]\n    if n in SONG:\n        rows.append({\"n\": n, \"s\": c[\"s\"], \"e\": c[\"e\"], \"song\": True}); continue\n    pk = \"\".join(t[\"x\"] for t in ptok if c[\"s\"] - 0.35 <= t[\"t\"] <= c[\"e\"] + 0.35).strip()\n    wk = \"\".join(s[\"x\"] for s in wseg\n                 if min(s[\"e\"], c[\"e\"]) - max(s[\"s\"], c[\"s\"]) > 0.25 * min(s[\"e\"]-s[\"s\"], c[\"e\"]-c[\"s\"]))\n    wk = re.sub(r'[。、!?！？\\s]', '', wk).strip()\n    sim = difflib.SequenceMatcher(None, pk, wk).ratio() if (pk and wk) else 0.0\n    # Parakeet fait autorité sur les mots ; Whisper comble quand Parakeet n'a rien entendu.\n    text = pk if pk else wk\n    rows.append({\"n\": n, \"s\": c[\"s\"], \"e\": c[\"e\"], \"pk\": pk, \"wk\": wk, \"sim\": round(sim, 2),\n                 \"text\": fix_names(text), \"en\": en[i]})\n\njson.dump(rows, open(SP + \"/asr/reconciled.json\", \"w\"), ensure_ascii=False, indent=1)\nok = [r for r in rows if not r.get(\"song\")]\nprint(\"cues dialogues:\", len(ok))\nprint(\"vides (aucun ASR):\", sum(1 for r in ok if not r[\"text\"]))\nprint(\"accord fort (>=0.8):\", sum(1 for r in ok if r[\"sim\"] >= 0.8))\nprint(\"désaccord (<0.5):\", sum(1 for r in ok if r[\"sim\"] < 0.5))\nPYEOF\ncd \"$SP\" && source asr/venv/bin/activate && python asr/reconcile.py","description":"Run reconciliation pass"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":923,"cache_read_input_tokens":208479,"output_tokens":4192,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":923,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":4192,"cache_read_input_tokens":208479,"cache_creation_input_tokens":923,"cache_