ad in the background.","inputSchema":{"type":"object","additionalProperties":false,"properties":{"threadId":{"type":"string","description":"Thread id to rename."},"title":{"type":"string","description":"New thread title."}},"required":["threadId","title"]},"deferLoading":true}]}],"history_mode":"paginated","git":{"commit_hash":"bd92a119ff68fc52b6d7427126c4e8cfdd239862","branch":"main","repository_url":"https://github.com/matthieuhuguet/Memory.git"}}}
