pZP","output":[{"type":"input_text","text":"Script completed\nWall time 0.0 seconds\nOutput:\n"},{"type":"input_text","text":"        raise ValueError('Restored file does not match manifest')\n\n\ndef verify_or_restore(store, destination=None):\n    catalog = json.loads((store / 'catalog.json').read_text())\n    if destination:\n        destination = destination.resolve()\n        if destination.exists() and any(destination.iterdir()):\n            raise ValueError('Restoration requires an empty destination; live data is never overwritten')\n        destination.mkdir(parents=True, exist_ok=True)\n    for key, record in catalog['files'].items():\n        relative = Path(key)\n        if relative.is_absolute() or '..' in relative.parts:\n            raise ValueError('Unsafe restore path')\n        if destination:\n            output = destination / relative\n            output.parent.mkdir(parents=True, exist_ok=True)\n            with output.open('xb') as handle:\n                decode(record, store, handle)\n            if record.get('sqlite'):\n                with closing(sqlite3.connect(output.as_uri() + '?mode=ro&immutable=1', uri=True)) as database:\n                    if database.execute('PRAGMA quick_check').fetchall() != [('ok',)]:\n                        raise ValueError('Restored database is invalid: ' + key)\n        else:\n            decode(record, store)\n    print(json.dumps({'verified_files': len(catalog['files']), 'restored_to': str(destination) if destination else None}))\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument('command', choices=['backup', 'verify', 'restore', 'install'])\n    parser.add_argument('--store', type=Path, default=DEFAULT_STORE)\n    parser.add_argument('--destination', type=Path)\n    args = parser.parse_args()\n    if args.command == 'install':\n        label = 'com.zenray.agent-session-backup'\n        target = HOME_DIR / 'Library/LaunchAgents' / (label + '.plist')\n   