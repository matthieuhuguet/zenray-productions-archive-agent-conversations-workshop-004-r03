in patterns:\n        for item in root.glob(pattern):\n            candidates = item.rglob('*') if item.is_dir() else [item]\n            for path in candidates:\n                if path.is_file() and not path.is_symlink() and not any(\n                    part.startswith('.') for part in path.relative_to(root).parts[:-1]\n                ) and not path.name.endswith(('-wal', '-shm', '.DS_Store')):\n                    found.add(path)\n    return sorted(found)\n\n\ndef encode_file(path, store):\n    chunks, digest, size = [], hashlib.sha256(), 0\n    with path.open('rb') as handle:\n        while True:\n            data = handle.read(CHUNK_SIZE)\n            if not data:\n                break\n            digest.update(data)\n            size += len(data)\n            key = hashlib.sha256(data).hexdigest()\n            blob = store / 'blobs' / key[:2] / (key + '.zlib')\n            if not blob.exists():\n                atomic_write(blob, zlib.compress(data, 3))\n            chunks.append(key)\n    return {'sha256': digest.hexdigest(), 'size': size, 'chunks': chunks}\n\n\ndef capture(path, store):\n    before = signature(path)\n    with path.open('rb') as handle:\n        is_database = handle.read(16) == b'SQLite format 3\\x00'\n    if is_database:\n        with tempfile.TemporaryDirectory(prefix='session-backup-') as folder:\n            snapshot = Path(folder) / 'snapshot.db'\n            database_path = path\n            database_uri = path.as_uri() + '?mode=ro'\n            # Closed WAL databases may have no sidecars; validate a stable private copy.\n            if not Path(str(path) + '-wal').exists():\n                database_path = Path(folder) / 'source.db'\n                shutil.copyfile(path, database_path)\n                if signature(path) != before:\n                    raise RuntimeError('Database changed during closed-file capture: ' + str(path))\n                database_uri = database_path.as_uri() + '?mode=ro&immutable=1'\n            with closing(sqlite3.connect(database_uri, uri=True, timeout=10)) as source:\n                with closing(sqlite3.connect(snapshot)) as target:\n                    deadline = time.monotonic() + 30\n                    def progress(status, remaining, total):\n                        if time.monotonic() > deadline:\n                            raise TimeoutError('SQLite snapshot exceeded 30 seconds')\n                    source.backup(target, pages=256, progress=progress)\n                    target.execute('PRAGMA journal_mode=DELETE')\n                    if target.execute('PRAGMA quick_check').fetchall() != [('ok',)]:\n                        raise RuntimeError('SQLite integrity check failed: ' + str(path))\n            result = encode_file(snapshot, store)\n    else:\n        result = encode_file(path, store)\n        if signature(path) != before:\n            raise RuntimeError('File changed during capture; retry next cycle: ' + str(path))\n    result.update(signature=before, sqlite=is_database, capture_format=2)\n    return result\n\n\ndef backup(store, sources=SOURCES):\n    catalog_path = store / 'catalog.json'\n    catalog = json.loads(catalog_path.read_text()) if catalog_path.exists() else {'version': 1, 'files': {}}\n    errors, changed, seen = [], 0, 0\n    for name, (root, patterns) in sources.items():\n        if not root.is_dir():\n            errors.append('Missing source: ' + str(root))\n            continue\n        for path in source_files(root, patterns):\n            seen += 1\n            key = name + '/' + path.relative_to(root).as_posix()\n            previous = catalog['files'].get(key)\n            try:\n                if previous and previous.get('capture_format') == 2 and previous['signature'] == signature(path) and all(\n                    (store / 'blobs' / chunk[:2] / (chunk + '.zlib')).is_file()\n                    for chunk in previous['chunks']\n                ):\n                    continue\n                record = capture(path, store