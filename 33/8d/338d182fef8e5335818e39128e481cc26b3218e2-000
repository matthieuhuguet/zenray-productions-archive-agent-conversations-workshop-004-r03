restored.execute('SELECT body FROM messages').fetchone()[0], 'still in WAL')\n            (source / 'session.jsonl').write_text('account B\\n')\n            self.assertTrue(module.backup(store, sources))\n            self.assertEqual(len(list((store / 'versions').rglob('*.json'))), 3)\n            (source / 'session.jsonl').unlink()\n            self.assertTrue(module.backup(store, sources))\n            module.verify_or_restore(store, root / 'second')\n            self.assertEqual((root / 'second/test/session.jsonl').read_text(), 'account B\\n')\n            with self.assertRaises(ValueError):\n                module.verify_or_restore(store, root / 'second')\n            blob = next((store / 'blobs').rglob('*.zlib'))\n            blob.write_bytes(b'corrupted')\n            with self.assertRaises(Exception):\n                module.verify_or_restore(store)\n            connection.close()\n\n\nif __name__ == '__main__':\n    unittest.main()\n"}},"status":"completed","stdout":"Success. Updated the following files:\nA /Users/zenray/.claude/Scripts/test-session-backup.py\n","stderr":""},"started_at_ms":1789397236035,"completed_at_ms":1789397236035}}
