\"${path/#\\~/$HOME}\"\n  printf '%s\\n' \"$path\"\n}\n\nadd_account() {\n  local account\n  account=\"$(expand_path \"$1\")\"\n\n  [[ -n \"$account\" ]] || return\n\n  if [[ ! -d \"$account\" ]]; then\n    log \"WARN: chemin de session introuvable, ignore: $account\" >&2\n    return\n  fi\n\n  local existing\n  for existing in ${SYNC_ACCOUNTS[@]+\"${SYNC_ACCOUNTS[@]}\"}; do\n    [[ \"$existing\" == \"$account\" ]] && return\n  done\n\n  SYNC_ACCOUNTS+=(\"$account\")\n}\n\nadd_configured_accounts() {\n  local account\n\n  if [[ ${#ACCOUNTS[@]} -gt 0 ]]; then\n    for account in \"${ACCOUNTS[@]}\"; do\n      add_account \"$account\"\n    done\n    return\n  fi\n\n  # Compatibilite avec les anciennes configs ACCOUNT1/ACCOUNT2/ACCOUNT3...\n  local index=1\n  local var_name\n  local value\n  while true; do\n    var_name=\"ACCOUNT$index\"\n    value=\"${!var_name-}\"\n    [[ -n \"$value\" ]] || break\n    add_account \"$value\"\n    index=$((index + 1))\n  done\n}\n\ndiscover_accounts() {\n  local root=\"${CLAUDE_SESSIONS_ROOT:-$HOME/Library/Application Support/Claude/claude-code-sessions}\"\n  local local_agent_root=\"${LOCAL_AGENT_MODE_SESSIONS_ROOT:-$HOME/Library/Application Support/Claude/local-agent-mode-sessions}\"\n\n  if [[ ! -d \"$root\" ]]; then\n    mkdir -p \"$root\"\n  fi\n\n  local account_dir\n  local workspace_dir\n  for account_dir in \"$root\"/*; do\n    [[ -d \"$account_dir\" ]] || continue\n\n    for workspace_dir in \"$account_dir\"/*; do\n      [[ -d \"$workspace_dir\" ]] || continue\n      add_account \"$workspace_dir\"\n    done\n  done\n\n  # Claude Desktop materialise parfois un nouveau compte seulement dans\n  # local-agent-mode-sessions. Sans ce passage, le nouveau compte n'a jamais\n  # de dossier claude-code-sessions et ne recoit donc aucune carte Code.\n  if [[ -d \"$local_agent_root\" ]]; then\n    local manifest\n    local relative_workspace\n    local code_workspace\n\n    for manifest in \"$local_agent_root\"/*/*/rpm/manifest.json; do\n      [[ -f \"$manifest\" ]] || continue\n\n      relative_workspace=\"${manifest#$local_agent_root/}\"\n      relative_workspace=\"${relative_workspace%/rpm/manifest.json}\"\n      code_workspace=\"$root/$relative_workspace\"\n\n      if [[ ! -d \"$code_workspace\" ]]; then\n        mkdir -p \"$code_workspace\"\n        log \"INFO: workspace Claude Code cree depuis local-agent-mode: $code_workspace\"\n      fi\n\n      add_account \"$code_workspace\"\n    done\n  fi\n}\n\nadd_configured_accounts\n\nif [[ ${#SYNC_ACCOUNTS[@]} -eq 0 ]]; then\n  discover_accounts\nfi\n\nif [[ ${#SYNC_ACCOUNTS[@]} -lt 2 ]]; then\n  log \"SKIP: ${#SYNC_ACCOUNTS[@]} compte/workspace detecte, il en faut au moins 2\"\n  exit 0\nfi\n\nlog \"sync demarre: ${#SYNC_ACCOUNTS[@]} comptes/workspaces\"\n\nsource_account=\"\"\ndest_account=\"\"\nfor source_account in \"${SYNC_ACCOUNTS[@]}\"; do\n  for dest_account in \"${SYNC_ACCOUNTS[@]}\"; do\n    [[ \"$source_account\" == \"$dest_account\" ]] && continue\n    rsync -a --update \"$source_account/\" \"$dest_account/\"\n  done\ndone\n\nlog \"sync termine\"\n"},{"type":"input_text","text":"/Users/zenray/Library/Application Support/Claude/claude-code-sessions\n/Users/zenray/Library/Application Support/Claude/claude-code-sessions/b258faf7-57a9-48fb-bcd8-7bf1a66defa8\n/Users/zenray/Library/Application Support/Claude/claude-code-sessions/b258faf7-57a9-48fb-bcd8-7bf1a66defa8/e410da62-b0cb-4839-aece-40580ca951ac\n/Users/zenray/Library/Application Support/Claude/claude-code-sessions/b258faf7-57a9-48fb-bcd8-7bf1a66defa8/519c5f15-4988-4fd5-bcc5-d434338c78a8\n/Users/zenray/Library/Application Support/Claude/claude-code-sessions/b258faf7-57a9-48fb-bcd8-7bf1a66defa8/bf0f2eb1-a514-4e1b-938d-5fd41d174ee1\n/Users/zenray/Library/Application Support/Claude/claude-code-sessions/02368b1a-9531-492c-b78b-dbf8591aecf4\n/Users/zenray/Library/Application Support/Claude/claude-code-sessions/02368b1a-9531-492c-b78b-dbf8591aecf4/63776e96-f078-4fd7-8839-bf1710e3b652\n/Users/ze