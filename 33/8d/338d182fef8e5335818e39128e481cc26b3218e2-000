is être silencieux : l'état vit dans SYNC-STATUS.json\n * et toute panne qui dure est criée dans le journal.\n */\n\nimport { watch, statSync, existsSync, appendFileSync, writeFileSync, readdirSync } from 'fs'\nimport { execSync } from 'child_process'\nimport { resolve, join } from 'path'\nimport os from 'os'\n\n// ── Dépôts surveillés ────────────────────────────────────────────────────────\nconst CLAUDE_HOME = resolve(os.homedir(), '.claude')\nconst REPOS = [\n  CLAUDE_HOME,\n  // 2026-09-13 Memory moved into ~/.claude as Memory1 (its own repository, git-ignored by ~/.claude).\n  // FR : Memory vit desormais dans ~/.claude/Memory1, depot a part, ignore par le git de ~/.claude.\n  resolve(CLAUDE_HOME, 'Memory1'),\n]\n\n// 5 minutes : assez court pour ne rien perdre, assez long pour ne pas créer un\n// commit par frappe. L'ancienne valeur de 60 s multipliait les versions inutiles.\nconst DEBOUNCE_MS = 5 * 60 * 1000\n\n// Plafond d'attente, ajouté le 2026-08-15 après l'avoir vu échouer en direct.\n// L'anti-rafale se réarme à chaque changement : tant qu'une conversation est en\n// cours, le transcript grossit sans arrêt, le minuteur repart indéfiniment et\n// RIEN n'est jamais sauvegardé. Passé ce délai depuis le premier changement en\n// attente, on synchronise quoi qu'il arrive.\nconst MAX_WAIT_MS = 12 * 60 * 1000\n\n// Au-delà de ce nombre de packs, on compacte : c'est le symptôme qui avait mené\n// aux 143 Gio.\nconst PACK_THRESHOLD = 60\nconst GC_MIN_INTERVAL_MS = 24 * 60 * 60 * 1000\n\nconst LOG = join(CLAUDE_HOME, 'autoupdate.log')\nconst STATUS = join(CLAUDE_HOME, 'SYNC-STATUS.json')\n\nconst state = {}   // par dépôt : { lastOk, failures, lastError }\nlet lastGc = 0\n\nfunction log(msg) {\n  const line = `[${new Date().toISOString()}] ${msg}\\n`\n  process.stdout.write(line)\n  try { appendFileSync(LOG, line) } catch {}\n}\n\nfunction sh(cmd, cwd, opts = {}) {\n  return execSync(cmd, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], ...opts })\n}\n\nfunction trySh(cmd, cwd) {\n  try { return { ok: true, out: sh(cmd, cwd) } }\n  catch (e) { return { ok: false, out: (e.stdout || '') + (e.stderr || '') + (e.message || '') } }\n}\n\nfunction writeStatus() {\n  const now = Date.now()\n  const payload = {\n    updatedAt: new Date().toISOString(),\n    repos: Object.fromEntries(Object.entries(state).map(([repo, s]) => {\n      const staleMs = s.lastOk ? now - s.lastOk : null\n      return [repo, {\n        lastSuccessfulPush: s.lastOk ? new Date(s.lastOk).toISOString() : null,\n        hoursSinceLastPush: staleMs === null ? null : +(staleMs / 3600000).toFixed(2),\n        consecutiveFailures: s.failures || 0,\n        lastError: s.lastError || null,\n        healthy: (s.failures || 0) === 0,\n      }]\n    })),\n  }\n  try { writeFileSync(STATUS, JSON.stringify(payload, null, 2) + '\\n') } catch {}\n}\n\n/** Découpe les transcripts en tranches versionnables (dépôt ~/.claude seulement). */\nfunction chunkTranscripts(repoPath) {\n  if (repoPath !== CLAUDE_HOME) return\n  const script = join(CLAUDE_HOME, 'Scripts', 'chunk-transcripts.mjs')\n  if (!existsSync(script)) { log('ATTENTION chunk-transcripts.mjs introuvable, transcripts non découpés'); return }\n  // process.execPath, et surtout pas « node » : sous launchd le PATH se réduit à\n  // /usr/bin:/bin:/usr/sbin:/sbin, où le node de Homebrew est absent. Le découpage\n  // échouait silencieusement pour cette seule raison le 2026-08-15.\n  const r = trySh(`\"${process.execPath}\" \"${script}\"`, repoPath)\n  if (!r.ok) log(`ERREUR découpage transcripts — ${r.out.slice(0, 300)}`)\n}\n\n/**\n * Réconcilie avec le distant avant de pousser. C'est le correctif central :\n * une divergence ne doit plus jamais bloquer indéfiniment.\n */\nfunction reconcile(repoPath) {\n  const f = trySh('git fetch origin', repoPath)\n  if (!f.ok) return { ok: false, why: `fetch impossible : ${f.out.slice(0, 200)}` }\n\n  const branch = trySh('git rev-parse --abbrev-ref HEAD', repoPath).out.trim() || 'main'\n  const counts = trySh(`git rev-list --left-right --count origin/${branch}...HEAD`, repoPath)\n  if (!counts.ok) return { ok: true, why: 'pas de branche distante, push direct' }\n\n  const [behind, ahead] = counts.out.trim().split(/\\s+/).map(Number)\n  if (!behind) return { ok: true, why: ahead ? `${ahead} commits à pousser` : 'à jour' }\n\n  log(`DIVERGENCE ${repoPath} — ${behind} commits distants absents en local, ${ahead} locaux non poussés ; réconciliation`)\n\n  // Rebase d'abord : historique linéaire, pas de commit de fusion parasite.\n  const rb = trySh(`git -c rebase.autoStash=true rebase origin/${branch}`, repoPath)\n  if (rb.ok) return { ok: true, why: `rebasé sur origin/${branch}` }\n\n  trySh('git rebase --abort', repoPath)\n\n  // Fusion en second recours : jamais élégante, mais elle ne perd rien.\n  const mg = trySh(`git merge --no-edit origin/${branch}`, repoPath)\n  if (mg.ok) return { ok: true, why: `fusionné avec origin/${branch}` }\n\n  trySh('git merge --abort', repoPath)\n  return { ok: false, why: `rebase ET fusion en échec (conflit à trancher à la main) : ${mg.out.slice(0, 200)}` }\n}\n\n/** Compacte le dépôt si les packs se multiplient (cause des 143 Gio). */\nfunction maybeGc(repoPath) {\n  const now = Date.now()\n  if (now - lastGc < GC_MIN_INTERVAL_MS) return\n  let packs = 0\n  try { packs = readdirSync(join(repoPath, '.git', 'objects', 'pack')).filter(f => f.endsWith('.pack')).length } catch { return }\n  if (packs < PACK_THRESHOLD) return\n  lastGc = now\n  log(`COMPACTAGE ${repoPath} — ${packs} packs, lancement de git gc`)\n  try {\n    // Surtout PAS `--auto` : il respecte `gc.auto`, qui valait 0 sur ce dépôt,\n    // si bien que le compactage n'aurait jamais rien fait. Et pas de\n    // `--prune=now` non plus : la fenêtre de deux semaines par défaut protège\n    // d'un objet momentanément injoignable pendant une opération concurrente.\n    execSync('git gc --quiet', { cwd: repoPath, stdio: 'ignore', timeout: 3 * 3600 * 1000 })\n    log(`COMPACTAGE terminé ${repoPath}`)\n  } catch (e) {\n    log(`COMPACTAGE interrompu ${repoPath} — ${String(e.message).slice(0, 150)}`)\n  }\n}\n\nfunction gitSync(repoPath) {\n  const hostname = os.hostname().replace(/\\.local$/, '')\n  const ts = new Date().toISOString().slice(0, 19).replace('T', ' ')\n  const msg = `auto-sync ${hostname} ${ts}`\n  const s = state[repoPath] || (state[repoPath] = { lastOk: null, failures: 0, lastError: null })\n\n  try {\n    chunkTranscripts(repoPath)\n\n    sh('git add -A', repoPath)\n\n    // Filet de sécurité : GitHub refuse tout fichier > 100 Mo (GH001). Avec le\n    // découpage en tranches plus rien ne devrait dépasser, mais si un fichier\n    // inattendu apparaît, on le laisse de côté plutôt que de bloquer TOUT le reste.\n    const staged = trySh('git diff --cached --name-only', repoPath).out.split('\\n').filter(Boolean)\n    for (const f of staged) {\n      let sz = 0\n      try { sz = statSync(resolve(repoPath, f)).size } catch {}\n      if (sz > 99 * 1024 * 1024) {\n        trySh(`git reset -q -- \"${f}\"`, repoPath)\n        log(`ECARTE >100Mo ${f} (${Math.round(sz / 1048576)} Mo) — non poussable tel quel`)\n      }\n    }\n\n    const hasStaged = trySh('git diff --cached --name-only', repoPath).out.trim().length > 0\n    if (hasStaged) sh(`git commit -m \"${msg.replace(/\"/g, '')}\"`, repoPath)\n\n    const rec = reconcile(repoPath)\n    if (!rec.ok) throw new Error(rec.why)\n\n    const ahead = trySh('git rev-list --count @{u}..HEAD', repoPath).out.trim()\n    if (ahead === '0' && !hasStaged) {\n      s.failures = 0; s.lastOk = Date.now(); s.lastError = null; writeStatus()\n      return\n    }\n\n    const p = trySh('git push', repoPath)\n    if (!p.ok) throw new Error(p.out.slice(0, 300))\n\n    s.lastOk = Date.now(); s.failures = 0; s.lastError = null\n    log(`POUSSE ${repoPath} — \"${msg}\" (${rec.why})`)\n    writeStatus()\n    maybeGc(repoPath)\n  } catch (e) {\n    s.failures = (s.failures || 0) + 1\n    s.lastError = String(e.message).slice(0, 400)\n    // Un échec isolé est banal (réseau). Un échec qui dure est une panne de\n    // sauvegarde, et doit se voir.\n    const level = s.failures >= 5 ? 'ALERTE SAUVEGARDE' : 'ERREUR'\n    log(`${level} ${repoPath} (${s.failures} échecs consécutifs) — ${s.lastError}`)\n    writeStatus()\n  }\n}\n\n// ── Anti-rafale par dépôt ────────────────────────────────────────────────────\nconst timers = {}\nconst running = {}\nconst pendingSince = {}\n\nfunction runSync(repoPath) {\n  delete timers[repoPath]\n  if (running[repoPath]) { scheduleCommit(repoPath, true); return }\n  running[repoPath] = true\n  try {\n    delete pendingSince[repoPath]\n    const dirty = trySh('git status --porcelain', repoPath).out.trim().length > 0\n    const ahead = trySh('git rev-list --count @{u}..HEAD', repoPath).out.trim()\n    if (dirty || (ahead && ahead !== '0')) gitSync(repoPath)\n  } finally {\n    running[repoPath] = false\n  }\n}\n\nfunction scheduleCommit(repoPath, requeue = false) {\n  if (!pendingSince[repoPath]) pendingSince[repoPath] = Date.now()\n\n  // Le plafond prime sur l'anti-rafale : une activité continue ne doit jamais\n  // repousser la sauvegarde à l'infini.\n  const waited = Date.now() - pendingSince[repoPath]\n  const delay = requeue ? 30 * 1000 : Math.max(0, Math.min(DEBOUNCE_MS, MAX_WAIT_MS - waited))\n\n  if (timers[repoPath]) clearTimeout(timers[repoPath])\n  timers[repoPath] = setTimeout(() => runSync(repoPath), delay)\n}\n\n// ── Surveillance ─────────────────────────────────────────────────────────────\nfor (const repo of REPOS) {\n  log(`Surveille ${repo}`)\n  state[repo] = { lastOk: null, failures: 0, lastError: null }\n  try {\n    watch(repo, { recursive: true }, (eventType, filename) => {\n      if (!filename) return\n      if (filename.startsWith('.git/')) return\n      if (repo === CLAUDE_HOME && filename.startsWith('Memory1/')) return   // watched as its own repository\n      if (repo === CLAUDE_HOME && filename.startsWith('tmp/')) return       // 2026-09-13 temporary work, never versioned\n      if (filename === 'autoupdate.log' || filename === 'autoupdate.error.log') return\n      if (filename === 'SYNC-STATUS.json') return\n      if (filename.startsWith('transcripts-chunks/')) return   // produit par nous, pas un déclencheur\n      if (filename.endsWith('.DS_Store')) return\n      scheduleCommit(repo)\n    })\n  } catch (e) {\n    log(`SURVEILLANCE IMPOSSIBLE ${repo} — ${e.message}`)\n  }\n}\n\n// Filet horaire : même sans le moindre événement de fichier, on vérifie que le\n// dépôt est bien poussé. C'est ce qui aurait rattrapé la panne du 3 août.\nsetInterval(() => {\n  for (const repo of REPOS) scheduleCommit(repo)\n}, 60 * 60 * 1000)\n\nlog(`autoupdate démarré — ${REPOS.length} dépôts, anti-rafale ${DEBOUNCE_MS / 1000}s`)\nwriteStatus()\n\nprocess.on('SIGTERM', () => { log('autoupdate arrêté (SIGTERM)'); process.exit(0) })\nprocess.on('SIGINT', () => { log('autoupdate arrêté (SIGINT)'); process.exit(0) })\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a0a07f-9d12-7330-b788-2a97081fb9ae","create_time":1789400114.382531}}}
